# Shared JWT verification contract. Private signing material exists only under
# the IDENTITY_JWT_ACCESS_* keys and is injected only into identity-api.
JWT_ISSUER=http://localhost:4100/auth
JWT_AUDIENCE=http://localhost:4100
JWT_ACCESS_TTL_SECONDS=900
JWT_CLOCK_TOLERANCE_SECONDS=5
GATEWAY_LISTEN_HOST=127.0.0.1
GATEWAY_PORT=4100
# Declare every public /api/v1 owner explicitly. There is no generic catch-all.
GATEWAY_ROUTES_JSON=[{"id":"identity-auth","pathPrefix":"/api/v1/auth","upstreamUrl":"http://127.0.0.1:4900","authPolicy":"optional","timeoutMs":60000},{"id":"identity-users","pathPrefix":"/api/v1/users","upstreamUrl":"http://127.0.0.1:4900","authPolicy":"optional","timeoutMs":60000},{"id":"identity-telegram-auth","pathPrefix":"/api/v1/telegram-auth","upstreamUrl":"http://127.0.0.1:4900","authPolicy":"optional","timeoutMs":60000},{"id":"identity-info-webhook","pathPrefix":"/api/v1/telegram-bot/webhook","upstreamUrl":"http://127.0.0.1:4900","authPolicy":"optional","timeoutMs":60000},{"id":"support-webhook","pathPrefix":"/api/v1/telegram-bot/support-webhook","upstreamUrl":"http://127.0.0.1:5100","authPolicy":"optional","timeoutMs":10000},{"id":"support-admin","pathPrefix":"/api/v1/support/admin","upstreamUrl":"http://127.0.0.1:5100","authPolicy":"required","timeoutMs":60000},{"id":"operations-notes","pathPrefix":"/api/v1/notes","upstreamUrl":"http://127.0.0.1:5200","authPolicy":"required","timeoutMs":30000},{"id":"operations-admin-event-log","pathPrefix":"/api/v1/admin-event-log","upstreamUrl":"http://127.0.0.1:5200","authPolicy":"required","timeoutMs":30000},{"id":"operations-restores","pathPrefix":"/api/v1/dev-tools/database-restores","upstreamUrl":"http://127.0.0.1:5200","authPolicy":"required","timeoutMs":600000},{"id":"operations-telegram","pathPrefix":"/api/v1/telegram-bot/admin","upstreamUrl":"http://127.0.0.1:5200","authPolicy":"required","timeoutMs":600000},{"id":"operations-messaging","pathPrefix":"/api/v1/messaging/admin","upstreamUrl":"http://127.0.0.1:5200","authPolicy":"required","timeoutMs":30000},{"id":"operations-alerts","pathPrefix":"/api/v1/admin-alerts","upstreamUrl":"http://127.0.0.1:5200","authPolicy":"required","timeoutMs":30000},{"id":"operations-health-admin","pathPrefix":"/api/v1/health/admin","upstreamUrl":"http://127.0.0.1:5200","authPolicy":"required","timeoutMs":30000},{"id":"operations-health-deployment","pathPrefix":"/api/v1/health/deployment","upstreamUrl":"http://127.0.0.1:5200","authPolicy":"optional","timeoutMs":30000},{"id":"platform-site-settings","pathPrefix":"/api/v1/site-settings","upstreamUrl":"http://127.0.0.1:5000","authPolicy":"optional","timeoutMs":60000},{"id":"platform-legal-pages","pathPrefix":"/api/v1/legal-pages","upstreamUrl":"http://127.0.0.1:5000","authPolicy":"optional","timeoutMs":60000},{"id":"platform-home-page-content","pathPrefix":"/api/v1/home-page-content","upstreamUrl":"http://127.0.0.1:5000","authPolicy":"optional","timeoutMs":60000},{"id":"billing-payments","pathPrefix":"/api/v1/payments","upstreamUrl":"http://127.0.0.1:4800","authPolicy":"optional","timeoutMs":30000},{"id":"billing-subscriptions","pathPrefix":"/api/v1/subscriptions","upstreamUrl":"http://127.0.0.1:4800","authPolicy":"optional","timeoutMs":30000},{"id":"billing-tariff-prices","pathPrefix":"/api/v1/tariff-prices","upstreamUrl":"http://127.0.0.1:4800","authPolicy":"optional","timeoutMs":30000},{"id":"billing-affiliate","pathPrefix":"/api/v1/affiliate","upstreamUrl":"http://127.0.0.1:4800","authPolicy":"optional","timeoutMs":30000},{"id":"billing-settings-public","pathPrefix":"/api/v1/billing-settings/public","upstreamUrl":"http://127.0.0.1:4800","authPolicy":"optional","timeoutMs":30000},{"id":"billing-settings-admin","pathPrefix":"/api/v1/billing-settings/admin","upstreamUrl":"http://127.0.0.1:4800","authPolicy":"required","timeoutMs":30000},{"id":"campaigns","pathPrefix":"/api/v1/admin/campaigns","upstreamUrl":"http://127.0.0.1:4500","authPolicy":"required","timeoutMs":60000},{"id":"reporting","pathPrefix":"/api/v1/admin/reporting","upstreamUrl":"http://127.0.0.1:4600","authPolicy":"required","timeoutMs":60000},{"id":"widgets-admin","pathPrefix":"/api/v1/widgets/admin","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"required","timeoutMs":60000},{"id":"widgets-management","pathPrefix":"/api/v1/widgets","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"required","timeoutMs":60000},{"id":"quizzes-management","pathPrefix":"/api/v1/quizzes","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"required","timeoutMs":60000},{"id":"callbacks-management","pathPrefix":"/api/v1/callbacks","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"required","timeoutMs":60000},{"id":"countdown-timers-management","pathPrefix":"/api/v1/countdown-timers","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"required","timeoutMs":60000},{"id":"stop-offers-management","pathPrefix":"/api/v1/stop-offers","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"required","timeoutMs":60000},{"id":"ai-consultants-management","pathPrefix":"/api/v1/ai-consultants","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"required","timeoutMs":60000},{"id":"calculators-management","pathPrefix":"/api/v1/calculators","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"required","timeoutMs":60000},{"id":"widget-settings","pathPrefix":"/api/v1/widget-settings","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"required","timeoutMs":60000},{"id":"widget-runtime","pathPrefix":"/api/v1/widget-runtime","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"required","timeoutMs":60000},{"id":"widget-public","pathPrefix":"/api/v1/widget","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"optional","timeoutMs":60000},{"id":"quiz-public","pathPrefix":"/api/v1/quiz","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"optional","timeoutMs":60000},{"id":"callback-public","pathPrefix":"/api/v1/callback","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"optional","timeoutMs":60000},{"id":"countdown-timer-public","pathPrefix":"/api/v1/countdown-timer","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"optional","timeoutMs":60000},{"id":"stop-offer-public","pathPrefix":"/api/v1/stop-offer","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"optional","timeoutMs":60000},{"id":"ai-consultant-public","pathPrefix":"/api/v1/ai-consultant","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"optional","timeoutMs":60000},{"id":"calculator-public","pathPrefix":"/api/v1/calculator","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"optional","timeoutMs":60000},{"id":"widget-events","pathPrefix":"/api/v1/widget-events","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"optional","timeoutMs":60000}]
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_JWKS_URL=http://127.0.0.1:4900/api/v1/auth/.well-known/jwks.json
JWKS_FETCH_TIMEOUT_MS=3000
JWKS_REFRESH_MIN_INTERVAL_MS=5000
JWKS_CACHE_TTL_MS=300000
JWKS_MAX_STALE_MS=3600000
JWKS_MAX_BYTES=262144
JWT_MAX_TOKEN_BYTES=16384
GATEWAY_SHUTDOWN_GRACE_MS=10000

# Identity API providers. These values are scoped to Identity.
RECAPTCHA_SECRET_KEY=your_recaptcha_v3_secret
RECAPTCHA_CLIENT_URL=http://localhost:3000
RECAPTCHA_ENABLED=true
RECAPTCHA_MIN_SCORE=0.5

# Identity verification email and Notification Delivery SMTP transport.
SMTP_LOGIN=no-reply@example.com
SMTP_PASSWORD=change_me
SMTP_SERVER=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_GREETING_TIMEOUT_MS=5000
SMTP_SOCKET_TIMEOUT_MS=15000

# Identity verification SMS transport.
SMSAERO_EMAIL=change_me@example.com
SMSAERO_API_KEY=change_me_smsaero_api_key
SMSAERO_SIGN=SMS Aero

# Identity OAuth providers.
GOOGLE_CLIENT_ID=change_me_google_client_id
GOOGLE_CLIENT_SECRET=change_me_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4100/api/v1/auth/google/redirect

GITHUB_CLIENT_ID=change_me_github_client_id
GITHUB_CLIENT_SECRET=change_me_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:4100/api/v1/auth/github/redirect

YANDEX_CLIENT_ID=change_me_yandex_client_id
YANDEX_CLIENT_SECRET=change_me_yandex_client_secret
YANDEX_CALLBACK_URL=http://localhost:4100/api/v1/auth/yandex/redirect

VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_SERVICE_TOKEN=
VK_CALLBACK_URL=http://localhost:4100/api/v1/auth/vk/redirect

# Production/live YooKassa credentials, used only when MODE=production.
YOOKASSA_PRODUCTION_SHOP_ID=change_me_yookassa_production_shop_id
YOOKASSA_PRODUCTION_SECRET_KEY=change_me_yookassa_production_secret_key
# 32 random bytes encoded as standard base64. Used only for YooKassa
# payment_method.id encryption (AES-256-GCM, v1:iv:tag:ciphertext).
PAYMENT_METHOD_ENCRYPTION_KEY=Y2hhbmdlX21lXzMyX2J5dGVfa2V5X2Zvcl9jaV8wMDA=

# Info_bot: lead notifications and admin daily summary
TELEGRAM_INFO_BOT_TOKEN=123456789:change_me_telegram_info_bot_token
TELEGRAM_INFO_BOT_USERNAME=change_me_info_bot
TELEGRAM_INFO_BOT_WEBHOOK_SECRET=change_me_telegram_info_webhook_secret_32_chars
TELEGRAM_API_BASE_URL=https://tg.winwidget.ru/telegram-api
TELEGRAM_API_PROXY_IP=185.184.122.62

# Identity Auth_bot: registration/login via Telegram bot. These values are
# scoped to Identity.
TELEGRAM_AUTH_BOT_TOKEN=123456789:change_me_telegram_auth_bot_token
TELEGRAM_AUTH_BOT_USERNAME=change_me_auth_bot
TELEGRAM_AUTH_BOT_WEBHOOK_SECRET=change_me_telegram_auth_webhook_secret_32_chars

# Support_bot: user support dialog through admin Telegram group
TELEGRAM_SUPPORT_BOT_TOKEN=123456789:change_me_telegram_support_bot_token
TELEGRAM_SUPPORT_BOT_USERNAME=change_me_support_bot
TELEGRAM_SUPPORT_BOT_WEBHOOK_SECRET=change_me_telegram_support_webhook_secret_32_chars

# Widgets-owned S3 media (not injected into Identity)
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=cdn-winwidget-s3
S3_ACCESS_KEY_ID=change_me_widgets_s3_access_key_id
S3_SECRET_ACCESS_KEY=change_me_widgets_s3_secret_access_key
S3_PUBLIC_BASE_URL=https://s3.twcstorage.ru/cdn-winwidget-s3
S3_KEY_PREFIX=можно оставить пустым, нужно для организации папок в хранилище
S3_FORCE_PATH_STYLE=true

# RabbitMQ broker, service-scoped URLs and transactional Outbox workers.
RABBITMQ_VHOST=winwidget
COMPOSE_PROJECT_NAME=winwidget
RABBITMQ_DATA_VOLUME=winwidget-ci-rabbitmq-data
RABBITMQ_ADMIN_USER=winwidget-admin
RABBITMQ_ADMIN_PASSWORD=change_me_long_random_value
RABBITMQ_MONITOR_USER=winwidget-monitor
RABBITMQ_MONITOR_PASSWORD=change_me_long_random_value
RABBITMQ_MANAGEMENT_URL=http://127.0.0.1:15672
