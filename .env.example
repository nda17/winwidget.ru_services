# Specific service routes must stay before the temporary monolith catch-all.
# Remove the catch-all only after every remaining /api/v1 owner is extracted.
GATEWAY_ROUTES_JSON=[{"id":"database-restores","pathPrefix":"/api/v1/dev-tools/database-restores","upstreamUrl":"http://127.0.0.1:4200","authPolicy":"required","timeoutMs":120000},{"id":"campaigns","pathPrefix":"/api/v1/admin/campaigns","upstreamUrl":"http://127.0.0.1:4500","authPolicy":"required","timeoutMs":60000},{"id":"reporting","pathPrefix":"/api/v1/admin/reporting","upstreamUrl":"http://127.0.0.1:4600","authPolicy":"required","timeoutMs":60000},{"id":"widgets-admin","pathPrefix":"/api/v1/widgets/admin","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"required","timeoutMs":60000},{"id":"widgets-management","pathPrefix":"/api/v1/widgets","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"required","timeoutMs":60000},{"id":"quizzes-management","pathPrefix":"/api/v1/quizzes","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"required","timeoutMs":60000},{"id":"callbacks-management","pathPrefix":"/api/v1/callbacks","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"required","timeoutMs":60000},{"id":"countdown-timers-management","pathPrefix":"/api/v1/countdown-timers","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"required","timeoutMs":60000},{"id":"stop-offers-management","pathPrefix":"/api/v1/stop-offers","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"required","timeoutMs":60000},{"id":"online-consultants-management","pathPrefix":"/api/v1/online-consultants","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"required","timeoutMs":60000},{"id":"calculators-management","pathPrefix":"/api/v1/calculators","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"required","timeoutMs":60000},{"id":"widget-settings","pathPrefix":"/api/v1/widget-settings","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"required","timeoutMs":60000},{"id":"widget-runtime","pathPrefix":"/api/v1/widget-runtime","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"required","timeoutMs":60000},{"id":"widget-public","pathPrefix":"/api/v1/widget","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"optional","timeoutMs":60000},{"id":"quiz-public","pathPrefix":"/api/v1/quiz","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"optional","timeoutMs":60000},{"id":"callback-public","pathPrefix":"/api/v1/callback","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"optional","timeoutMs":60000},{"id":"countdown-timer-public","pathPrefix":"/api/v1/countdown-timer","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"optional","timeoutMs":60000},{"id":"stop-offer-public","pathPrefix":"/api/v1/stop-offer","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"optional","timeoutMs":60000},{"id":"online-consultant-public","pathPrefix":"/api/v1/online-consultant","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"optional","timeoutMs":60000},{"id":"calculator-public","pathPrefix":"/api/v1/calculator","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"optional","timeoutMs":60000},{"id":"widget-events","pathPrefix":"/api/v1/widget-events","upstreamUrl":"http://127.0.0.1:4700","authPolicy":"optional","timeoutMs":60000},{"id":"monolith","pathPrefix":"/api/v1","upstreamUrl":"http://127.0.0.1:4200","authPolicy":"optional","timeoutMs":60000}]
