# MODE controls upload storage:
# development -> local winwidget.ru_server/uploads
# production -> S3-compatible storage
MODE=development
PORT=4200

PRODUCTION_HOST=https://your-domain.com
DEVELOPMENT_HOST=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_db?schema=public

JWT_SECRET=

RECAPTCHA_SECRET_KEY=your_recaptcha_v3_secret
RECAPTCHA_CLIENT_URL=http://localhost:3000
RECAPTCHA_ENABLED=true
RECAPTCHA_MIN_SCORE=0.5

SMTP_LOGIN=no-reply@example.com
SMTP_PASSWORD=change_me
SMTP_SERVER=smtp.example.com

SMSAERO_EMAIL=
SMSAERO_API_KEY=
SMSAERO_SIGN=SMS Aero

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4200/auth/google/redirect

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4200/auth/github/redirect

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_CALLBACK_URL=http://localhost:4200/auth/yandex/redirect

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

TELEGRAM_BOT_TOKEN=

# Required only when MODE=production
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=cdn-winwidget-s3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://s3.twcstorage.ru/cdn-winwidget-s3
S3_KEY_PREFIX=можно оставить пустым, нужно для организации папок в хранилище
S3_FORCE_PATH_STYLE=true
