# MODE controls upload storage:
# development -> local winwidget.ru_server/uploads
# production -> S3-compatible storage
MODE=development
PORT=4200
API_LISTEN_HOST=

PRODUCTION_HOST=https://your-domain.com
DEVELOPMENT_HOST=http://localhost:3000
AUTH_COOKIE_DOMAIN=

# Runtime selects the database URL by MODE.
DATABASE_URL_DEVELOPMENT=postgresql://postgres:postgres@localhost:5432/app_db?schema=public
DATABASE_URL_PRODUCTION=

JWT_SECRET=

RECAPTCHA_SECRET_KEY=your_recaptcha_v3_secret
RECAPTCHA_CLIENT_URL=http://localhost:3000
RECAPTCHA_ENABLED=true
RECAPTCHA_MIN_SCORE=0.5

SMTP_LOGIN=no-reply@example.com
SMTP_PASSWORD=change_me
SMTP_SERVER=smtp.example.com

SMSAERO_EMAIL=
SMSAERO_API_KEY=
SMSAERO_SIGN=SMS Aero

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4200/auth/google/redirect

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4200/auth/github/redirect

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_CALLBACK_URL=http://localhost:4200/auth/yandex/redirect

# Development/test YooKassa credentials.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Production/live YooKassa credentials, used only when MODE=production.
YOOKASSA_PRODUCTION_SHOP_ID=
YOOKASSA_PRODUCTION_SECRET_KEY=

# Info_bot: lead notifications and admin daily summary
TELEGRAM_INFO_BOT_TOKEN=
TELEGRAM_INFO_BOT_USERNAME=
TELEGRAM_INFO_BOT_WEBHOOK_SECRET=

# Auth_bot: registration/login via Telegram bot
TELEGRAM_AUTH_BOT_TOKEN=
TELEGRAM_AUTH_BOT_USERNAME=
TELEGRAM_AUTH_BOT_WEBHOOK_SECRET=

# Support_bot: user support dialog through admin Telegram group
TELEGRAM_SUPPORT_BOT_TOKEN=
TELEGRAM_SUPPORT_BOT_USERNAME=
TELEGRAM_SUPPORT_BOT_WEBHOOK_SECRET=

# Required only when MODE=production
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=cdn-winwidget-s3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://s3.twcstorage.ru/cdn-winwidget-s3
S3_KEY_PREFIX=можно оставить пустым, нужно для организации папок в хранилище
S3_FORCE_PATH_STYLE=true
