# Optional overlay inputs only. Do not build production env from this file.
# Keep canonical, CRM owner and Notification Delivery owner files synchronized.
# Requires CRM_RABBITMQ_CONTRACT=mvp-v1; explicit opt-in is task-reminders-v1.
CRM_REMINDERS_RABBITMQ_CONTRACT=disabled
# Separate independent pair secrets, distinct from existing Access/Identity/Operations credentials.
CRM_SALES_NOTIFICATION_DELIVERY_TOKEN=
NOTIFICATION_DELIVERY_CRM_SALES_TOKEN=
# Activation requires true only after reader, both migrations and scoped RabbitMQ ACL readiness.
CRM_TASK_REMINDERS_ENABLED=false
# Same owned Sales runtime identity/credential as API; connection_limit=4, pool_timeout=10.
CRM_SALES_REMINDERS_DATABASE_URL=
# Separate principal winwidget-crm-sales-reminders, loopback5672, existing winwidget vhost.
CRM_SALES_REMINDERS_RABBITMQ_URL=
# Existing CRM_SALES_IMAGE/REVISION, CRM_WORKER_MEMORY_LIMIT/CPUS and CRM_ACCESS_* inputs are reused.
