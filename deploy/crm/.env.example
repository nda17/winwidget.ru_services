# Structural input for standalone deploy/docker-compose.crm.yml, NOT a production env.
# Empty images/revisions/credentials/resource caps intentionally fail Compose config.
# Populate service-owned production files through the reviewed CRM controller only.
# No CRM profile is enabled by default; never set COMPOSE_PROFILES globally.
# Capacity must cover twelve runtimes, four databases and a serial migration job.
# These fields have NO recommended idle-derived defaults.
CRM_API_MEMORY_LIMIT=
CRM_API_CPUS=
CRM_WORKER_MEMORY_LIMIT=
CRM_WORKER_CPUS=
CRM_PUBLISHER_MEMORY_LIMIT=
CRM_PUBLISHER_CPUS=
CRM_MIGRATION_MEMORY_LIMIT=
CRM_MIGRATION_CPUS=
CRM_POSTGRES_MEMORY_LIMIT=
CRM_POSTGRES_CPUS=
CRM_POSTGRES_SHM_SIZE=
CRM_POSTGRES_IMAGE=

# Independent release gates. These never enable Gateway routes or Widgets producers.
CRM_ACCESS_BILLING_ENABLED=false
CRM_INTAKE_WIDGETS_ENABLED=false
CRM_INTAKE_WIDGET_TRANSFERS_ENABLED=false
IDENTITY_INTERNAL_BASE_URL=http://127.0.0.1:4900
BILLING_INTERNAL_BASE_URL=http://127.0.0.1:4800
CRM_SALES_INTERNAL_BASE_URL=http://127.0.0.1:5330
CRM_ACCESS_INTERNAL_BASE_URL=http://127.0.0.1:5300
CRM_CUSTOMERS_INTERNAL_BASE_URL=http://127.0.0.1:5320
WIDGETS_INTERNAL_BASE_URL=http://127.0.0.1:4700

# Unique pairwise secrets; exact same value only at the two agreed endpoints.
IDENTITY_CRM_ACCESS_TOKEN=
BILLING_CRM_ACCESS_TOKEN=
BILLING_CRM_ACCESS_COMMERCE_TOKEN=
CRM_SALES_CRM_ACCESS_TOKEN=
CRM_ACCESS_CRM_CUSTOMERS_TOKEN=
CRM_ACCESS_CRM_SALES_TOKEN=
CRM_ACCESS_CRM_INTAKE_TOKEN=
CRM_CUSTOMERS_CRM_INTAKE_TOKEN=
CRM_SALES_CRM_INTAKE_TOKEN=
WIDGETS_CRM_INTAKE_TOKEN=
CRM_CUSTOMERS_CRM_SALES_TOKEN=

# crm-access: pinned image digest/local immutable ID and exact 40-character revision.
CRM_ACCESS_IMAGE=
CRM_ACCESS_REVISION=
CRM_ACCESS_POSTGRES_ADMIN_PASSWORD_FILE=
# DB winwidget_crm_access, schema crm_access, loopback port 55442.
# Runtime role winwidget_crm_access_runtime; migration role winwidget_crm_access_migration.
# URLs must include schema, sslmode=disable, connection_limit, pool_timeout=10.
CRM_ACCESS_MIGRATION_DATABASE_URL=
# api: connection_limit=5; same service-owned runtime role/password.
CRM_ACCESS_API_DATABASE_URL=
# worker: connection_limit=4; same service-owned runtime role/password.
CRM_ACCESS_WORKER_DATABASE_URL=
CRM_ACCESS_WORKER_RABBITMQ_URL=
# outbox-publisher: connection_limit=1; same service-owned runtime role/password.
CRM_ACCESS_OUTBOX_PUBLISHER_DATABASE_URL=
CRM_ACCESS_OUTBOX_PUBLISHER_RABBITMQ_URL=

# crm-intake: pinned image digest/local immutable ID and exact 40-character revision.
CRM_INTAKE_IMAGE=
CRM_INTAKE_REVISION=
CRM_INTAKE_POSTGRES_ADMIN_PASSWORD_FILE=
# DB winwidget_crm_intake, schema crm_intake, loopback port 55443.
# Runtime role winwidget_crm_intake_runtime; migration role winwidget_crm_intake_migration.
# URLs must include schema, sslmode=disable, connection_limit, pool_timeout=10.
CRM_INTAKE_MIGRATION_DATABASE_URL=
# api: connection_limit=5; same service-owned runtime role/password.
CRM_INTAKE_API_DATABASE_URL=
# worker: connection_limit=4; same service-owned runtime role/password.
CRM_INTAKE_WORKER_DATABASE_URL=
CRM_INTAKE_WORKER_RABBITMQ_URL=
# publisher: connection_limit=1; same service-owned runtime role/password.
CRM_INTAKE_PUBLISHER_DATABASE_URL=
CRM_INTAKE_PUBLISHER_RABBITMQ_URL=
# widget-control-worker: connection_limit=4; same service-owned runtime role/password.
CRM_INTAKE_WIDGET_CONTROL_WORKER_DATABASE_URL=
CRM_INTAKE_WIDGET_CONTROL_WORKER_RABBITMQ_URL=
# widget-control-publisher: connection_limit=1; same service-owned runtime role/password.
CRM_INTAKE_WIDGET_CONTROL_PUBLISHER_DATABASE_URL=
CRM_INTAKE_WIDGET_CONTROL_PUBLISHER_RABBITMQ_URL=
# widget-transfer-worker: connection_limit=4; same service-owned runtime role/password.
CRM_INTAKE_WIDGET_TRANSFER_WORKER_DATABASE_URL=
CRM_INTAKE_WIDGET_TRANSFER_WORKER_RABBITMQ_URL=
# widget-transfer-publisher: connection_limit=1; same service-owned runtime role/password.
CRM_INTAKE_WIDGET_TRANSFER_PUBLISHER_DATABASE_URL=
CRM_INTAKE_WIDGET_TRANSFER_PUBLISHER_RABBITMQ_URL=

# crm-customers: pinned image digest/local immutable ID and exact 40-character revision.
CRM_CUSTOMERS_IMAGE=
CRM_CUSTOMERS_REVISION=
CRM_CUSTOMERS_POSTGRES_ADMIN_PASSWORD_FILE=
# DB winwidget_crm_customers, schema crm_customers, loopback port 55444.
# Runtime role winwidget_crm_customers_runtime; migration role winwidget_crm_customers_migration.
# URLs must include schema, sslmode=disable, connection_limit, pool_timeout=10.
CRM_CUSTOMERS_MIGRATION_DATABASE_URL=
# api: connection_limit=5; same service-owned runtime role/password.
CRM_CUSTOMERS_API_DATABASE_URL=

# crm-sales: pinned image digest/local immutable ID and exact 40-character revision.
CRM_SALES_IMAGE=
CRM_SALES_REVISION=
CRM_SALES_POSTGRES_ADMIN_PASSWORD_FILE=
# DB winwidget_crm_sales, schema crm_sales, loopback port 55445.
# Runtime role winwidget_crm_sales_runtime; migration role winwidget_crm_sales_migration.
# URLs must include schema, sslmode=disable, connection_limit, pool_timeout=10.
CRM_SALES_MIGRATION_DATABASE_URL=
# api: connection_limit=5; same service-owned runtime role/password.
CRM_SALES_API_DATABASE_URL=
