# One-shot Identity avatar migration credential. Never append these values to
# deploy/backend/.env.production and never pass this file to Docker Compose.
# Grant only GetObject on the inventoried legacy prefix and PutObject on the
# configured Identity avatar prefix; deny ListBucket and DeleteObject. Revoke
# it immediately after status parity and record physical denial evidence before
# activating avatar ownership.
IDENTITY_AVATAR_MIGRATION_S3_ACCESS_KEY_ID=
IDENTITY_AVATAR_MIGRATION_S3_SECRET_ACCESS_KEY=
# Populate only after deriving and reviewing the exact legacy
# `${S3_KEY_PREFIX}/user-avatar` prefix. Empty is intentionally fail-closed.
IDENTITY_AVATAR_MIGRATION_LEGACY_KEY_PREFIX=
IDENTITY_AVATAR_MIGRATION_LEGACY_PUBLIC_BASE_URL=https://s3.twcstorage.ru/cdn-winwidget-s3
# Exact trusted Core origin used only to map absolute
# https://api.winwidget.ru/uploads/user-avatar/* URLs to the read-only snapshot.
# Leave blank only when the inventory proves there are no absolute uploads URLs.
IDENTITY_AVATAR_MIGRATION_UPLOADS_PUBLIC_BASE_URL=https://api.winwidget.ru
# Populated only by the lifecycle tool after a bounded copy from the exact
# running Core container when inventory contains /uploads/user-avatar records.
IDENTITY_AVATAR_MIGRATION_UPLOADS_ROOT=
