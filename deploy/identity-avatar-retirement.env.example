# Short-lived post-soak credential used only by the SHA-B legacy-avatar
# retirement tool. Never append it to .env.production or Docker Compose.
# Grant GetBucketVersioning plus narrowly conditioned ListBucketVersions and
# HeadObject/GetObject/DeleteObject/DeleteObjectVersion only for the exact
# legacy avatar prefix below. Explicitly deny PutObject, ordinary ListObjects,
# and every operation on the Identity avatar prefix. Provision only after
# signed soak-complete evidence, retire every exact inventoried version and
# delete marker, prove zero versions, then revoke immediately and retain
# external revocation/denial evidence.
IDENTITY_AVATAR_RETIREMENT_S3_ACCESS_KEY_ID=
IDENTITY_AVATAR_RETIREMENT_S3_SECRET_ACCESS_KEY=
# Populate only from the signed SHA-A inventory. Empty is fail-closed.
IDENTITY_AVATAR_RETIREMENT_LEGACY_KEY_PREFIX=
