# Build output and dependencies
**/dist/
**/node_modules/
**/coverage/
/.nyc_output/
**/*.tsbuildinfo

# Generated widget runtime assets
**/public/widgets/

# Environment and credentials
**/.env
**/.env.*
!**/.env.example
**/*.pem

# Logs
logs/
**/*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editors and operating-system files
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.DS_Store
**/.DS_Store
