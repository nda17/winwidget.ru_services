NODE_ENV=development
APP_REVISION=local
TZ=Europe/Moscow

REPORTING_DATABASE_URL=postgresql://winwidget_reporting_runtime:change_me@127.0.0.1:55435/winwidget_reporting?schema=reporting&sslmode=disable
REPORTING_MIGRATION_DATABASE_URL=postgresql://winwidget_reporting_migration:change_me@127.0.0.1:55435/winwidget_reporting?schema=reporting&sslmode=disable
REPORTING_PROCESS_ROLE=all
REPORTING_LISTEN_HOST=127.0.0.1
REPORTING_PORT=4600
REPORTING_SCHEDULER_ENABLED=false
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000

OPERATIONS_INTERNAL_BASE_URL=http://127.0.0.1:5200
REPORTING_INTERNAL_TOKEN=change_me_to_a_unique_secret_with_at_least_32_chars
REPORTING_INTERNAL_TIMEOUT_MS=10000
REPORTING_OPERATIONS_TOKEN=change_me_to_a_unique_operations_secret_with_at_least_32_chars

IDENTITY_INTERNAL_BASE_URL=http://127.0.0.1:4900
IDENTITY_REPORTING_TOKEN=change_me_to_a_unique_identity_secret_with_at_least_32_chars
IDENTITY_INTERNAL_TIMEOUT_MS=10000

RABBITMQ_URL=amqp://reporting:change_me@127.0.0.1:5672/winwidget
RABBITMQ_ASSERT_TOPOLOGY=true
RABBITMQ_CONNECTION_NAME=reporting-local
RABBITMQ_MAX_MESSAGE_BYTES=262144
REPORTING_PREFETCH=10
REPORTING_OUTBOX_BATCH_SIZE=50
REPORTING_OUTBOX_POLL_INTERVAL_MS=1000
REPORTING_OUTBOX_RETENTION_DAYS=7
