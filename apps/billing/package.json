{
	"name": "@winwidget/billing",
	"version": "1.0.0",
	"private": true,
	"description": "WinWidget billing microservice",
	"license": "UNLICENSED",
	"packageManager": "pnpm@9.15.9",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/src/main.js",
		"lint": "eslint \"src/**/*.ts\" --max-warnings=0",
		"test": "jest --runInBand",
		"test:migration:crm-provenance": "node test/integration/crm-entitlement-provenance-migration-postgres18.integration.mjs",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"prisma:generate": "prisma generate --schema prisma/schema.prisma",
		"prisma:validate": "prisma validate --schema prisma/schema.prisma",
		"prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma"
	},
	"dependencies": {
		"@nestjs/common": "^10.4.15",
		"@nestjs/config": "^3.3.0",
		"@nestjs/core": "^10.4.15",
		"@nestjs/platform-express": "^10.4.15",
		"@prisma/client": "5.22.0",
		"amqp-connection-manager": "^5.0.0",
		"amqplib": "^0.10.9",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1",
		"express": "^4.22.1",
		"prisma": "5.22.0",
		"reflect-metadata": "^0.1.14",
		"rxjs": "^7.8.1"
	},
	"devDependencies": {
		"@nestjs/testing": "^10.4.15",
		"@types/amqplib": "^0.10.8",
		"@types/express": "^4.17.21",
		"@types/jest": "^29.5.14",
		"@types/node": "^20.17.12",
		"@typescript-eslint/eslint-plugin": "^6.21.0",
		"@typescript-eslint/parser": "^6.21.0",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^9.1.0",
		"jest": "^29.7.0",
		"ts-jest": "^29.2.5",
		"typescript": "^5.7.3"
	},
	"pnpm": {
		"overrides": {
			"@nestjs/config>lodash": "4.18.1",
			"@nestjs/platform-express>multer": "2.2.0"
		}
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": ".",
		"testRegex": "src/.*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": [
				"ts-jest",
				{
					"tsconfig": "tsconfig.json"
				}
			]
		},
		"testEnvironment": "node"
	}
}
