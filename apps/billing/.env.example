MODE=development
APP_REVISION=local

BILLING_PROCESS_ROLE=api
BILLING_API_PORT=4800
BILLING_SCHEDULER_PORT=4801
BILLING_WORKER_PORT=4802
BILLING_OUTBOX_PUBLISHER_PORT=4803
BILLING_LISTEN_HOST=127.0.0.1
BILLING_DATABASE_URL=postgresql://winwidget_billing_runtime:change_me@127.0.0.1:55437/winwidget_billing?schema=billing&sslmode=disable
BILLING_MIGRATION_DATABASE_URL=postgresql://winwidget_billing_migration:change_me@127.0.0.1:55437/winwidget_billing?schema=billing&sslmode=disable

CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=loopback
RECAPTCHA_CLIENT_URL=http://localhost:3000

# Inbound service credentials. Use distinct random values in production.
BILLING_IDENTITY_TOKEN=change_me
BILLING_CRM_ACCESS_TOKEN=change_me
BILLING_CAMPAIGNS_TOKEN=change_me
BILLING_OPERATIONS_TOKEN=change_me

# Outbound private HTTP dependencies.
IDENTITY_INTERNAL_BASE_URL=http://127.0.0.1:4900
IDENTITY_INTERNAL_TIMEOUT_MS=10000
IDENTITY_BILLING_TOKEN=change_me
WIDGETS_INTERNAL_BASE_URL=http://127.0.0.1:4700
WIDGETS_INTERNAL_TIMEOUT_MS=3000
WIDGETS_INTERNAL_TOKEN=change_me

PAYMENT_METHOD_ENCRYPTION_KEY=change_me
YOOKASSA_SHOP_ID=change_me
YOOKASSA_SECRET_KEY=change_me
YOOKASSA_PRODUCTION_SHOP_ID=change_me
YOOKASSA_PRODUCTION_SECRET_KEY=change_me

RABBITMQ_URL=amqp://winwidget-billing:change_me@127.0.0.1:5672/winwidget
# Must equal winwidget-billing-<BILLING_PROCESS_ROLE> for worker/publisher roles.
RABBITMQ_CONNECTION_NAME=winwidget-billing-api
RABBITMQ_ASSERT_TOPOLOGY=false
RABBITMQ_MAX_MESSAGE_BYTES=262144
BILLING_PREFETCH=10
BILLING_OUTBOX_BATCH_SIZE=50
BILLING_OUTBOX_POLL_INTERVAL_MS=1000
BILLING_OUTBOX_RETENTION_DAYS=7
BILLING_RECEIPT_RETENTION_DAYS=90
BILLING_FAILURE_DETAIL_RETENTION_DAYS=30
