MODE=development
APP_REVISION=local

CRM_ACCESS_PORT=5300
CRM_ACCESS_PROCESS_ROLE=api
# Worker: port5301/name winwidget-crm-access-worker; publisher: port5302/name winwidget-crm-access-outbox-publisher.
RABBITMQ_URL=
RABBITMQ_CONNECTION_NAME=
CRM_ACCESS_LISTEN_HOST=127.0.0.1
CRM_ACCESS_DATABASE_URL=postgresql://winwidget_crm_access_runtime:change_me@127.0.0.1:55442/winwidget_crm_access?schema=crm_access&sslmode=disable
CRM_ACCESS_MIGRATION_DATABASE_URL=postgresql://winwidget_crm_access_migration:change_me@127.0.0.1:55442/winwidget_crm_access?schema=crm_access&sslmode=disable

CORS_ALLOWED_ORIGINS=http://localhost:3001
TRUST_PROXY=loopback

# Outbound private HTTP dependencies. Use distinct random secrets in production.
IDENTITY_INTERNAL_BASE_URL=http://127.0.0.1:4900
IDENTITY_INTERNAL_TIMEOUT_MS=10000
IDENTITY_CRM_ACCESS_TOKEN=change_me
BILLING_INTERNAL_BASE_URL=http://127.0.0.1:4800
BILLING_CRM_ACCESS_TIMEOUT_MS=10000
BILLING_CRM_ACCESS_TOKEN=change_me
# Paid WinCRM commands are owner-only and default-off until the commerce rollout.
CRM_ACCESS_BILLING_ENABLED=false
# Independent reverse credential: Billing -> CRM Access, never reuse the token above.
BILLING_CRM_ACCESS_COMMERCE_TOKEN=change_me
CRM_SALES_INTERNAL_BASE_URL=http://127.0.0.1:5330
CRM_SALES_INTERNAL_TIMEOUT_MS=10000
CRM_SALES_CRM_ACCESS_TOKEN=change_me

# Inbound scoped credentials from CRM services on the CRM backend VPS.
CRM_ACCESS_CRM_CUSTOMERS_TOKEN=change_me
CRM_ACCESS_CRM_SALES_TOKEN=change_me
CRM_ACCESS_CRM_INTAKE_TOKEN=change_me
