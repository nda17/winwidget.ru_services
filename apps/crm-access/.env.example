MODE=development
APP_REVISION=local

CRM_ACCESS_PORT=5300
CRM_ACCESS_LISTEN_HOST=127.0.0.1
CRM_ACCESS_DATABASE_URL=postgresql://winwidget_crm_access_runtime:change_me@127.0.0.1:55442/winwidget_crm_access?schema=crm_access&sslmode=disable
CRM_ACCESS_MIGRATION_DATABASE_URL=postgresql://winwidget_crm_access_migration:change_me@127.0.0.1:55442/winwidget_crm_access?schema=crm_access&sslmode=disable

CORS_ALLOWED_ORIGINS=http://localhost:3001
