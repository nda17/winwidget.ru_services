NODE_ENV=development
MODE=development
APP_REVISION=local

CAMPAIGNS_PROCESS_ROLE=all
CAMPAIGNS_LISTEN_HOST=127.0.0.1
CAMPAIGNS_HEALTH_PORT=4500
CAMPAIGNS_DATABASE_URL=postgresql://winwidget_campaigns_runtime:change_me@127.0.0.1:55433/winwidget_campaigns?schema=campaigns&sslmode=disable
CAMPAIGNS_MIGRATION_DATABASE_URL=postgresql://winwidget_campaigns_migration:change_me@127.0.0.1:55433/winwidget_campaigns?schema=campaigns&sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Operations -> Campaigns monitoring.
CAMPAIGNS_OPERATIONS_TOKEN=change_me

# Campaigns -> Identity and Billing.
IDENTITY_INTERNAL_BASE_URL=http://127.0.0.1:4900
IDENTITY_INTERNAL_TIMEOUT_MS=10000
IDENTITY_CAMPAIGNS_TOKEN=change_me
BILLING_INTERNAL_BASE_URL=http://127.0.0.1:4800
BILLING_CAMPAIGNS_TOKEN=change_me
CAMPAIGNS_AUDIENCE_EXPORT_TIMEOUT_MS=30000
CAMPAIGNS_AUDIENCE_IMPORT_BATCH_SIZE=500

RABBITMQ_URL=amqp://winwidget-campaigns:change_me@127.0.0.1:5672/winwidget
RABBITMQ_CONNECTION_NAME=winwidget-campaigns-all
RABBITMQ_ASSERT_TOPOLOGY=true
RABBITMQ_MAX_MESSAGE_BYTES=262144
CAMPAIGNS_PREFETCH=10
CAMPAIGNS_OUTBOX_BATCH_SIZE=50
CAMPAIGNS_OUTBOX_POLL_INTERVAL_MS=1000
CAMPAIGNS_OUTBOX_RETENTION_DAYS=7
CAMPAIGNS_EMAIL_RATE_PER_SECOND=10
CAMPAIGNS_TELEGRAM_RATE_PER_SECOND=5
