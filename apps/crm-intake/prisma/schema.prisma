generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/@prisma/crm-intake-client"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("CRM_INTAKE_DATABASE_URL")
  schemas  = ["crm_intake"]
}

model ExportAudit {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  actorSubject String @map("actor_subject") @db.VarChar(256)
  entity String @db.VarChar(16)
  format String @db.VarChar(4)
  rowCount Int @map("row_count")
  byteCount Int @map("byte_count")
  snapshotAt DateTime @map("snapshot_at")
  preparedAt DateTime @default(now()) @map("prepared_at")

  @@index([workspaceId, preparedAt, id], map: "export_audit_workspace_prepared_idx")
  @@map("export_audit")
  @@schema("crm_intake")
}

model ManagedWidgetSource {
 id String @id @default(uuid()) @db.Uuid
 workspaceId String @map("workspace_id") @db.Uuid
 name String @db.VarChar(200)
 ownerSubject String @map("owner_subject") @db.VarChar(256)
 widgetType String @map("widget_type") @db.VarChar(16)
 widgetId String @map("widget_id") @db.VarChar(255)
 connectorId String @unique @map("connector_id") @db.Uuid
 createdBySubject String @map("created_by_subject") @db.VarChar(256)
 teamId String? @map("team_id") @db.Uuid
 version Int @default(1)
 controlVersion Int @default(1) @map("control_version")
 generation Int @default(1)
 enabled Boolean @default(true)
 currentCommandId String @map("current_command_id") @db.Uuid
 appliedControlVersion Int? @map("applied_control_version")
 appliedGeneration Int? @map("applied_generation")
 syncState String @default("PENDING") @map("sync_state") @db.VarChar(16)
 lastErrorCode String? @map("last_error_code") @db.VarChar(64)
 syncedAt DateTime? @map("synced_at")
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")
 @@unique([id,workspaceId])
 @@index([workspaceId,createdAt,id])
 @@map("managed_widget_sources")
 @@schema("crm_intake")
}
model WidgetControlJob {
 commandId String @id @map("command_id") @db.Uuid
 workspaceId String @map("workspace_id") @db.Uuid
 sourceId String @map("source_id") @db.Uuid
 connectorId String @map("connector_id") @db.Uuid
 ownerSubject String @map("owner_subject") @db.VarChar(256)
 actorSubject String @map("actor_subject") @db.VarChar(256)
 requestedBySubject String @map("requested_by_subject") @db.VarChar(256)
 widgetType String @map("widget_type") @db.VarChar(16)
 widgetId String @map("widget_id") @db.VarChar(255)
 controlVersion Int @map("control_version")
 generation Int
 enabled Boolean
 status String @default("PENDING") @db.VarChar(16)
 leaseToken String? @map("lease_token") @db.Uuid
 leaseUntil DateTime? @map("lease_until")
 activeEventId String @map("active_event_id") @db.Uuid
 response Json?
 lastErrorCode String? @map("last_error_code") @db.VarChar(64)
 completedAt DateTime? @map("completed_at")
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")
 @@unique([sourceId,controlVersion])
 @@unique([commandId,workspaceId,sourceId])
 @@map("widget_control_jobs")
 @@schema("crm_intake")
}
model WidgetControlReceipt {
 eventId String @map("event_id") @db.Uuid
 consumer String @db.VarChar(80)
 workspaceId String @map("workspace_id") @db.Uuid
 sourceId String @map("source_id") @db.Uuid
 commandId String @map("command_id") @db.Uuid
 payloadHash String @map("payload_hash") @db.Char(64)
 status String @db.VarChar(24)
 leaseToken String? @map("lease_token") @db.Uuid
 leaseUntil DateTime? @map("lease_until")
 retryAttempt Int @default(0) @map("retry_attempt")
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")
 @@id([eventId,consumer])
 @@map("widget_control_receipts")
 @@schema("crm_intake")
}
model WidgetControlOutbox {
 id String @id @default(uuid()) @db.Uuid
 eventId String @map("event_id") @db.Uuid
 deduplicationKey String @unique @map("deduplication_key") @db.VarChar(256)
 route String @default("MAIN") @db.VarChar(16)
 payload Json
 status String @default("PENDING") @db.VarChar(16)
 availableAt DateTime @default(now()) @map("available_at")
 leaseToken String? @map("lease_token") @db.Uuid
 leaseUntil DateTime? @map("lease_until")
 attempts Int @default(0)
 retryAttempt Int @default(0) @map("retry_attempt")
 lastErrorCode String? @map("last_error_code") @db.VarChar(64)
 publishedAt DateTime? @map("published_at")
 createdAt DateTime @default(now()) @map("created_at")
 @@index([status,availableAt,id])
 @@map("widget_control_outbox")
 @@schema("crm_intake")
}

model ServiceIdentity {
  id          String   @id @default("singleton")
  serviceName String   @default("crm-intake-service") @map("service_name")
  databaseId  String   @unique(map: "service_identity_database_id_key") @default(uuid()) @map("database_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("service_identity")
  @@schema("crm_intake")
}

model InboxEntry {
  id               String          @id @default(uuid()) @db.Uuid
  workspaceId      String          @map("workspace_id") @db.Uuid
  title            String          @db.VarChar(200)
  name             String?         @db.VarChar(200)
  phone            String?         @db.VarChar(16)
  email            String?         @db.VarChar(254)
  message          String?         @db.VarChar(5000)
  origin           String          @db.VarChar(16)
  sourceId         String?         @map("source_id") @db.Uuid
  widgetSourceId   String?         @map("widget_source_id") @db.Uuid
  status           String          @default("NEW") @db.VarChar(16)
  createdBySubject String          @map("created_by_subject") @db.VarChar(256)
  teamId           String?         @map("team_id") @db.Uuid
  version          Int             @default(1)
  contactId        String?         @map("contact_id") @db.Uuid
  dealId           String?         @map("deal_id") @db.Uuid
  rejectionReason  String?         @map("rejection_reason") @db.VarChar(2000)
  receivedAt       DateTime        @default(now()) @map("received_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  acceptedAt       DateTime?       @map("accepted_at")
  rejectedAt       DateTime?       @map("rejected_at")
  source           IntakeSource?   @relation(fields: [workspaceId, sourceId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  inboundReceipt   InboundReceipt?
  csvImportRow     CsvImportRow?
  widgetSnapshot   WidgetEntrySnapshot?

  @@unique([workspaceId, id])
  @@index([workspaceId, status, receivedAt, id])
  @@index([workspaceId, createdBySubject, status])
  @@index([workspaceId, teamId, status])
  @@index([workspaceId, sourceId])
  @@index([workspaceId, widgetSourceId])
  @@map("inbox_entries")
  @@schema("crm_intake")
}

model WidgetTransferReceipt {
  eventId          String    @map("event_id") @db.Uuid
  consumer         String    @db.VarChar(80)
  transferId       String    @map("transfer_id") @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  sourceId         String    @map("source_id") @db.Uuid
  connectorId      String    @map("connector_id") @db.Uuid
  generation       Int
  actorSubject     String    @map("actor_subject") @db.VarChar(256)
  ownerSubject     String    @map("owner_subject") @db.VarChar(256)
  teamId           String?   @map("team_id") @db.Uuid
  event            Json
  payloadHash      String    @map("payload_hash") @db.Char(64)
  originalDeadline DateTime? @map("original_deadline")
  status           String    @db.VarChar(24)
  version          Int       @default(1)
  retryGeneration  Int       @default(0) @map("retry_generation")
  retryAttempt     Int       @default(0) @map("retry_attempt")
  leaseToken       String?   @map("lease_token") @db.Uuid
  leaseUntil       DateTime? @map("lease_until")
  entryId          String?   @unique @map("entry_id") @db.Uuid
  auditCommandId   String?   @unique @map("audit_command_id") @db.Uuid
  lastErrorCode    String?   @map("last_error_code") @db.VarChar(64)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  completedAt      DateTime? @map("completed_at")

  @@id([eventId, consumer])
  @@unique([transferId, consumer])
  @@index([workspaceId, sourceId, createdAt, transferId], map: "widget_transfer_receipts_source_created_idx")
  @@map("widget_transfer_receipts")
  @@schema("crm_intake")
}

model WidgetEntrySnapshot {
  entryId      String     @id @map("entry_id") @db.Uuid
  workspaceId  String     @map("workspace_id") @db.Uuid
  sourceId     String     @map("source_id") @db.Uuid
  transferId   String     @unique @map("transfer_id") @db.Uuid
  eventId      String     @unique @map("event_id") @db.Uuid
  payload      Json
  payloadHash  String     @map("payload_hash") @db.Char(64)
  byteCount    Int        @map("byte_count")
  createdAt    DateTime   @default(now()) @map("created_at")
  entry        InboxEntry @relation(fields: [workspaceId, entryId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([workspaceId, entryId])
  @@map("widget_entry_snapshots")
  @@schema("crm_intake")
}

model WidgetTransferOutbox {
  id               String    @id @default(uuid()) @db.Uuid
  eventId          String    @map("event_id") @db.Uuid
  deduplicationKey String    @unique @map("deduplication_key") @db.VarChar(256)
  route            String    @default("MAIN") @db.VarChar(16)
  payload          Json
  status           String    @default("PENDING") @db.VarChar(16)
  availableAt      DateTime  @default(now()) @map("available_at")
  leaseToken       String?   @map("lease_token") @db.Uuid
  leaseUntil       DateTime? @map("lease_until")
  attempts         Int       @default(0)
  retryAttempt     Int       @default(0) @map("retry_attempt")
  retryGeneration  Int       @default(0) @map("retry_generation")
  lastErrorCode    String?   @map("last_error_code") @db.VarChar(64)
  publishedAt     DateTime? @map("published_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([status, availableAt, id])
  @@map("widget_transfer_outbox")
  @@schema("crm_intake")
}

model IntakeSource {
  id               String           @id @default(uuid()) @db.Uuid
  workspaceId      String           @map("workspace_id") @db.Uuid
  name             String           @db.VarChar(200)
  kind             String           @default("API") @db.VarChar(16)
  tokenHash        String           @unique @map("token_hash") @db.Char(64)
  tokenVersion     Int              @default(1) @map("token_version")
  createdBySubject String           @map("created_by_subject") @db.VarChar(256)
  teamId           String?          @map("team_id") @db.Uuid
  version          Int              @default(1)
  revokedAt        DateTime?        @map("revoked_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  entries          InboxEntry[]
  inboundReceipts  InboundReceipt[]

  @@unique([workspaceId, id])
  @@index([workspaceId, createdAt, id])
  @@map("intake_sources")
  @@schema("crm_intake")
}

model IntakeCommand {
  commandId    String     @id @map("command_id") @db.Uuid
  workspaceId  String     @map("workspace_id") @db.Uuid
  entityId     String     @map("entity_id") @db.Uuid
  entityKind   String     @map("entity_kind") @db.VarChar(16)
  actorSubject String     @map("actor_subject") @db.VarChar(256)
  requestHash  String     @map("request_hash") @db.Char(64)
  response     Json
  createdAt    DateTime   @default(now()) @map("created_at")
  csvImport    CsvImport?

  @@index([workspaceId, entityId])
  @@map("intake_commands")
  @@schema("crm_intake")
}

model IntakeActivity {
  id            String        @id @default(uuid()) @db.Uuid
  workspaceId   String        @map("workspace_id") @db.Uuid
  entityId      String        @map("entity_id") @db.Uuid
  entityKind    String        @map("entity_kind") @db.VarChar(16)
  commandId     String        @unique @map("command_id") @db.Uuid
  actorSubject  String        @map("actor_subject") @db.VarChar(256)
  action        String        @db.VarChar(32)
  entityVersion Int           @map("entity_version")
  createdAt     DateTime      @default(now()) @map("created_at")
  csvImportRow  CsvImportRow?

  @@index([workspaceId, entityKind, entityId, createdAt, id], map: "intake_activities_entity_created_idx")
  @@map("intake_activities")
  @@schema("crm_intake")
}

model CsvImport {
  id               String         @id @db.Uuid
  workspaceId      String         @map("workspace_id") @db.Uuid
  createdBySubject String         @map("created_by_subject") @db.VarChar(256)
  teamId           String?        @map("team_id") @db.Uuid
  label            String         @db.VarChar(200)
  rowCount         Int            @map("row_count")
  createdAt        DateTime       @default(now()) @map("created_at")
  command          IntakeCommand  @relation(fields: [id], references: [commandId], onDelete: Restrict, onUpdate: Restrict)
  rows             CsvImportRow[]

  @@unique([workspaceId, id])
  @@index([workspaceId, createdBySubject, createdAt])
  @@index([workspaceId, teamId, createdAt])
  @@map("csv_imports")
  @@schema("crm_intake")
}

model CsvImportRow {
  importId       String         @map("import_id") @db.Uuid
  workspaceId    String         @map("workspace_id") @db.Uuid
  rowNumber      Int            @map("row_number") @db.SmallInt
  entryId        String         @map("entry_id") @db.Uuid
  auditCommandId String         @unique @map("audit_command_id") @db.Uuid
  import         CsvImport      @relation(fields: [workspaceId, importId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  entry          InboxEntry     @relation(fields: [workspaceId, entryId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  activity       IntakeActivity @relation(fields: [auditCommandId], references: [commandId], onDelete: Restrict, onUpdate: Restrict)

  @@id([importId, rowNumber])
  @@unique([workspaceId, entryId])
  @@map("csv_import_rows")
  @@schema("crm_intake")
}

model InboundReceipt {
  sourceId          String       @map("source_id") @db.Uuid
  externalCommandId String       @map("external_command_id") @db.Uuid
  workspaceId       String       @map("workspace_id") @db.Uuid
  entryId           String       @map("entry_id") @db.Uuid
  auditCommandId    String       @unique @map("audit_command_id") @db.Uuid
  requestHash       String       @map("request_hash") @db.Char(64)
  receivedAt        DateTime     @map("received_at")
  source            IntakeSource @relation(fields: [workspaceId, sourceId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  entry             InboxEntry   @relation(fields: [workspaceId, entryId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([sourceId, externalCommandId])
  @@unique([workspaceId, entryId])
  @@map("inbound_receipts")
  @@schema("crm_intake")
}

model IngestionRateBucket {
  bucketKey   String   @map("bucket_key") @db.VarChar(80)
  windowStart DateTime @map("window_start")
  count       Int

  @@id([bucketKey, windowStart])
  @@map("ingestion_rate_buckets")
  @@schema("crm_intake")
}

model Acceptance {
  id                       String    @id @default(uuid()) @db.Uuid
  workspaceId              String    @map("workspace_id") @db.Uuid
  entryId                  String    @map("entry_id") @db.Uuid
  actorSubject             String    @map("actor_subject") @db.VarChar(256)
  status                   String    @default("QUEUED") @db.VarChar(24)
  version                  Int       @default(1)
  generation               Int       @default(1)
  mode                     String    @default("EXECUTE") @db.VarChar(16)
  contactOperationId       String    @unique @map("contact_operation_id") @db.Uuid
  salesOperationId         String    @unique @map("sales_operation_id") @db.Uuid
  contactCommandId         String    @unique @map("contact_command_id") @db.Uuid
  salesCommandId           String    @unique @map("sales_command_id") @db.Uuid
  contactPayload           Json      @map("contact_payload")
  salesPayload             Json      @map("sales_payload")
  contactPayloadHash       String    @map("contact_payload_hash") @db.Char(64)
  salesPayloadHash         String    @map("sales_payload_hash") @db.Char(64)
  contactProof             Json?     @map("contact_proof")
  salesProof               Json?     @map("sales_proof")
  contactId                String?   @map("contact_id") @db.Uuid
  dealId                   String?   @map("deal_id") @db.Uuid
  firstTaskId              String?   @map("first_task_id") @db.Uuid
  recoverySubject          String?   @map("recovery_subject") @db.VarChar(256)
  recoveryContactCommandId String?   @map("recovery_contact_command_id") @db.Uuid
  recoverySalesCommandId   String?   @map("recovery_sales_command_id") @db.Uuid
  lastErrorCode            String?   @map("last_error_code") @db.VarChar(64)
  retryAt                  DateTime? @map("retry_at")
  completedAt              DateTime? @map("completed_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId, entryId, createdAt])
  @@map("acceptances")
  @@schema("crm_intake")
}

model AcceptanceOutbox {
  id               String    @id @default(uuid()) @db.Uuid
  eventId          String    @map("event_id") @db.Uuid
  deduplicationKey String    @unique @map("deduplication_key") @db.VarChar(256)
  route            String    @default("MAIN") @db.VarChar(16)
  payload          Json
  status           String    @default("PENDING") @db.VarChar(16)
  availableAt      DateTime  @default(now()) @map("available_at")
  leaseToken       String?   @map("lease_token") @db.Uuid
  leaseUntil       DateTime? @map("lease_until")
  attempts         Int       @default(0)
  retryAttempt     Int       @default(0) @map("retry_attempt")
  lastErrorCode    String?   @map("last_error_code") @db.VarChar(64)
  publishedAt      DateTime? @map("published_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([status, availableAt, id])
  @@map("acceptance_outbox")
  @@schema("crm_intake")
}

model AcceptanceReceipt {
  eventId      String    @map("event_id") @db.Uuid
  consumer     String    @db.VarChar(80)
  workspaceId  String    @map("workspace_id") @db.Uuid
  workflowId   String    @map("workflow_id") @db.Uuid
  payloadHash  String    @map("payload_hash") @db.Char(64)
  status       String    @db.VarChar(24)
  leaseToken   String?   @map("lease_token") @db.Uuid
  leaseUntil   DateTime? @map("lease_until")
  retryAttempt Int       @default(0) @map("retry_attempt")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@id([eventId, consumer])
  @@map("acceptance_receipts")
  @@schema("crm_intake")
}
