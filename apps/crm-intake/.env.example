NODE_ENV=development
MODE=development
APP_REVISION=local

CRM_INTAKE_LISTEN_HOST=127.0.0.1
CRM_INTAKE_PORT=5310
CRM_INTAKE_DATABASE_URL=postgresql://winwidget_crm_intake_runtime:change_me@127.0.0.1:55443/winwidget_crm_intake?schema=crm_intake&sslmode=disable
CRM_INTAKE_MIGRATION_DATABASE_URL=postgresql://winwidget_crm_intake_migration:change_me@127.0.0.1:55443/winwidget_crm_intake?schema=crm_intake&sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:3001

# Required pairwise authorization with crm-access; use HTTPS for another VPS.
CRM_ACCESS_INTERNAL_BASE_URL=http://127.0.0.1:5300
CRM_ACCESS_CRM_INTAKE_TOKEN=change_me_at_least_32_random_characters
CRM_ACCESS_INTERNAL_TIMEOUT_MS=10000
# Independent roles: api (5310), acceptance worker (5311), publisher (5312), all (5310, local checks).
CRM_INTAKE_PROCESS_ROLE=api
CRM_CUSTOMERS_INTERNAL_BASE_URL=http://127.0.0.1:5320
CRM_CUSTOMERS_CRM_INTAKE_TOKEN=change_me
CRM_SALES_INTERNAL_BASE_URL=http://127.0.0.1:5330
CRM_SALES_CRM_INTAKE_TOKEN=change_me
# Required only by background roles/all; use amqps and a scoped broker principal outside loopback.
CRM_INTAKE_RABBITMQ_URL=amqp://change_me:change_me@127.0.0.1:5672/crm_intake
# Production topology and ACLs are provisioned separately. Enable only for scoped local provisioning.
CRM_INTAKE_RABBITMQ_ASSERT_TOPOLOGY=false

# Additive managed Widgets control plane, OFF until coordinated local/rollout gates.
# Does not yet enable incoming Widgets lead transfers. No new credentials required when false.
CRM_INTAKE_WIDGETS_ENABLED=false
# Enabled background roles: widget-control-worker (5313), widget-control-publisher (5314).
# These use their own broker principal/queues, separate from acceptance processes.
WIDGETS_INTERNAL_BASE_URL=http://127.0.0.1:4700
WIDGETS_CRM_INTAKE_TOKEN=change_me
CRM_INTAKE_WIDGETS_HTTP_TIMEOUT_MS=3000
# Transfer ingestion is an independent opt-in; requires readers/migrations/broker gates first.
CRM_INTAKE_WIDGET_TRANSFERS_ENABLED=false
# widget-transfer-worker (5315) and widget-transfer-publisher (5316) use separate process-scoped broker credentials.
