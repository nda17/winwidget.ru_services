NODE_ENV=development
MODE=development
APP_REVISION=local

CRM_INTAKE_LISTEN_HOST=127.0.0.1
CRM_INTAKE_PORT=5310
CRM_INTAKE_DATABASE_URL=postgresql://winwidget_crm_intake_runtime:change_me@127.0.0.1:55443/winwidget_crm_intake?schema=crm_intake&sslmode=disable
CRM_INTAKE_MIGRATION_DATABASE_URL=postgresql://winwidget_crm_intake_migration:change_me@127.0.0.1:55443/winwidget_crm_intake?schema=crm_intake&sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:3001

# Required pairwise authorization with crm-access; use HTTPS for another VPS.
CRM_ACCESS_INTERNAL_BASE_URL=http://127.0.0.1:5300
CRM_ACCESS_CRM_INTAKE_TOKEN=change_me_at_least_32_random_characters
CRM_ACCESS_INTERNAL_TIMEOUT_MS=10000
