{
	"name": "@winwidget/api-gateway",
	"version": "1.0.0",
	"private": true,
	"description": "WinWidget public API Gateway",
	"packageManager": "pnpm@9.15.9",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"start": "node dist/src/main.js",
		"start:local": "node --env-file=.env dist/src/main.js",
		"test": "pnpm run build && node --test dist/test/*.test.js",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"devDependencies": {
		"@types/node": "^20.17.12",
		"typescript": "^5.7.3"
	}
}
