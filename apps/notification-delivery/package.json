{
	"name": "@winwidget/notification-delivery",
	"version": "1.0.0",
	"private": true,
	"description": "WinWidget notification delivery microservice",
	"license": "UNLICENSED",
	"packageManager": "pnpm@9.15.9",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/src/main.js",
		"start:local": "node --env-file=.env dist/src/main.js",
		"lint": "eslint \"{src,emails}/**/*.{ts,tsx}\" --max-warnings=0",
		"test": "jest --runInBand",
		"test:integration": "node test/integration/notification-delivery.integration.mjs",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"prisma:generate": "prisma generate --schema prisma/schema.prisma",
		"prisma:validate": "prisma validate --schema prisma/schema.prisma",
		"prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma"
	},
	"dependencies": {
		"@nestjs/common": "^10.4.15",
		"@nestjs/config": "^3.3.0",
		"@nestjs/core": "^10.4.15",
		"@nestjs/platform-express": "^10.4.15",
		"@prisma/client": "5.22.0",
		"@react-email/components": "0.0.21",
		"@react-email/render": "^0.0.16",
		"amqp-connection-manager": "^5.0.0",
		"amqplib": "^0.10.9",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1",
		"express": "^4.22.2",
		"nodemailer": "9.0.3",
		"prisma": "5.22.0",
		"react": "^18.3.1",
		"reflect-metadata": "^0.1.14",
		"rxjs": "^7.8.1"
	},
	"devDependencies": {
		"@nestjs/testing": "^10.4.15",
		"@types/amqplib": "^0.10.8",
		"@types/express": "^4.17.21",
		"@types/jest": "^29.5.14",
		"@types/node": "^20.17.12",
		"@types/nodemailer": "8.0.1",
		"@types/react": "^18.3.18",
		"@typescript-eslint/eslint-plugin": "^6.21.0",
		"@typescript-eslint/parser": "^6.21.0",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^9.1.0",
		"jest": "^29.7.0",
		"smtp-server": "^3.13.6",
		"ts-jest": "^29.2.5",
		"typescript": "^5.7.3"
	},
	"pnpm": {
		"overrides": {
			"@nestjs/config>lodash": "4.18.1",
			"@nestjs/platform-express>body-parser": "1.20.6",
			"@nestjs/platform-express>express": "4.22.2",
			"@nestjs/platform-express>multer": "2.2.0",
			"@react-email/code-block>prismjs": "1.30.0",
			"minimatch@9.0.3>brace-expansion": "2.1.4"
		}
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts",
			"tsx"
		],
		"rootDir": ".",
		"testRegex": "src/.*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)sx?$": [
				"ts-jest",
				{
					"tsconfig": "tsconfig.json"
				}
			]
		},
		"testEnvironment": "node"
	}
}
