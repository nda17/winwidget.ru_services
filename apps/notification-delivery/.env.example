MODE=development
APP_REVISION=local

NOTIFICATION_DELIVERY_LISTEN_HOST=127.0.0.1
NOTIFICATION_DELIVERY_HEALTH_PORT=4401
NOTIFICATION_DELIVERY_DATABASE_URL=postgresql://winwidget_notification_delivery_runtime:change_me@127.0.0.1:55432/winwidget_notification_delivery?schema=notification_delivery&sslmode=disable
NOTIFICATION_DELIVERY_MIGRATION_URL_PRODUCTION=postgresql://winwidget_notification_delivery_migration:change_me@127.0.0.1:55432/winwidget_notification_delivery?schema=notification_delivery&sslmode=disable
NOTIFICATION_DELIVERY_KINDS=email,telegram,payment-email,payment-telegram,limit-email,limit-telegram,campaign-email,campaign-telegram,daily-summary-delivery-telegram,subscription-expiry-email,subscription-expiry-telegram
NOTIFICATION_DELIVERY_PREFETCH=5
NOTIFICATION_DELIVERY_OUTBOX_BATCH_SIZE=50
NOTIFICATION_DELIVERY_OUTBOX_POLL_INTERVAL_MS=1000
NOTIFICATION_DELIVERY_OUTBOX_RETENTION_DAYS=7
NOTIFICATION_DELIVERY_RECEIPT_RETENTION_DAYS=90
NOTIFICATION_DELIVERY_FAILURE_DETAIL_RETENTION_DAYS=30

# Operations -> Notification Delivery control API.
NOTIFICATION_DELIVERY_OPERATIONS_TOKEN=change_me

RABBITMQ_URL=amqp://winwidget-notification-delivery:change_me@127.0.0.1:5672/winwidget
RABBITMQ_CONNECTION_NAME=winwidget-notification-delivery
RABBITMQ_ASSERT_TOPOLOGY=true
RABBITMQ_MAX_MESSAGE_BYTES=262144

SMTP_SERVER=127.0.0.1
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_LOGIN=change_me
SMTP_PASSWORD=change_me
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_GREETING_TIMEOUT_MS=5000
SMTP_SOCKET_TIMEOUT_MS=15000
# Historical shared name: Notification Delivery uses this only as the public
# site base URL for links in email templates, not for reCAPTCHA verification.
RECAPTCHA_CLIENT_URL=http://localhost:3000

TELEGRAM_INFO_BOT_TOKEN=change_me
TELEGRAM_API_BASE_URL=https://tg.winwidget.ru/telegram-api
TELEGRAM_API_PROXY_IP=185.184.122.62
