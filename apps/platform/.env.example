MODE=development
APP_REVISION=local

PLATFORM_PROCESS_ROLE=api
PLATFORM_API_PORT=5000
PLATFORM_OUTBOX_PUBLISHER_PORT=5001
PLATFORM_LISTEN_HOST=127.0.0.1
PLATFORM_DATABASE_URL=postgresql://winwidget_platform_runtime:change_me@127.0.0.1:55439/winwidget_platform?schema=platform&sslmode=disable
PLATFORM_MIGRATION_DATABASE_URL=postgresql://winwidget_platform_migration:change_me@127.0.0.1:55439/winwidget_platform?schema=platform&sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=loopback

# Operations -> Platform monitoring.
PLATFORM_OPERATIONS_TOKEN=change_me

# Platform -> Identity introspection.
IDENTITY_INTERNAL_BASE_URL=http://127.0.0.1:4900
IDENTITY_INTERNAL_TIMEOUT_MS=10000
IDENTITY_PLATFORM_TOKEN=change_me

PLATFORM_OUTBOX_BATCH_SIZE=50
PLATFORM_OUTBOX_POLL_INTERVAL_MS=1000
PLATFORM_OUTBOX_RETENTION_DAYS=7
RABBITMQ_URL=amqp://winwidget-platform-publisher:change_me@127.0.0.1:5672/winwidget
RABBITMQ_CONNECTION_NAME=winwidget-platform-outbox-publisher
RABBITMQ_ASSERT_TOPOLOGY=false
RABBITMQ_MAX_MESSAGE_BYTES=262144
