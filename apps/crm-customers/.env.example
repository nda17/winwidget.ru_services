NODE_ENV=development
MODE=development
APP_REVISION=local

CRM_CUSTOMERS_LISTEN_HOST=127.0.0.1
CRM_CUSTOMERS_PORT=5320
CRM_CUSTOMERS_DATABASE_URL=postgresql://winwidget_crm_customers_runtime:change_me@127.0.0.1:55444/winwidget_crm_customers?schema=crm_customers&sslmode=disable
CRM_CUSTOMERS_MIGRATION_DATABASE_URL=postgresql://winwidget_crm_customers_migration:change_me@127.0.0.1:55444/winwidget_crm_customers?schema=crm_customers&sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:3001

# Required pairwise authorization with crm-access; no default token.
CRM_ACCESS_INTERNAL_BASE_URL=http://127.0.0.1:5300
CRM_ACCESS_CRM_CUSTOMERS_TOKEN=change_me_at_least_32_random_characters
CRM_ACCESS_INTERNAL_TIMEOUT_MS=10000
# Scoped Intake workflow credentials; required only when these internal endpoints are used.
CRM_CUSTOMERS_CRM_INTAKE_TOKEN=change_me
CRM_CUSTOMERS_CRM_SALES_TOKEN=change_me
