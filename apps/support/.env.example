MODE=development
APP_REVISION=local

SUPPORT_PROCESS_ROLE=api
# Leave empty to use the role default: api=5100, worker=5101, outbox-publisher=5102.
SUPPORT_PORT=
SUPPORT_LISTEN_HOST=127.0.0.1
SUPPORT_DATABASE_URL=postgresql://winwidget_support_runtime:change_me@127.0.0.1:55440/winwidget_support?schema=support&sslmode=disable
SUPPORT_MIGRATION_DATABASE_URL=postgresql://winwidget_support_migration:change_me@127.0.0.1:55440/winwidget_support?schema=support&sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=loopback

# Operations -> Support monitoring.
SUPPORT_OPERATIONS_TOKEN=change_me

SUPPORT_WEBHOOK_PUBLIC_URL=https://tg.winwidget.ru/api/v1/telegram-bot/support-webhook
SUPPORT_INBOX_LEASE_MS=60000
SUPPORT_PREFETCH=10
SUPPORT_OUTBOX_BATCH_SIZE=50
SUPPORT_OUTBOX_POLL_INTERVAL_MS=1000
SUPPORT_OUTBOX_RETENTION_DAYS=7
SUPPORT_RECEIPT_RETENTION_DAYS=90
SUPPORT_FAILURE_DETAIL_RETENTION_DAYS=30

TELEGRAM_SUPPORT_BOT_TOKEN=change_me
TELEGRAM_SUPPORT_BOT_USERNAME=change_me
TELEGRAM_SUPPORT_BOT_WEBHOOK_SECRET=change_me
TELEGRAM_API_BASE_URL=https://tg.winwidget.ru/telegram-api
TELEGRAM_API_PROXY_IP=185.184.122.62

IDENTITY_INTERNAL_BASE_URL=http://127.0.0.1:4900
IDENTITY_INTERNAL_TIMEOUT_MS=10000
IDENTITY_SUPPORT_TOKEN=change_me

RABBITMQ_URL=amqp://winwidget-support:change_me@127.0.0.1:5672/winwidget
# Must equal winwidget-support-<SUPPORT_PROCESS_ROLE> for worker/publisher roles.
RABBITMQ_CONNECTION_NAME=winwidget-support-api
RABBITMQ_ASSERT_TOPOLOGY=false
RABBITMQ_MAX_MESSAGE_BYTES=262144

# CRM web support: additive activation; S3 and internal caller credentials go only to API.
SUPPORT_WEB_CHAT_ENABLED=false
SUPPORT_CRM_ACCESS_BASE_URL=http://127.0.0.1:5300
SUPPORT_CRM_ACCESS_TOKEN=change_me_support_crm_access_token
SUPPORT_NOTIFICATION_DELIVERY_TOKEN=change_me_support_notification_delivery_token
SUPPORT_S3_ENDPOINT=https://s3.twcstorage.ru
SUPPORT_S3_REGION=ru-1
SUPPORT_S3_BUCKET=change_me_private_support_bucket
SUPPORT_S3_FORCE_PATH_STYLE=true
SUPPORT_S3_ACCESS_KEY_ID=change_me_support_only_key
SUPPORT_S3_SECRET_ACCESS_KEY=change_me_support_only_secret
