MODE=development
APP_REVISION=local
OPERATIONS_PROCESS_ROLE=api
OPERATIONS_API_PORT=5200
OPERATIONS_WORKER_PORT=5201
OPERATIONS_OUTBOX_PUBLISHER_PORT=5202
OPERATIONS_RESTORE_WORKER_PORT=5203
OPERATIONS_LISTEN_HOST=127.0.0.1
OPERATIONS_DATABASE_URL=postgresql://winwidget_operations_runtime:change_me@127.0.0.1:55441/winwidget_operations?schema=operations&sslmode=disable
OPERATIONS_MIGRATION_DATABASE_URL=postgresql://winwidget_operations_migration:change_me@127.0.0.1:55441/winwidget_operations?schema=operations&sslmode=disable
OPERATIONS_BACKUP_URL=postgresql://winwidget_operations_backup:change_me@127.0.0.1:55441/winwidget_operations?schema=operations&sslmode=disable
OPERATIONS_OUTBOX_BATCH_SIZE=50
OPERATIONS_OUTBOX_POLL_INTERVAL_MS=1000
OPERATIONS_AUDIT_RECEIPT_LEASE_MS=60000
OPERATIONS_AUDIT_RETRY_DELAY_MS=30000
OPERATIONS_AUDIT_MAX_RETRY_ATTEMPTS=4

# Private service federation. Every URL must be an exact HTTP origin.
NOTIFICATION_DELIVERY_INTERNAL_URL=http://127.0.0.1:4401
NOTIFICATION_DELIVERY_OPERATIONS_TOKEN=change_me_notification_delivery_operations_token_32_chars
CAMPAIGNS_INTERNAL_BASE_URL=http://127.0.0.1:4500
CAMPAIGNS_OPERATIONS_TOKEN=change_me_campaigns_operations_token_at_least_32_chars
REPORTING_INTERNAL_BASE_URL=http://127.0.0.1:4600
REPORTING_OPERATIONS_TOKEN=change_me_reporting_operations_token_at_least_32_chars
WIDGETS_INTERNAL_BASE_URL=http://127.0.0.1:4700
WIDGETS_OPERATIONS_TOKEN=change_me_widgets_operations_token_at_least_32_chars
BILLING_INTERNAL_BASE_URL=http://127.0.0.1:4800
BILLING_OPERATIONS_TOKEN=change_me_billing_operations_token_at_least_32_chars
IDENTITY_INTERNAL_BASE_URL=http://127.0.0.1:4900
IDENTITY_INTERNAL_TIMEOUT_MS=10000
IDENTITY_OPERATIONS_TOKEN=change_me_identity_operations_token_at_least_32_chars
PLATFORM_INTERNAL_BASE_URL=http://127.0.0.1:5000
PLATFORM_OPERATIONS_TOKEN=change_me_platform_operations_token_at_least_32_chars
SUPPORT_INTERNAL_BASE_URL=http://127.0.0.1:5100
SUPPORT_OPERATIONS_TOKEN=change_me_support_operations_token_at_least_32_chars

# Inbound private contracts.
OPERATIONS_IDENTITY_TOKEN=change_me_operations_identity_token_at_least_32_chars
REPORTING_INTERNAL_TOKEN=change_me_reporting_internal_token_at_least_32_chars

CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=loopback
RABBITMQ_URL=amqp://winwidget-operations:change_me@127.0.0.1:5672/winwidget
# worker: winwidget-operations-worker; restore-worker: winwidget-operations-restore-worker; outbox-publisher: winwidget-operations-outbox-publisher
RABBITMQ_CONNECTION_NAME=winwidget-operations-worker
# worker/restore-worker: true; outbox-publisher: false
RABBITMQ_ASSERT_TOPOLOGY=true
RABBITMQ_MAX_MESSAGE_BYTES=262144
RABBITMQ_MANAGEMENT_URL=http://127.0.0.1:15672
RABBITMQ_VHOST=winwidget
RABBITMQ_MONITOR_USER=winwidget-monitor
RABBITMQ_MONITOR_PASSWORD=change_me

# Telegram transport. Production accepts only the established TLS proxy URL.
TELEGRAM_INFO_BOT_CONFIGURED=true
TELEGRAM_API_BASE_URL=https://tg.winwidget.ru/telegram-api
TELEGRAM_API_PROXY_IP=185.184.122.62
TELEGRAM_INFO_BOT_TOKEN=change_me_telegram_info_bot_token
TELEGRAM_INFO_BOT_USERNAME=winwidget_info_bot

# Read-only backup-role URLs used only by operations-worker/pg_dump.
NOTIFICATION_DELIVERY_BACKUP_URL=postgresql://winwidget_notification_delivery_backup:change_me@127.0.0.1:55432/winwidget_notification_delivery?schema=notification_delivery&sslmode=disable
CAMPAIGNS_BACKUP_URL=postgresql://winwidget_campaigns_backup:change_me@127.0.0.1:55433/winwidget_campaigns?schema=campaigns&sslmode=disable
REPORTING_BACKUP_URL=postgresql://winwidget_reporting_backup:change_me@127.0.0.1:55435/winwidget_reporting?schema=reporting&sslmode=disable
WIDGETS_BACKUP_URL=postgresql://winwidget_widgets_backup:change_me@127.0.0.1:55436/winwidget_widgets?schema=widgets&sslmode=disable
BILLING_BACKUP_URL=postgresql://winwidget_billing_backup:change_me@127.0.0.1:55437/winwidget_billing?schema=billing&sslmode=disable
IDENTITY_BACKUP_URL=postgresql://winwidget_identity_backup:change_me@127.0.0.1:55438/winwidget_identity?schema=identity&sslmode=disable
PLATFORM_BACKUP_URL=postgresql://winwidget_platform_backup:change_me@127.0.0.1:55439/winwidget_platform?schema=platform&sslmode=disable
SUPPORT_BACKUP_URL=postgresql://winwidget_support_backup:change_me@127.0.0.1:55440/winwidget_support?schema=support&sslmode=disable

# Restore is DEV-only. API and restore-worker share one persistent private mount.
# Inject every admin user/port/password-file entry below only into restore-worker.
DATABASE_RESTORE_ENABLED=false
DATABASE_RESTORE_STORAGE_DIR=/var/lib/winwidget-operations/restores
NOTIFICATION_DELIVERY_POSTGRES_ADMIN_USER=winwidget_notification_delivery_admin
NOTIFICATION_DELIVERY_POSTGRES_PORT=55432
DATABASE_RESTORE_NOTIFICATION_DELIVERY_ADMIN_PASSWORD_FILE=/run/secrets/database-restore-notification-delivery-admin-password
CAMPAIGNS_POSTGRES_ADMIN_USER=winwidget_campaigns_admin
CAMPAIGNS_POSTGRES_PORT=55433
DATABASE_RESTORE_CAMPAIGNS_ADMIN_PASSWORD_FILE=/run/secrets/database-restore-campaigns-admin-password
REPORTING_POSTGRES_ADMIN_USER=winwidget_reporting_admin
REPORTING_POSTGRES_PORT=55435
DATABASE_RESTORE_REPORTING_ADMIN_PASSWORD_FILE=/run/secrets/database-restore-reporting-admin-password
WIDGETS_POSTGRES_ADMIN_USER=winwidget_widgets_admin
WIDGETS_POSTGRES_PORT=55436
DATABASE_RESTORE_WIDGETS_ADMIN_PASSWORD_FILE=/run/secrets/database-restore-widgets-admin-password
IDENTITY_POSTGRES_ADMIN_USER=winwidget_identity_admin
IDENTITY_POSTGRES_PORT=55438
DATABASE_RESTORE_IDENTITY_ADMIN_PASSWORD_FILE=/run/secrets/database-restore-identity-admin-password
PLATFORM_POSTGRES_ADMIN_USER=winwidget_platform_admin
PLATFORM_POSTGRES_PORT=55439
DATABASE_RESTORE_PLATFORM_ADMIN_PASSWORD_FILE=/run/secrets/database-restore-platform-admin-password
SUPPORT_POSTGRES_ADMIN_USER=winwidget_support_admin
SUPPORT_POSTGRES_PORT=55440
DATABASE_RESTORE_SUPPORT_ADMIN_PASSWORD_FILE=/run/secrets/database-restore-support-admin-password
