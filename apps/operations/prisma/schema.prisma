generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/@prisma/operations-client"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("OPERATIONS_DATABASE_URL")
  schemas  = ["operations"]
}

model ServiceIdentity {
  id          String   @id @default("singleton")
  serviceName String   @default("operations-service") @map("service_name")
  databaseId  String   @unique(map: "service_identity_database_id_key") @default(uuid()) @map("database_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("service_identity")
  @@schema("operations")
}

model Note {
  id        String   @id @default(cuid())
  text      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notes")
  @@schema("operations")
}

model AdminEventLog {
  id              String   @id @default(cuid())
  adminId         String?  @map("admin_id")
  adminName       String?  @map("admin_name")
  adminEmail      String?  @map("admin_email")
  section         String
  action          String
  description     String
  entityType      String?  @map("entity_type")
  entityId        String?  @map("entity_id")
  entityLabel     String?  @map("entity_label")
  targetUserId    String?  @map("target_user_id")
  targetUserName  String?  @map("target_user_name")
  targetUserEmail String?  @map("target_user_email")
  metadata        Json     @default("{}")
  ip              String?
  userAgent       String?  @map("user_agent")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@index([targetUserId])
  @@index([section])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("admin_event_logs")
  @@schema("operations")
}

model AuditEventReceipt {
  id                String             @id @default(uuid()) @db.Uuid
  eventId           String             @map("event_id") @db.Uuid
  consumer          String
  status            AuditReceiptStatus @default(PROCESSING)
  attempt           Int                @default(1)
  leaseToken        String?            @map("lease_token") @db.Uuid
  leaseExpiresAt    DateTime?          @map("lease_expires_at")
  retryAvailableAt  DateTime?          @map("retry_available_at")
  deliveredAt       DateTime?          @map("delivered_at")
  deadLetteredAt    DateTime?          @map("dead_lettered_at")
  deadLetterSource  String?            @map("dead_letter_source")
  deadLetterPayload Json?              @map("dead_letter_payload")
  manualRetryCycle  Int                @default(0) @map("manual_retry_cycle")
  lastError         String?            @map("last_error") @db.Text
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@unique([eventId, consumer], name: "eventId_consumer", map: "audit_event_receipts_event_consumer_key")
  @@index([status, leaseExpiresAt], map: "audit_event_receipts_claim_idx")
  @@index([status, retryAvailableAt], map: "audit_event_receipts_retry_idx")
  @@index([deliveredAt], map: "audit_event_receipts_delivered_idx")
  @@map("audit_event_receipts")
  @@schema("operations")
}

model OutboxEvent {
  id               String       @id @default(cuid())
  eventId          String       @unique @map("event_id") @db.Uuid
  messageId        String?      @map("message_id") @db.Uuid
  deduplicationKey String?      @unique @map("deduplication_key")
  eventType        String       @map("event_type")
  aggregateType    String       @map("aggregate_type")
  aggregateId      String       @map("aggregate_id")
  correlationId    String?      @map("correlation_id") @db.Uuid
  exchange         String       @default("winwidget.events")
  routingKey       String       @map("routing_key")
  payload          Json
  headers          Json         @default("{}")
  status           OutboxStatus @default(PENDING)
  attempt          Int          @default(0)
  availableAt      DateTime     @default(now()) @map("available_at")
  leaseToken       String?      @map("lease_token") @db.Uuid
  leaseExpiresAt   DateTime?    @map("lease_expires_at")
  publishedAt      DateTime?    @map("published_at")
  lastError        String?      @map("last_error") @db.Text
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@index([status, availableAt, createdAt], map: "outbox_events_dispatch_idx")
  @@index([status, publishedAt, id], map: "outbox_events_retention_idx")
  @@map("outbox_events")
  @@schema("operations")
}

model TelegramBotSettings {
  id                                String    @id @default("singleton")
  dailySummaryChatId                String    @default("") @map("daily_summary_chat_id")
  databaseBackupThreadId            Int?      @map("database_backup_thread_id")
  paymentsThreadId                  Int?      @map("payments_thread_id")
  operationalAlertsThreadId         Int?      @map("operational_alerts_thread_id")
  databaseBackupEnabled             Boolean   @default(true) @map("database_backup_enabled")
  databaseBackupTime                String    @default("01:45") @map("database_backup_time")
  databaseBackupLastSentPeriodStart DateTime? @map("database_backup_last_sent_period_start")
  databaseBackupLastSentAt          DateTime? @map("database_backup_last_sent_at")
  updatedAt                         DateTime  @updatedAt @map("updated_at")

  @@map("telegram_bot_settings")
  @@schema("operations")
}

model ScheduledJobRun {
  id              String                       @id @default(uuid()) @db.Uuid
  jobType         String                       @map("job_type")
  scheduleKey     String                       @map("schedule_key")
  trigger         ScheduledJobRunTrigger       @default(SCHEDULED)
  status          ScheduledJobRunStatus        @default(QUEUED)
  scheduledFor    DateTime                     @map("scheduled_for")
  periodStart     DateTime?                    @map("period_start")
  periodEnd       DateTime?                    @map("period_end")
  input           Json                         @default("{}")
  checkpoint      Json                         @default("{}")
  result          Json?
  attempts        Int                          @default(0)
  maxAttempts     Int                          @default(4) @map("max_attempts")
  availableAt     DateTime                     @default(now()) @map("available_at")
  leaseOwner      String?                      @map("lease_owner")
  leaseToken      String?                      @map("lease_token") @db.Uuid
  leaseExpiresAt  DateTime?                    @map("lease_expires_at")
  startedAt       DateTime?                    @map("started_at")
  finishedAt      DateTime?                    @map("finished_at")
  lastError       String?                      @map("last_error") @db.Text
  createdAt       DateTime                     @default(now()) @map("created_at")
  updatedAt       DateTime                     @updatedAt @map("updated_at")
  idempotencyKeys ScheduledJobIdempotencyKey[]

  @@unique([jobType, scheduleKey], map: "scheduled_job_runs_type_schedule_key_unique")
  @@index([status, availableAt, createdAt], map: "scheduled_job_runs_dispatch_idx")
  @@index([status, leaseExpiresAt], map: "scheduled_job_runs_lease_idx")
  @@index([jobType, createdAt], map: "scheduled_job_runs_type_created_idx")
  @@map("scheduled_job_runs")
  @@schema("operations")
}

model ScheduledJobIdempotencyKey {
  adminId        String          @map("admin_id")
  jobType        String          @map("job_type")
  idempotencyKey String          @map("idempotency_key") @db.Uuid
  jobId          String          @map("job_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at")
  job            ScheduledJobRun @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@id([adminId, jobType, idempotencyKey], map: "scheduled_job_idempotency_keys_pkey")
  @@index([jobId], map: "scheduled_job_idempotency_keys_job_idx")
  @@map("scheduled_job_idempotency_keys")
  @@schema("operations")
}

model MessagingHeartbeat {
  id         String   @id @default(uuid()) @db.Uuid
  service    String
  instanceId String   @map("instance_id")
  metadata   Json     @default("{}")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([service, instanceId], map: "messaging_heartbeats_service_instance_unique")
  @@index([service, lastSeenAt], map: "messaging_heartbeats_service_seen_idx")
  @@index([lastSeenAt], map: "messaging_heartbeats_seen_idx")
  @@map("messaging_heartbeats")
  @@schema("operations")
}

model IntegrationDeliveryFailure {
  id                String                        @id @default(uuid()) @db.Uuid
  eventId           String                        @map("event_id") @db.Uuid
  integration       String
  eventType         String                        @map("event_type")
  routingKey        String                        @map("routing_key")
  payload           Json
  attempts          Int
  lastError         String                        @map("last_error") @db.Text
  category          IntegrationErrorCategory?
  normalizedCode    String?                       @map("normalized_code")
  safeReason        String?                       @map("safe_reason") @db.Text
  httpStatus        Int?                          @map("http_status")
  providerCode      String?                       @map("provider_code")
  retryable         Boolean?
  failedAt          DateTime                      @default(now()) @map("failed_at")
  retryingAt        DateTime?                     @map("retrying_at")
  activeRetryToken  String?                       @map("active_retry_token") @db.Uuid
  resolvedAt        DateTime?                     @map("resolved_at")
  resolution        IntegrationFailureResolution?
  resolutionComment String?                       @map("resolution_comment") @db.Text
  resolvedById      String?                       @map("resolved_by_id")
  createdAt         DateTime                      @default(now()) @map("created_at")
  updatedAt         DateTime                      @updatedAt @map("updated_at")

  @@unique([eventId, integration], map: "integration_delivery_failures_event_integration_unique")
  @@index([resolvedAt, failedAt], map: "integration_delivery_failures_status_idx")
  @@index([integration, resolvedAt], map: "integration_delivery_failures_integration_idx")
  @@index([category, resolvedAt, failedAt], map: "integration_delivery_failures_category_idx")
  @@map("integration_delivery_failures")
  @@schema("operations")
}

model IntegrationDeliveryReceipt {
  id               String                           @id @default(uuid()) @db.Uuid
  eventId          String                           @map("event_id") @db.Uuid
  integration      String
  status           IntegrationDeliveryReceiptStatus @default(PROCESSING)
  lockedAt         DateTime                         @default(now()) @map("locked_at")
  deliveredAt      DateTime?                        @map("delivered_at")
  retryAttempt     Int?                             @map("retry_attempt")
  retryAvailableAt DateTime?                        @map("retry_available_at")
  retryToken       String?                          @map("retry_token") @db.Uuid
  createdAt        DateTime                         @default(now()) @map("created_at")

  @@unique([eventId, integration], map: "integration_delivery_receipts_event_integration_unique")
  @@index([status, lockedAt], map: "integration_delivery_receipts_processing_idx")
  @@index([integration, deliveredAt], map: "integration_delivery_receipts_integration_delivered_idx")
  @@map("integration_delivery_receipts")
  @@schema("operations")
}

model OperationalAlert {
  id               String                   @id @default(uuid()) @db.Uuid
  deduplicationKey String                   @unique @map("deduplication_key")
  type             String
  severity         OperationalAlertSeverity
  source           String
  referenceId      String                   @map("reference_id")
  targetUserId     String?                  @map("target_user_id")
  targetUserName   String?                  @map("target_user_name")
  targetUserEmail  String?                  @map("target_user_email")
  title            String
  message          String
  alertAt          DateTime                 @map("alert_at")
  resolvedAt       DateTime?                @map("resolved_at")
  metadata         Json                     @default("{}")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  @@index([resolvedAt, severity, alertAt], map: "operational_alerts_active_idx")
  @@index([source, resolvedAt], map: "operational_alerts_source_idx")
  @@map("operational_alerts")
  @@schema("operations")
}

model ReportingSchedulePolicy {
  id                    String   @id @default("singleton")
  reservationTime       String   @default("01:50") @map("reservation_time")
  reservationGeneration BigInt   @default(0) @map("reservation_generation")
  confirmedChangeId     String?  @map("confirmed_change_id") @db.Uuid
  pendingChangeId       String?  @map("pending_change_id") @db.Uuid
  pendingTime           String?  @map("pending_time")
  pendingGeneration     BigInt?  @map("pending_generation")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("reporting_schedule_policy")
  @@schema("operations")
}

model DatabaseRestoreJob {
  id                   String                          @id @default(uuid()) @db.Uuid
  target               String
  status               DatabaseRestoreJobStatus        @default(QUEUED)
  phase                DatabaseRestoreJobPhase?
  sourceFileName       String                          @map("source_file_name")
  sourceSha256         String                          @map("source_sha256")
  sourceSize           BigInt                          @map("source_size")
  requestedById        String                          @map("requested_by_id")
  idempotencyKey       String                          @map("idempotency_key") @db.Uuid
  eventId              String                          @unique(map: "database_restore_jobs_event_id_unique") @map("event_id") @db.Uuid
  permitId             String                          @unique(map: "database_restore_jobs_permit_id_unique") @map("permit_id") @db.Uuid
  expectedServicesSha  String                          @map("expected_services_sha")
  migrationManifestSha String                          @map("migration_manifest_sha")
  leaseOwner           String?                         @map("lease_owner")
  leaseToken           String?                         @map("lease_token") @db.Uuid
  leaseExpiresAt       DateTime?                       @map("lease_expires_at")
  attempts             Int                             @default(0)
  safetyBackupFileName String?                         @map("safety_backup_file_name")
  safetyBackupSha256   String?                         @map("safety_backup_sha256")
  sourceDeletedAt      DateTime?                       @map("source_deleted_at")
  safetyDeletedAt      DateTime?                       @map("safety_deleted_at")
  cleanupError         String?                         @map("cleanup_error") @db.Text
  recoveryResolvedAt   DateTime?                       @map("recovery_resolved_at")
  artifactRetainUntil  DateTime?                       @map("artifact_retain_until")
  writerFenceRoles     Json?                           @map("writer_fence_roles")
  writerFenceRequestedAt DateTime?                     @map("writer_fence_requested_at")
  writerFenceAppliedAt DateTime?                       @map("writer_fence_applied_at")
  writerFenceReleasedAt DateTime?                      @map("writer_fence_released_at")
  writerFenceEvidenceSha256 String?                    @map("writer_fence_evidence_sha256")
  writerFenceReleaseEvidenceSha256 String?             @map("writer_fence_release_evidence_sha256")
  result               Json?
  lastError            String?                         @map("last_error") @db.Text
  startedAt            DateTime?                       @map("started_at")
  finishedAt           DateTime?                       @map("finished_at")
  createdAt            DateTime                        @default(now()) @map("created_at")
  updatedAt            DateTime                        @updatedAt @map("updated_at")
  permit               DatabaseRestorePermit           @relation(fields: [permitId, id, target, sourceSha256, expectedServicesSha, migrationManifestSha], references: [id, jobId, target, sourceSha256, expectedServicesSha, migrationManifestSha], onDelete: Restrict, onUpdate: Restrict, map: "database_restore_jobs_permit_fkey")
  terminalReceipt      DatabaseRestoreTerminalReceipt?
  recoveryActions      DatabaseRestoreRecoveryAction[]
  recoveryResolutionReceipt DatabaseRestoreRecoveryReceipt?
  releaseAuthorizations DatabaseRestoreReleaseAuthorization[]

  @@unique([requestedById, idempotencyKey], map: "database_restore_jobs_actor_idempotency_key")
  @@unique([permitId, id, target, sourceSha256, expectedServicesSha, migrationManifestSha], map: "database_restore_jobs_exact_permit_binding_unique")
  @@index([status, createdAt], map: "database_restore_jobs_dispatch_idx")
  @@map("database_restore_jobs")
  @@schema("operations")
}

model DatabaseRestorePermit {
  id                   String                      @id @default(uuid()) @db.Uuid
  jobId                String                      @unique(map: "database_restore_permits_job_id_unique") @map("job_id") @db.Uuid
  target               String
  sourceSha256         String                      @map("source_sha256")
  expectedServicesSha  String                      @map("expected_services_sha")
  migrationManifestSha String                      @map("migration_manifest_sha")
  status               DatabaseRestorePermitStatus @default(PENDING_APPROVAL)
  requestedById        String                      @map("requested_by_id")
  approvedById         String?                     @map("approved_by_id")
  approvedAt           DateTime?                   @map("approved_at")
  expiresAt            DateTime                    @map("expires_at")
  consumedAt           DateTime?                   @map("consumed_at")
  closedAt             DateTime?                   @map("closed_at")
  closeReason          String?                     @map("close_reason")
  createdAt            DateTime                    @default(now()) @map("created_at")
  updatedAt            DateTime                    @updatedAt @map("updated_at")
  restoreJob           DatabaseRestoreJob?
  releaseAuthorization DatabaseRestoreReleaseAuthorization?

  @@unique([id, jobId, target, sourceSha256, expectedServicesSha, migrationManifestSha], map: "database_restore_permits_exact_binding_unique")
  @@index([status, expiresAt], map: "database_restore_permits_status_expiry_idx")
  @@map("database_restore_permits")
  @@schema("operations")
}

model DatabaseRestoreTerminalReceipt {
  id                   String                   @id @default(uuid()) @db.Uuid
  jobId                String                   @unique(map: "database_restore_terminal_receipts_job_id_unique") @map("job_id") @db.Uuid
  permitId             String                   @map("permit_id") @db.Uuid
  permitRequestedById  String                   @map("permit_requested_by_id")
  permitApprovedById   String                   @map("permit_approved_by_id")
  permitCreatedAt      DateTime                 @map("permit_created_at")
  permitApprovedAt     DateTime                 @map("permit_approved_at")
  permitExpiresAt      DateTime                 @map("permit_expires_at")
  permitConsumedAt     DateTime                 @map("permit_consumed_at")
  target               String
  terminalStatus       DatabaseRestoreJobStatus @map("terminal_status")
  phase                DatabaseRestoreJobPhase?
  sourceSha256         String                   @map("source_sha256")
  safetyBackupSha256   String?                  @map("safety_backup_sha256")
  expectedServicesSha  String                   @map("expected_services_sha")
  migrationManifestSha String                   @map("migration_manifest_sha")
  resultSha256         String?                  @map("result_sha256")
  errorSha256          String?                  @map("error_sha256")
  payloadSha256        String                   @map("payload_sha256")
  signatureHmacSha256  String                   @map("signature_hmac_sha256")
  signatureKeyId       String                   @map("signature_key_id")
  writerFenceRoles     Json?                    @map("writer_fence_roles")
  writerFenceRequestedAt DateTime?              @map("writer_fence_requested_at")
  writerFenceAppliedAt DateTime?                @map("writer_fence_applied_at")
  writerFenceReleasedAt DateTime?               @map("writer_fence_released_at")
  writerFenceEvidenceSha256 String?              @map("writer_fence_evidence_sha256")
  writerFenceReleaseEvidenceSha256 String?       @map("writer_fence_release_evidence_sha256")
  releaseAuthorizationPayloadSha256 String?      @map("release_authorization_payload_sha256")
  completedAt          DateTime                 @map("completed_at")
  createdAt            DateTime                 @default(now()) @map("created_at")
  restoreJob           DatabaseRestoreJob       @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "database_restore_terminal_receipts_job_fkey")

  @@map("database_restore_terminal_receipts")
  @@schema("operations")
}

model DatabaseRestoreRecoveryAction {
  id                String                              @id @default(uuid()) @db.Uuid
  jobId             String                              @map("job_id") @db.Uuid
  action            DatabaseRestoreRecoveryActionType
  status            DatabaseRestoreRecoveryActionStatus @default(PENDING_APPROVAL)
  phase             DatabaseRestoreRecoveryActionPhase?
  eventId           String?                             @unique(map: "database_restore_recovery_actions_event_id_unique") @map("event_id") @db.Uuid
  receiptPayloadSha String                              @map("receipt_payload_sha")
  requestedById     String                              @map("requested_by_id")
  approvedById      String?                             @map("approved_by_id")
  approvedAt        DateTime?                           @map("approved_at")
  expiresAt         DateTime                            @map("expires_at")
  leaseOwner        String?                             @map("lease_owner")
  leaseToken        String?                             @map("lease_token") @db.Uuid
  leaseExpiresAt    DateTime?                           @map("lease_expires_at")
  attempts          Int                                 @default(0)
  artifactSha256    String?                             @map("artifact_sha256")
  writerFenceRoles  Json?                               @map("writer_fence_roles")
  writerFenceRequestedAt DateTime?                      @map("writer_fence_requested_at")
  writerFenceAppliedAt DateTime?                        @map("writer_fence_applied_at")
  writerFenceReleasedAt DateTime?                       @map("writer_fence_released_at")
  writerFenceEvidenceSha256 String?                     @map("writer_fence_evidence_sha256")
  writerFenceReleaseEvidenceSha256 String?              @map("writer_fence_release_evidence_sha256")
  result            Json?
  lastError         String?                             @map("last_error") @db.Text
  startedAt         DateTime?                           @map("started_at")
  finishedAt        DateTime?                           @map("finished_at")
  createdAt         DateTime                            @default(now()) @map("created_at")
  updatedAt         DateTime                            @updatedAt @map("updated_at")
  restoreJob        DatabaseRestoreJob                  @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "database_restore_recovery_actions_job_fkey")
  resolutionReceipt DatabaseRestoreRecoveryReceipt?
  releaseAuthorization DatabaseRestoreReleaseAuthorization?

  @@index([jobId, status], map: "database_restore_recovery_actions_job_status_idx")
  @@index([status, expiresAt], map: "database_restore_recovery_actions_status_expiry_idx")
  @@map("database_restore_recovery_actions")
  @@schema("operations")
}

model DatabaseRestoreExecutionLease {
  id             String                                @id @default("singleton")
  operationType  DatabaseRestoreExecutionOperationType? @map("operation_type")
  operationId    String?                               @map("operation_id") @db.Uuid
  leaseOwner     String?                               @map("lease_owner")
  leaseToken     String?                               @map("lease_token") @db.Uuid
  leaseExpiresAt DateTime?                             @map("lease_expires_at")
  updatedAt      DateTime                              @updatedAt @map("updated_at")

  @@map("database_restore_execution_lease")
  @@schema("operations")
}

model DatabaseRestoreReleaseAuthorization {
  id                           String                                @id @default(uuid()) @db.Uuid
  operationType                DatabaseRestoreExecutionOperationType @map("operation_type")
  operationId                  String                                @map("operation_id") @db.Uuid
  jobId                        String                                @map("job_id") @db.Uuid
  actionId                     String?                               @unique(map: "database_restore_release_authorizations_action_id_unique") @map("action_id") @db.Uuid
  permitId                     String?                               @unique(map: "database_restore_release_authorizations_permit_id_unique") @map("permit_id") @db.Uuid
  eventId                      String                                @map("event_id") @db.Uuid
  target                       String
  recoveryAction               DatabaseRestoreRecoveryActionType?    @map("recovery_action")
  initialReceiptPayloadSha256  String?                               @map("initial_receipt_payload_sha256")
  sourceSha256                 String                                @map("source_sha256")
  artifactSha256               String?                               @map("artifact_sha256")
  expectedServicesSha          String                                @map("expected_services_sha")
  migrationManifestSha         String                                @map("migration_manifest_sha")
  requestedById                String                                @map("requested_by_id")
  approvedById                 String                                @map("approved_by_id")
  approvedAt                   DateTime                              @map("approved_at")
  approvalEvidenceSha256       String                                @map("approval_evidence_sha256")
  writerFenceRoles             Json                                  @map("writer_fence_roles")
  writerFenceAppliedAt         DateTime                              @map("writer_fence_applied_at")
  writerFenceEvidenceSha256    String                                @map("writer_fence_evidence_sha256")
  verifiedAt                   DateTime                              @map("verified_at")
  migrationLedgerSha256        String                                @map("migration_ledger_sha256")
  aclEvidenceSha256            String                                @map("acl_evidence_sha256")
  verifiedWriterFenceSha256    String                                @map("verified_writer_fence_sha256")
  payloadSha256                String                                @map("payload_sha256")
  signatureHmacSha256          String                                @map("signature_hmac_sha256")
  signatureKeyId               String                                @map("signature_key_id")
  authorizedAt                 DateTime                              @map("authorized_at")
  createdAt                    DateTime                              @default(now()) @map("created_at")
  restoreJob                   DatabaseRestoreJob                    @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "database_restore_release_authorizations_job_fkey")
  recoveryActionRecord         DatabaseRestoreRecoveryAction?        @relation(fields: [actionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "database_restore_release_authorizations_action_fkey")
  permit                       DatabaseRestorePermit?                 @relation(fields: [permitId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "database_restore_release_authorizations_permit_fkey")

  @@unique([operationType, operationId], map: "database_restore_release_authorizations_operation_unique")
  @@map("database_restore_release_authorizations")
  @@schema("operations")
}

model DatabaseRestoreRecoveryReceipt {
  id                    String                            @id @default(uuid()) @db.Uuid
  jobId                 String                            @unique(map: "database_restore_recovery_receipts_job_id_unique") @map("job_id") @db.Uuid
  actionId              String                            @unique(map: "database_restore_recovery_receipts_action_id_unique") @map("action_id") @db.Uuid
  target                String
  action                DatabaseRestoreRecoveryActionType
  initialReceiptPayloadSha String                         @map("initial_receipt_payload_sha")
  artifactSha256        String?                           @map("artifact_sha256")
  expectedServicesSha   String                            @map("expected_services_sha")
  migrationManifestSha  String                            @map("migration_manifest_sha")
  writerFenceRoles      Json                              @map("writer_fence_roles")
  writerFenceAppliedAt  DateTime                          @map("writer_fence_applied_at")
  writerFenceReleasedAt DateTime                          @map("writer_fence_released_at")
  writerFenceEvidenceSha256 String                        @map("writer_fence_evidence_sha256")
  writerFenceReleaseEvidenceSha256 String                 @map("writer_fence_release_evidence_sha256")
  releaseAuthorizationPayloadSha256 String                @map("release_authorization_payload_sha256")
  resultSha256          String                            @map("result_sha256")
  payloadSha256         String                            @map("payload_sha256")
  signatureHmacSha256   String                            @map("signature_hmac_sha256")
  signatureKeyId        String                            @map("signature_key_id")
  resolvedAt            DateTime                          @map("resolved_at")
  createdAt             DateTime                          @default(now()) @map("created_at")
  restoreJob            DatabaseRestoreJob                @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "database_restore_recovery_receipts_job_fkey")
  recoveryAction        DatabaseRestoreRecoveryAction     @relation(fields: [actionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "database_restore_recovery_receipts_action_fkey")

  @@map("database_restore_recovery_receipts")
  @@schema("operations")
}

enum AuditReceiptStatus {
  PROCESSING
  RETRY_SCHEDULED
  DELIVERED
  DEAD_LETTERED

  @@schema("operations")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED

  @@schema("operations")
}

enum ScheduledJobRunStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  SKIPPED

  @@schema("operations")
}

enum ScheduledJobRunTrigger {
  SCHEDULED
  MANUAL

  @@schema("operations")
}

enum IntegrationDeliveryReceiptStatus {
  PROCESSING
  RETRY_SCHEDULED
  DELIVERED
  DEAD_LETTERED
  CLOSED_NO_RETRY

  @@schema("operations")
}

enum IntegrationErrorCategory {
  TRANSIENT
  RATE_LIMIT
  PERMANENT
  AUTH_CONFIGURATION

  @@schema("operations")
}

enum IntegrationFailureResolution {
  DELIVERED
  CLOSED_NO_RETRY

  @@schema("operations")
}

enum OperationalAlertSeverity {
  HIGH
  MEDIUM
  LOW

  @@schema("operations")
}

enum DatabaseRestoreJobStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  RECOVERY_REQUIRED
  CANCELLED

  @@schema("operations")
}

enum DatabaseRestoreJobPhase {
  PREPARING
  FENCING
  FENCED
  SAFETY_READY
  MUTATING
  VERIFIED
  UNFENCING
  UNFENCED

  @@schema("operations")
}

enum DatabaseRestorePermitStatus {
  PENDING_APPROVAL
  APPROVED
  CONSUMED
  CLOSED

  @@schema("operations")
}

enum DatabaseRestoreRecoveryActionType {
  VERIFY_AS_IS
  ROLL_BACK_SAFETY
  ROLL_FORWARD_SOURCE

  @@schema("operations")
}

enum DatabaseRestoreRecoveryActionStatus {
  PENDING_APPROVAL
  APPROVED
  PROCESSING
  RESOLVED
  BLOCKED
  EXPIRED

  @@schema("operations")
}

enum DatabaseRestoreRecoveryActionPhase {
  PREPARING
  FENCING
  FENCED
  MUTATING
  VERIFYING
  VERIFIED
  UNFENCING
  RESOLVED

  @@schema("operations")
}

enum DatabaseRestoreExecutionOperationType {
  RESTORE
  RECOVERY
  RECONCILIATION

  @@schema("operations")
}
