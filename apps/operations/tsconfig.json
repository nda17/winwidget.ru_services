{
	"compilerOptions": {
		"target": "ES2022",
		"module": "commonjs",
		"moduleResolution": "node",
		"rootDir": ".",
		"outDir": "dist",
		"declaration": true,
		"sourceMap": true,
		"removeComments": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["node", "jest", "express"]
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
