{
	"name": "@winwidget/crm-sales",
	"version": "1.0.0",
	"private": true,
	"description": "WinCRM sales pipeline microservice",
	"license": "UNLICENSED",
	"packageManager": "pnpm@9.15.9",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/src/main.js",
		"lint": "eslint \"src/**/*.ts\" --max-warnings=0",
		"test": "jest --runInBand",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"prisma:generate": "prisma generate --schema prisma/schema.prisma",
		"prisma:validate": "prisma validate --schema prisma/schema.prisma",
		"prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma"
	},
	"dependencies": {
		"@nestjs/common": "11.1.18",
		"@nestjs/config": "4.0.4",
		"@nestjs/core": "11.1.18",
		"@nestjs/platform-express": "11.1.18",
		"@prisma/client": "5.22.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1",
		"express": "5.2.1",
		"prisma": "5.22.0",
		"reflect-metadata": "^0.1.14",
		"rxjs": "^7.8.1"
	},
	"devDependencies": {
		"@nestjs/testing": "11.1.18",
		"@types/express": "5.0.6",
		"@types/jest": "^29.5.14",
		"@types/node": "^20.17.12",
		"@typescript-eslint/eslint-plugin": "^6.21.0",
		"@typescript-eslint/parser": "^6.21.0",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-prettier": "5.5.4",
		"jest": "^29.7.0",
		"prettier": "3.8.1",
		"ts-jest": "^29.2.5",
		"typescript": "^5.7.3"
	},
	"pnpm": {
		"overrides": {
			"@nestjs/config>lodash": "4.18.1",
			"@nestjs/platform-express>multer": "2.2.0",
			"body-parser": "2.3.0",
			"electron-to-chromium": "1.5.413"
		}
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": ".",
		"testRegex": "src/.*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": [
				"ts-jest",
				{
					"tsconfig": "tsconfig.json"
				}
			]
		},
		"testEnvironment": "node"
	}
}
