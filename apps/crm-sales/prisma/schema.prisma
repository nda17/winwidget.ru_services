generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/@prisma/crm-sales-client"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("CRM_SALES_DATABASE_URL")
  schemas  = ["crm_sales"]
}

model ExportAudit {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  actorSubject String @map("actor_subject") @db.VarChar(256)
  entity String @db.VarChar(16)
  format String @db.VarChar(4)
  rowCount Int @map("row_count")
  byteCount Int @map("byte_count")
  snapshotAt DateTime @map("snapshot_at")
  preparedAt DateTime @default(now()) @map("prepared_at")

  @@index([workspaceId, preparedAt, id], map: "export_audit_workspace_prepared_idx")
  @@map("export_audit")
  @@schema("crm_sales")
}

model ServiceIdentity {
  id          String   @id @default("singleton")
  serviceName String   @default("crm-sales-service") @map("service_name")
  databaseId  String   @unique(map: "service_identity_database_id_key") @default(uuid()) @map("database_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("service_identity")
  @@schema("crm_sales")
}

model Pipeline {
  id                  String                        @id @default(uuid()) @db.Uuid
  workspaceId         String                        @map("workspace_id") @db.Uuid
  name                String                        @db.VarChar(200)
  templateKey         String                        @map("template_key") @db.VarChar(64)
  templateVersion     Int                           @map("template_version") @db.SmallInt
  templateFingerprint String                        @map("template_fingerprint") @db.Char(64)
  installedBySubject  String                        @map("installed_by_subject") @db.VarChar(256)
  createdAt           DateTime                      @default(now()) @map("created_at")
  updatedAt           DateTime                      @updatedAt @map("updated_at")
  stages              PipelineStage[]
  installation        PipelineTemplateInstallation?
  deals               Deal[]

  @@unique([id, workspaceId])
  @@index([workspaceId, createdAt])
  @@map("pipelines")
  @@schema("crm_sales")
}

model PipelineStage {
  id          String                @id @default(uuid()) @db.Uuid
  pipelineId  String                @map("pipeline_id") @db.Uuid
  workspaceId String                @map("workspace_id") @db.Uuid
  key         String                @db.VarChar(64)
  name        String                @db.VarChar(200)
  position    Int                   @db.SmallInt
  state       CrmPipelineStageState
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  pipeline    Pipeline              @relation(fields: [pipelineId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  deals       Deal[]

  @@unique([pipelineId, key])
  @@unique([pipelineId, position])
  @@unique([id, pipelineId, workspaceId])
  @@map("pipeline_stages")
  @@schema("crm_sales")
}

model PipelineTemplateInstallation {
  id                  String                                @id @default(uuid()) @db.Uuid
  initialCommandId    String                                @unique @map("initial_command_id") @db.Uuid
  workspaceId         String                                @unique @map("workspace_id") @db.Uuid
  pipelineId          String                                @unique @map("pipeline_id") @db.Uuid
  templateKey         String                                @map("template_key") @db.VarChar(64)
  templateVersion     Int                                   @map("template_version") @db.SmallInt
  templateFingerprint String                                @map("template_fingerprint") @db.Char(64)
  installedBySubject  String                                @map("installed_by_subject") @db.VarChar(256)
  createdAt           DateTime                              @default(now()) @map("created_at")
  pipeline            Pipeline                              @relation(fields: [pipelineId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  commands            PipelineTemplateInstallationCommand[]

  @@unique([pipelineId, workspaceId])
  @@map("pipeline_template_installations")
  @@schema("crm_sales")
}

model PipelineTemplateInstallationCommand {
  commandId          String                       @id @map("command_id") @db.Uuid
  installationId     String                       @map("installation_id") @db.Uuid
  requestHash        String                       @map("request_hash") @db.Char(64)
  requestHashVersion Int                          @default(1) @map("request_hash_version") @db.SmallInt
  requestedBySubject String                       @map("requested_by_subject") @db.VarChar(256)
  createdAt          DateTime                     @default(now()) @map("created_at")
  installation       PipelineTemplateInstallation @relation(fields: [installationId], references: [id], onDelete: Restrict)

  @@index([installationId, createdAt])
  @@map("pipeline_template_installation_commands")
  @@schema("crm_sales")
}

enum CrmPipelineStageState {
  OPEN
  WON
  LOST

  @@schema("crm_sales")
}

model Deal {
  id                String                @id @default(uuid()) @db.Uuid
  workspaceId       String                @map("workspace_id") @db.Uuid
  version           Int                   @default(1)
  title             String                @db.VarChar(200)
  currency          String                @default("RUB") @db.Char(3)
  amountMinor       Int                   @map("amount_minor")
  pipelineId        String                @map("pipeline_id") @db.Uuid
  stageId           String                @map("stage_id") @db.Uuid
  status            CrmPipelineStageState @default(OPEN)
  contactId         String                @map("contact_id") @db.Uuid
  contactName       String                @map("contact_name") @db.VarChar(200)
  assignedToSubject String                @map("assigned_to_subject") @db.VarChar(256)
  teamId            String?               @map("team_id") @db.Uuid
  nextTaskId        String?               @map("next_task_id") @db.Uuid
  archivedAt        DateTime?             @map("archived_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  pipeline          Pipeline              @relation(fields: [pipelineId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  stage             PipelineStage         @relation(fields: [stageId, pipelineId, workspaceId], references: [id, pipelineId, workspaceId], onDelete: Restrict)
  tasks             SalesTask[]           @relation("DealTasks")
  nextAction        SalesTask?            @relation("DealNextTask", fields: [nextTaskId, id, workspaceId], references: [id, dealId, workspaceId], onDelete: NoAction, onUpdate: NoAction, map: "deals_next_task_fkey")
  timeline          DealTimeline[]
  intakeOperations  IntakeOperationSlot[] @relation("IntakeDeal")
  taskSeries        TaskSeries[]

  @@unique([id, workspaceId])
  @@unique([id, workspaceId, contactId])
  @@index([workspaceId, archivedAt, createdAt])
  @@index([workspaceId, assignedToSubject, createdAt])
  @@index([workspaceId, teamId, createdAt])
  @@map("deals")
  @@schema("crm_sales")
}

model SalesTask {
  id                String                @id @default(uuid()) @db.Uuid
  workspaceId       String                @map("workspace_id") @db.Uuid
  dealId            String?               @map("deal_id") @db.Uuid
  version           Int                   @default(1)
  title             String                @db.VarChar(200)
  dueAt             DateTime              @map("due_at")
  status            SalesTaskStatus       @default(OPEN)
  assignedToSubject String                @map("assigned_to_subject") @db.VarChar(256)
  completedAt       DateTime?             @map("completed_at")
  assignedToMembershipId String?          @map("assigned_to_membership_id") @db.Uuid
  assignmentVersion Int?                 @map("assignment_version")
  assignmentAt      DateTime?             @map("assignment_at")
  teamId            String?               @map("team_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  deal              Deal?                 @relation("DealTasks", fields: [dealId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  selectedFor       Deal[]                @relation("DealNextTask")
  intakeOperations  IntakeOperationSlot[] @relation("IntakeFirstTask")
  commands          TaskCommandReceipt[]
  timeline          TaskTimeline[]
  recurrence        TaskSeriesOccurrence?

  @@unique([id, workspaceId])
  @@unique([id, dealId, workspaceId])
  @@index([workspaceId, status, dueAt])
  @@index([workspaceId, teamId, status, dueAt, id], map: "tasks_team_workday_idx")
  @@index([workspaceId, assignedToSubject, status, dueAt, id], map: "tasks_assignee_workday_idx")
  @@map("tasks")
  @@schema("crm_sales")
}

model TaskSeries {
  id                     String @id @db.Uuid
  workspaceId            String @map("workspace_id") @db.Uuid
  version                Int @default(1)
  creatorSubject         String @map("creator_subject") @db.VarChar(256)
  creatorMembershipId    String? @map("creator_membership_id") @db.Uuid
  title                  String @db.VarChar(200)
  dealId                 String? @map("deal_id") @db.Uuid
  teamId                 String? @map("team_id") @db.Uuid
  assignedToSubject      String @map("assigned_to_subject") @db.VarChar(256)
  assignedToMembershipId String? @map("assigned_to_membership_id") @db.Uuid
  frequency              String @db.VarChar(8)
  startDate              String @map("start_date") @db.Char(10)
  localTime              String @map("local_time") @db.Char(5)
  timeZone               String @map("time_zone") @db.VarChar(100)
  status                 String @default("ACTIVE") @db.VarChar(16)
  nextIndex              Int @default(0) @map("next_index")
  nextRunAt              DateTime @map("next_run_at")
  nextCheckAt            DateTime @default(now()) @map("next_check_at")
  blockedReason          String? @map("blocked_reason") @db.VarChar(32)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  commands               TaskSeriesCommand[]
  occurrences            TaskSeriesOccurrence[]
  deal                   Deal? @relation(fields: [dealId, workspaceId], references: [id, workspaceId], onDelete: Restrict, map: "task_series_deal_fkey")

  @@unique([id, workspaceId])
  @@index([workspaceId, status, createdAt, id], map: "task_series_list_idx")
  @@index([status, nextRunAt, nextCheckAt, id], map: "task_series_schedule_idx")
  @@map("task_series")
  @@schema("crm_sales")
}

model TaskSeriesCommand {
  commandId    String @id @map("command_id") @db.Uuid
  workspaceId  String @map("workspace_id") @db.Uuid
  actorSubject String @map("actor_subject") @db.VarChar(256)
  requestHash  String @map("request_hash") @db.Char(64)
  seriesId     String @map("series_id") @db.Uuid
  before       Json?
  result       Json
  createdAt    DateTime @default(now()) @map("created_at")
  series       TaskSeries @relation(fields: [seriesId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@index([workspaceId, seriesId, createdAt], map: "task_series_commands_history_idx")
  @@map("task_series_commands")
  @@schema("crm_sales")
}

model TaskSeriesOccurrence {
  id           String @id @db.Uuid
  workspaceId  String @map("workspace_id") @db.Uuid
  seriesId     String @map("series_id") @db.Uuid
  periodIndex  Int @map("period_index")
  seriesVersion Int @map("series_version")
  taskId       String @unique @map("task_id") @db.Uuid
  dueAt        DateTime @map("due_at")
  createdAt    DateTime @default(now()) @map("created_at")
  series       TaskSeries @relation(fields: [seriesId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  task         SalesTask @relation(fields: [taskId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([seriesId, periodIndex], map: "task_series_period_key")
  @@unique([taskId, workspaceId])
  @@map("task_series_occurrences")
  @@schema("crm_sales")
}

model TaskNotification {
  id                    String @id @db.Uuid
  workspaceId           String @map("workspace_id") @db.Uuid
  taskId                String @map("task_id") @db.Uuid
  recipientSubject      String @map("recipient_subject") @db.VarChar(256)
  recipientMembershipId String? @map("recipient_membership_id") @db.Uuid
  assignmentVersion     Int @map("assignment_version")
  kind                  String @db.VarChar(16)
  availableAt           DateTime @map("available_at")
  readAt                DateTime? @map("read_at")
  cancelledAt           DateTime? @map("cancelled_at")
  createdAt             DateTime @default(now()) @map("created_at")

  @@unique([taskId, assignmentVersion, kind], map: "task_notifications_occurrence_key")
  @@index([workspaceId, recipientSubject, availableAt, id], map: "task_notifications_recipient_idx")
  @@map("task_notifications")
  @@schema("crm_sales")
}

model TaskCommandReceipt {
  commandId    String   @id @map("command_id") @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  actorSubject String   @map("actor_subject") @db.VarChar(256)
  commandType  String   @map("command_type") @db.VarChar(32)
  requestHash  String   @map("request_hash") @db.Char(64)
  taskId       String   @map("task_id") @db.Uuid
  result       Json
  createdAt    DateTime @default(now()) @map("created_at")
  task         SalesTask @relation(fields: [taskId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@map("task_command_receipts")
  @@schema("crm_sales")
}

model TaskTimeline {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  taskId       String   @map("task_id") @db.Uuid
  commandId    String   @unique @map("command_id") @db.Uuid
  actorSubject String   @map("actor_subject") @db.VarChar(256)
  kind         String   @db.VarChar(32)
  before       Json?
  after        Json
  createdAt    DateTime @default(now()) @map("created_at")
  task         SalesTask @relation(fields: [taskId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@index([workspaceId, taskId, createdAt, id])
  @@map("task_timeline")
  @@schema("crm_sales")
}

model ReminderRule {
  id                String @id @db.Uuid
  workspaceId       String @map("workspace_id") @db.Uuid
  scope             String @db.VarChar(16)
  ownerSubject      String @map("owner_subject") @db.VarChar(256)
  ownerMembershipId String? @map("owner_membership_id") @db.Uuid
  version           Int @default(1)
  configuration     Json
  archivedAt        DateTime? @map("archived_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  commands          ReminderRuleCommand[]

  @@unique([id, workspaceId])
  @@index([workspaceId, scope, ownerSubject, ownerMembershipId, archivedAt, createdAt, id], map: "reminder_rules_list_idx")
  @@map("reminder_rules")
  @@schema("crm_sales")
}

model ReminderRuleCommand {
  commandId         String @id @map("command_id") @db.Uuid
  workspaceId       String @map("workspace_id") @db.Uuid
  actorSubject      String @map("actor_subject") @db.VarChar(256)
  actorMembershipId String? @map("actor_membership_id") @db.Uuid
  commandType       String @map("command_type") @db.VarChar(16)
  requestHash       String @map("request_hash") @db.Char(64)
  ruleId            String @map("rule_id") @db.Uuid
  before            Json?
  result            Json
  createdAt         DateTime @default(now()) @map("created_at")
  rule              ReminderRule @relation(fields: [ruleId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@index([workspaceId, ruleId, createdAt, commandId], map: "reminder_rule_commands_history_idx")
  @@map("reminder_rule_commands")
  @@schema("crm_sales")
}

model ReminderJob {
  id             String @id @db.Uuid
  periodKey      String @unique @map("period_key") @db.VarChar(160)
  workspaceId    String? @map("workspace_id") @db.Uuid
  taskId         String? @map("task_id") @db.Uuid
  cursor         String? @db.Uuid
  status         String @default("PENDING") @db.VarChar(16)
  availableAt    DateTime @default(now()) @map("available_at")
  leaseToken     String? @map("lease_token") @db.Uuid
  leaseExpiresAt DateTime? @map("lease_expires_at")
  attempts       Int @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")

  @@index([status, availableAt])
  @@map("reminder_jobs")
  @@schema("crm_sales")
}

model ReminderDelivery {
  id                    String @id @db.Uuid
  deduplicationKey      String @unique @map("deduplication_key") @db.Char(64)
  workspaceId           String @map("workspace_id") @db.Uuid
  taskId                String @map("task_id") @db.Uuid
  ruleId                String @map("rule_id") @db.Uuid
  taskVersion           Int @map("task_version")
  assignmentVersion     Int? @map("assignment_version")
  ruleVersion           Int @map("rule_version")
  occurrenceIndex       Int @map("occurrence_index")
  recipientSubject      String @map("recipient_subject") @db.VarChar(256)
  recipientMembershipId String? @map("recipient_membership_id") @db.Uuid
  channel               String @db.VarChar(16)
  nominalAt             DateTime @map("nominal_at")
  status                String @default("PENDING") @db.VarChar(16)
  createdAt             DateTime @default(now()) @map("created_at")

  @@index([workspaceId, taskId, status])
  @@index([workspaceId, ruleId, status])
  @@map("reminder_deliveries")
  @@schema("crm_sales")
}

model ReminderOutbox {
  id             String @id @db.Uuid
  messageId      String @map("message_id") @db.Uuid
  eventType      String @map("event_type") @db.VarChar(120)
  payload        Json
  availableAt    DateTime @default(now()) @map("available_at")
  status         String @default("PENDING") @db.VarChar(16)
  leaseToken     String? @map("lease_token") @db.Uuid
  leaseExpiresAt DateTime? @map("lease_expires_at")
  attempts       Int @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  publishedAt    DateTime? @map("published_at")

  @@index([status, availableAt, createdAt])
  @@map("reminder_outbox")
  @@schema("crm_sales")
}

model ReminderRuntime {
  id          String @id @db.VarChar(32)
  revision    String @db.VarChar(64)
  ready       Boolean
  lastSeenAt  DateTime @map("last_seen_at")

  @@map("reminder_runtime")
  @@schema("crm_sales")
}

model DealTimeline {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  dealId       String   @map("deal_id") @db.Uuid
  kind         String   @db.VarChar(32)
  actorSubject String   @map("actor_subject") @db.VarChar(256)
  outcome      String   @db.VarChar(4000)
  fromStageId  String?  @map("from_stage_id") @db.Uuid
  toStageId    String?  @map("to_stage_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  deal         Deal     @relation(fields: [dealId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@index([workspaceId, dealId, createdAt])
  @@map("deal_timeline")
  @@schema("crm_sales")
}

model SalesCommandReceipt {
  commandId    String   @id @map("command_id") @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  actorSubject String   @map("actor_subject") @db.VarChar(256)
  commandType  String   @map("command_type") @db.VarChar(64)
  requestHash  String   @map("request_hash") @db.Char(64)
  dealId       String   @map("deal_id") @db.Uuid
  result       Json
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("command_receipts")
  @@schema("crm_sales")
}

enum SalesTaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@schema("crm_sales")
}

model IntakeOperationSlot {
  operationId  String     @id @map("operation_id") @db.Uuid
  workspaceId  String     @map("workspace_id") @db.Uuid
  workflowId   String     @map("workflow_id") @db.Uuid
  actorSubject String     @map("actor_subject") @db.VarChar(256)
  payloadHash  String     @map("payload_hash") @db.Char(64)
  state        String     @db.VarChar(16)
  contactId    String?    @map("contact_id") @db.Uuid
  dealId       String?    @map("deal_id") @db.Uuid
  firstTaskId  String?    @map("first_task_id") @db.Uuid
  committedAt  DateTime?  @map("committed_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  deal         Deal?      @relation("IntakeDeal", fields: [dealId, workspaceId, contactId], references: [id, workspaceId, contactId], onDelete: Restrict, onUpdate: Restrict)
  firstTask    SalesTask? @relation("IntakeFirstTask", fields: [firstTaskId, dealId, workspaceId], references: [id, dealId, workspaceId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([workspaceId, workflowId])
  @@map("intake_operation_slots")
  @@schema("crm_sales")
}

model IntakeOperationCommand {
  commandId    String   @id @map("command_id") @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  actorSubject String   @map("actor_subject") @db.VarChar(256)
  requestHash  String   @map("request_hash") @db.Char(64)
  result       Json
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("intake_operation_commands")
  @@schema("crm_sales")
}
