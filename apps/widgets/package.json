{
	"name": "@winwidget/widgets",
	"version": "1.0.0",
	"private": true,
	"description": "WinWidget widgets domain service",
	"license": "UNLICENSED",
	"packageManager": "pnpm@9.15.9",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "pnpm run build:server && pnpm run build:widgets",
		"build:server": "tsc -p tsconfig.build.json",
		"build:widgets": "node scripts/build-widgets.mjs && pnpm run build:widgets:check",
		"build:widgets:check": "node scripts/check-widgets.mjs",
		"start": "node dist/src/main.js",
		"start:local": "node --env-file=.env dist/src/main.js",
		"lint": "eslint \"src/**/*.ts\" --max-warnings=0",
		"test": "jest --runInBand",
		"test:integration": "pnpm run build && pnpm run test:integration:foundation && pnpm run test:integration:behavior && pnpm run test:integration:retention",
		"test:integration:behavior": "node test/integration/widgets-behavior.integration.mjs",
		"test:integration:foundation": "node test/integration/widgets-foundation.integration.mjs",
		"test:integration:retention": "node test/integration/widgets-retention.integration.mjs",
		"test:messaging-integration": "pnpm run build && node test/integration/widgets-messaging.integration.mjs",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"prisma:generate": "prisma generate --schema prisma/schema.prisma",
		"prisma:validate": "prisma validate --schema prisma/schema.prisma",
		"prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.864.0",
		"@nestjs/common": "11.1.18",
		"@nestjs/config": "4.0.4",
		"@nestjs/core": "11.1.18",
		"@nestjs/platform-express": "11.1.18",
		"@prisma/client": "5.22.0",
		"amqp-connection-manager": "^5.0.0",
		"amqplib": "^0.10.9",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1",
		"express": "5.2.1",
		"nodemailer": "9.0.3",
		"prisma": "5.22.0",
		"reflect-metadata": "^0.1.14",
		"rxjs": "^7.8.1",
		"xlsx": "file:vendor/xlsx-0.20.3.tgz"
	},
	"devDependencies": {
		"@nestjs/testing": "11.1.18",
		"@types/amqplib": "^0.10.8",
		"@types/express": "5.0.6",
		"@types/jest": "^29.5.14",
		"@types/multer": "2.2.0",
		"@types/node": "^20.17.12",
		"@types/nodemailer": "^6.4.17",
		"@typescript-eslint/eslint-plugin": "^6.21.0",
		"@typescript-eslint/parser": "^6.21.0",
		"esbuild": "0.28.0",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^9.1.0",
		"jest": "^29.7.0",
		"ts-jest": "^29.2.5",
		"typescript": "^5.7.3"
	},
	"pnpm": {
		"overrides": {
			"@nestjs/config>lodash": "4.18.1",
			"@nestjs/platform-express>multer": "2.2.0",
			"body-parser": "2.3.0"
		}
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": ".",
		"testRegex": "src/.*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": [
				"ts-jest",
				{
					"tsconfig": "tsconfig.json"
				}
			]
		},
		"testEnvironment": "node"
	}
}
