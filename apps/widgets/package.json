{
	"name": "@winwidget/widgets",
	"version": "1.0.0",
	"private": true,
	"description": "WinWidget widgets domain service",
	"license": "UNLICENSED",
	"packageManager": "pnpm@9.15.9",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"cutover": "node dist/src/cutover-main.js",
		"start": "node dist/src/main.js",
		"start:local": "node --env-file=../../.env dist/src/main.js",
		"lint": "eslint \"src/**/*.ts\" --max-warnings=0",
		"test": "jest --runInBand",
		"test:integration": "pnpm run build && pnpm --dir ../.. run build:widgets && pnpm run test:integration:foundation && pnpm run test:integration:behavior && pnpm run test:integration:retention",
		"test:integration:behavior": "node test/integration/widgets-behavior.integration.mjs",
		"test:integration:foundation": "node test/integration/widgets-foundation.integration.mjs",
		"test:integration:retention": "node test/integration/widgets-retention.integration.mjs",
		"test:messaging-integration": "pnpm run build && node test/integration/widgets-messaging.integration.mjs",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"prisma:generate": "prisma generate --schema prisma/schema.prisma",
		"prisma:validate": "prisma validate --schema prisma/schema.prisma",
		"prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.864.0",
		"@nestjs/common": "^10.4.15",
		"@nestjs/config": "^3.3.0",
		"@nestjs/core": "^10.4.15",
		"@nestjs/platform-express": "^10.4.15",
		"@prisma/client": "5.22.0",
		"amqp-connection-manager": "^5.0.0",
		"amqplib": "^0.10.9",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1",
		"express": "^4.22.1",
		"prisma": "5.22.0",
		"reflect-metadata": "^0.1.14",
		"rxjs": "^7.8.1",
		"xlsx": "^0.18.5"
	},
	"devDependencies": {
		"@nestjs/testing": "^10.4.15",
		"@types/amqplib": "^0.10.8",
		"@types/express": "^4.17.21",
		"@types/jest": "^29.5.14",
		"@types/multer": "^1.4.12",
		"@types/node": "^20.17.12",
		"@typescript-eslint/eslint-plugin": "^6.21.0",
		"@typescript-eslint/parser": "^6.21.0",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^9.1.0",
		"esbuild": "0.28.0",
		"jest": "^29.7.0",
		"ts-jest": "^29.2.5",
		"typescript": "^5.7.3"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": ".",
		"testRegex": "src/.*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": [
				"ts-jest",
				{
					"tsconfig": "tsconfig.json"
				}
			]
		},
		"testEnvironment": "node"
	}
}
