NODE_ENV=development
MODE=development
APP_REVISION=local

WIDGETS_PROCESS_ROLE=all
WIDGETS_LISTEN_HOST=127.0.0.1
WIDGETS_PORT=4700
WIDGETS_DATABASE_URL=postgresql://winwidget_widgets_runtime:change_me@127.0.0.1:55436/winwidget_widgets?schema=widgets&sslmode=disable
WIDGETS_MIGRATION_DATABASE_URL=postgresql://winwidget_widgets_migration:change_me@127.0.0.1:55436/winwidget_widgets?schema=widgets&sslmode=disable
WIDGETS_ASSETS_DIR=public/widgets
WIDGETS_UPLOADS_DIR=uploads
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Cloudflare Workers AI via AI Gateway. Never commit the real API token.
WIDGETS_AI_SESSION_SECRET=change_me_at_least_32_random_bytes_ai_session_secret
CLOUDFLARE_ACCOUNT_ID=change_me_cloudflare_account_id
CLOUDFLARE_API_TOKEN=change_me_cloudflare_workers_ai_token
CLOUDFLARE_AI_GATEWAY_ID=winwidget-ai-consultant
CLOUDFLARE_AI_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
CLOUDFLARE_AI_TIMEOUT_MS=20000
CLOUDFLARE_TURNSTILE_SITE_KEY=change_me_turnstile_site_key
CLOUDFLARE_TURNSTILE_SECRET_KEY=change_me_turnstile_secret_key
CLOUDFLARE_TURNSTILE_TIMEOUT_MS=8000

# Callback OTP. Keep this HMAC key separate from Identity/API credentials.
WIDGETS_CALLBACK_OTP_SECRET=change_me_at_least_32_random_bytes_callback_otp_secret
WIDGETS_CALLBACK_OTP_PROVIDER_TIMEOUT_MS=10000
SMTP_SERVER=127.0.0.1
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_LOGIN=change_me
SMTP_PASSWORD=change_me
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_GREETING_TIMEOUT_MS=5000
SMTP_SOCKET_TIMEOUT_MS=15000
SMSAERO_EMAIL=change_me@example.com
SMSAERO_API_KEY=change_me
SMSAERO_SIGN=WinWidget

WIDGETS_ENTITLEMENT_MAX_STALENESS_MS=86400000
WIDGETS_OUTBOX_BATCH_SIZE=50
WIDGETS_OUTBOX_POLL_INTERVAL_MS=1000
WIDGETS_OUTBOX_RETENTION_DAYS=7
WIDGETS_RECEIPT_RETENTION_DAYS=90
WIDGETS_FAILURE_DETAIL_RETENTION_DAYS=30
WIDGETS_PREFETCH=10
WIDGETS_PROVIDER_PREFETCH=10

# Inbound private callers.
WIDGETS_INTERNAL_TOKEN=change_me
WIDGETS_IDENTITY_TOKEN=change_me
WIDGETS_OPERATIONS_TOKEN=change_me

# Widgets -> Identity introspection and owner resolution.
IDENTITY_INTERNAL_BASE_URL=http://127.0.0.1:4900
IDENTITY_INTERNAL_TIMEOUT_MS=10000
IDENTITY_WIDGETS_TOKEN=change_me

# Native WinCRM connector: opt-in only, ordinary Widgets and existing v2 integrations are independent.
WIDGETS_WINCRM_CONNECTOR_ENABLED=false
# Required only for API/all when enabled. Two independent private pairwise credentials.
WIDGETS_CRM_INTAKE_TOKEN=
BILLING_WINCRM_WIDGETS_TOKEN=
# Exact HTTPS origin (private ingress to loopback), or explicit loopback HTTP for local development.
BILLING_INTERNAL_BASE_URL=
WIDGETS_WINCRM_HTTP_TIMEOUT_MS=3000

# Production button images use S3; local development uses WIDGETS_UPLOADS_DIR.
S3_ENDPOINT=https://s3.example.invalid
S3_REGION=ru-1
S3_BUCKET=change_me
S3_ACCESS_KEY_ID=change_me
S3_SECRET_ACCESS_KEY=change_me
S3_PUBLIC_BASE_URL=https://cdn.example.invalid/widgets
S3_FORCE_PATH_STYLE=true
S3_KEY_PREFIX=widget-buttons

RABBITMQ_URL=amqp://winwidget-widgets:change_me@127.0.0.1:5672/winwidget
RABBITMQ_CONNECTION_NAME=winwidget-widgets-all
RABBITMQ_ASSERT_TOPOLOGY=true
RABBITMQ_MAX_MESSAGE_BYTES=262144
WIDGETS_RABBITMQ_TOPOLOGY_SCOPE=all
