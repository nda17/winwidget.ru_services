generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/@prisma/widgets-client"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("WIDGETS_DATABASE_URL")
  schemas  = ["widgets"]
}

model Widget {
  id                         String    @id @default(cuid())
  userId                     String    @map("user_id")
  publicKey                  String    @unique @map("public_key")
  name                       String    @default("Виджет")
  isActive                   Boolean   @default(true) @map("is_active")
  installDomain              String    @default("") @map("install_domain")
  config                     Json      @default("{}")
  draftConfig                Json?     @map("draft_config")
  draftInstallDomain         String?   @map("draft_install_domain")
  draftRevision              Int       @default(0) @map("draft_revision")
  publishedVersion           Int       @default(0) @map("published_version")
  publishedFromDraftRevision Int       @default(0) @map("published_from_draft_revision")
  publishedAt                DateTime? @map("published_at")
  leads                      Lead[]
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("widgets")
  @@schema("widgets")
}

model Callback {
  id                         String                 @id @default(cuid())
  userId                     String                 @map("user_id")
  publicKey                  String                 @unique @map("public_key")
  name                       String                 @default("Обратный звонок")
  isActive                   Boolean                @default(true) @map("is_active")
  installDomain              String                 @default("") @map("install_domain")
  config                     Json                   @default("{}")
  draftConfig                Json?                  @map("draft_config")
  draftInstallDomain         String?                @map("draft_install_domain")
  draftRevision              Int                    @default(0) @map("draft_revision")
  publishedVersion           Int                    @default(0) @map("published_version")
  publishedFromDraftRevision Int                    @default(0) @map("published_from_draft_revision")
  publishedAt                DateTime?              @map("published_at")
  leads                      CallbackLead[]
  otpChallenges              CallbackOtpChallenge[]
  createdAt                  DateTime               @default(now()) @map("created_at")
  updatedAt                  DateTime               @updatedAt @map("updated_at")

  @@index([userId])
  @@map("callbacks")
  @@schema("widgets")
}

model CallbackLead {
  id                      String                   @id @default(cuid())
  callbackId              String                   @map("callback_id")
  phone                   String
  timeSlot                String                   @default("") @map("time_slot")
  timezone                String                   @default("") @map("timezone")
  url                     String?
  ip                      String?
  verificationMode        CallbackVerificationMode @default(OFF) @map("verification_mode")
  verificationChallengeId String?                  @unique(map: "callback_leads_verification_challenge_unique") @map("verification_challenge_id") @db.Uuid
  callback                Callback                 @relation(fields: [callbackId], references: [id], onDelete: Cascade)
  verificationChallenge   CallbackOtpChallenge?    @relation(fields: [verificationChallengeId], references: [id], onDelete: NoAction)
  createdAt               DateTime                 @default(now()) @map("created_at")

  @@index([callbackId])
  @@index([callbackId, ip])
  @@map("callback_leads")
  @@schema("widgets")
}

model CallbackOtpChallenge {
  id                String             @id @default(uuid()) @db.Uuid
  callbackId        String             @map("callback_id")
  ownerId           String             @map("owner_id")
  publishedVersion  Int                @map("published_version")
  channel           CallbackOtpChannel
  destinationHash   String             @map("destination_hash") @db.Char(64)
  ipHash            String             @map("ip_hash") @db.Char(64)
  codeHash          String             @map("code_hash") @db.Char(64)
  attempts          Int                @default(0)
  expiresAt         DateTime           @map("expires_at")
  resendAvailableAt DateTime           @map("resend_available_at")
  sentAt            DateTime?          @map("sent_at")
  failedAt          DateTime?          @map("failed_at")
  revokedAt         DateTime?          @map("revoked_at")
  consumedAt        DateTime?          @map("consumed_at")
  callback          Callback           @relation(fields: [callbackId], references: [id], onDelete: Cascade)
  lead              CallbackLead?
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@index([callbackId, channel, destinationHash, createdAt], map: "callback_otp_challenges_destination_idx")
  @@index([expiresAt, id], map: "callback_otp_challenges_expiry_idx")
  @@index([ownerId, createdAt], map: "callback_otp_challenges_owner_idx")
  @@map("callback_otp_challenges")
  @@schema("widgets")
}

model CallbackOtpRateBucket {
  id              String   @id @default(uuid()) @db.Uuid
  scope           String   @db.VarChar(40)
  subjectHash     String   @map("subject_hash") @db.Char(64)
  count           Int
  windowStartedAt DateTime @map("window_started_at")
  windowEndsAt    DateTime @map("window_ends_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([scope, subjectHash], map: "callback_otp_rate_buckets_scope_subject_unique")
  @@index([windowEndsAt, id], map: "callback_otp_rate_buckets_expiry_idx")
  @@map("callback_otp_rate_buckets")
  @@schema("widgets")
}

model CountdownTimer {
  id                         String               @id @default(cuid())
  userId                     String               @map("user_id")
  publicKey                  String               @unique @map("public_key")
  name                       String               @default("Таймер")
  isActive                   Boolean              @default(true) @map("is_active")
  installDomain              String               @default("") @map("install_domain")
  config                     Json                 @default("{}")
  draftConfig                Json?                @map("draft_config")
  draftInstallDomain         String?              @map("draft_install_domain")
  draftRevision              Int                  @default(0) @map("draft_revision")
  publishedVersion           Int                  @default(0) @map("published_version")
  publishedFromDraftRevision Int                  @default(0) @map("published_from_draft_revision")
  publishedAt                DateTime?            @map("published_at")
  leads                      CountdownTimerLead[]
  createdAt                  DateTime             @default(now()) @map("created_at")
  updatedAt                  DateTime             @updatedAt @map("updated_at")

  @@index([userId])
  @@map("countdown_timers")
  @@schema("widgets")
}

model CountdownTimerLead {
  id               String         @id @default(cuid())
  countdownTimerId String         @map("countdown_timer_id")
  phone            String?
  email            String?
  url              String?
  ip               String?
  timerResetToken  String         @default("") @map("timer_reset_token")
  countdownTimer   CountdownTimer @relation(fields: [countdownTimerId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([countdownTimerId])
  @@index([countdownTimerId, ip])
  @@index([countdownTimerId, timerResetToken])
  @@index([countdownTimerId, timerResetToken, ip])
  @@map("countdown_timer_leads")
  @@schema("widgets")
}

model StopOffer {
  id                         String          @id @default(cuid())
  userId                     String          @map("user_id")
  publicKey                  String          @unique @map("public_key")
  name                       String          @default("Стоп-оффер")
  isActive                   Boolean         @default(true) @map("is_active")
  installDomain              String          @default("") @map("install_domain")
  config                     Json            @default("{}")
  draftConfig                Json?           @map("draft_config")
  draftInstallDomain         String?         @map("draft_install_domain")
  draftRevision              Int             @default(0) @map("draft_revision")
  publishedVersion           Int             @default(0) @map("published_version")
  publishedFromDraftRevision Int             @default(0) @map("published_from_draft_revision")
  publishedAt                DateTime?       @map("published_at")
  leads                      StopOfferLead[]
  createdAt                  DateTime        @default(now()) @map("created_at")
  updatedAt                  DateTime        @updatedAt @map("updated_at")

  @@index([userId])
  @@map("stop_offers")
  @@schema("widgets")
}

model StopOfferLead {
  id          String    @id @default(cuid())
  stopOfferId String    @map("stop_offer_id")
  phone       String?
  email       String?
  url         String?
  ip          String?
  resetToken  String    @default("") @map("reset_token")
  stopOffer   StopOffer @relation(fields: [stopOfferId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([stopOfferId])
  @@index([stopOfferId, ip])
  @@index([stopOfferId, resetToken])
  @@index([stopOfferId, resetToken, ip])
  @@map("stop_offer_leads")
  @@schema("widgets")
}

model AiConsultant {
  id                         String    @id @default(cuid())
  userId                     String    @map("user_id")
  publicKey                  String    @unique @map("public_key")
  name                       String    @default("AI-консультант")
  isActive                   Boolean   @default(true) @map("is_active")
  installDomain              String    @default("") @map("install_domain")
  config                     Json      @default("{}")
  draftConfig                Json?     @map("draft_config")
  draftInstallDomain         String?   @map("draft_install_domain")
  draftRevision              Int       @default(0) @map("draft_revision")
  publishedVersion           Int       @default(0) @map("published_version")
  publishedFromDraftRevision Int       @default(0) @map("published_from_draft_revision")
  publishedAt                DateTime? @map("published_at")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("ai_consultants")
  @@schema("widgets")
}

model AiConsentReceipt {
  id                     String                 @id @default(uuid()) @db.Uuid
  acceptanceId           String                 @unique(map: "ai_consent_receipts_acceptance_unique") @map("acceptance_id") @db.Uuid
  widgetId               String                 @map("widget_id")
  widgetPublicKey        String                 @map("widget_public_key") @db.Char(12)
  ownerScope             String                 @map("owner_scope") @db.Char(43)
  configuredSiteHostname String                 @map("configured_site_hostname") @db.VarChar(253)
  requestHostname        String                 @map("request_hostname") @db.VarChar(253)
  publishedVersion       Int                    @map("published_version")
  sessionScope           String                 @map("session_scope") @db.Char(43)
  sourceScope            String                 @map("source_scope") @db.Char(43)
  documentVersion        String                 @map("document_version") @db.VarChar(64)
  documentHash           String                 @map("document_hash") @db.Char(64)
  statementText          String                 @map("statement_text") @db.Text
  privacyUrl             String                 @map("privacy_url") @db.VarChar(500)
  proofExpiresAt         DateTime               @map("proof_expires_at")
  acceptedAt             DateTime               @map("accepted_at")
  status                 AiConsentReceiptStatus @default(PENDING)
  verifiedAt             DateTime?              @map("verified_at")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")

  @@index([status, proofExpiresAt, id], map: "ai_consent_receipts_pending_retention_idx")
  @@index([status, acceptedAt, id], map: "ai_consent_receipts_verified_retention_idx")
  @@map("ai_consent_receipts")
  @@schema("widgets")
}

model Calculator {
  id                         String           @id @default(cuid())
  userId                     String           @map("user_id")
  publicKey                  String           @unique @map("public_key")
  name                       String           @default("Калькулятор")
  isActive                   Boolean          @default(true) @map("is_active")
  installDomain              String           @default("") @map("install_domain")
  config                     Json             @default("{}")
  draftConfig                Json?            @map("draft_config")
  draftInstallDomain         String?          @map("draft_install_domain")
  draftRevision              Int              @default(0) @map("draft_revision")
  publishedVersion           Int              @default(0) @map("published_version")
  publishedFromDraftRevision Int              @default(0) @map("published_from_draft_revision")
  publishedAt                DateTime?        @map("published_at")
  leads                      CalculatorLead[]
  createdAt                  DateTime         @default(now()) @map("created_at")
  updatedAt                  DateTime         @updatedAt @map("updated_at")

  @@index([userId])
  @@map("calculators")
  @@schema("widgets")
}

model CalculatorLead {
  id              String     @id @default(cuid())
  calculatorId    String     @map("calculator_id")
  contact         String
  phone           String?
  email           String?
  answers         Json       @default("[]")
  calculatedPrice Decimal    @map("calculated_price") @db.Decimal(14, 2)
  currency        String     @default("RUB")
  url             String?
  ip              String?
  calculator      Calculator @relation(fields: [calculatorId], references: [id], onDelete: Cascade)
  createdAt       DateTime   @default(now()) @map("created_at")

  @@index([calculatorId])
  @@index([calculatorId, ip])
  @@map("calculator_leads")
  @@schema("widgets")
}

model Quiz {
  id                         String     @id @default(cuid())
  userId                     String     @map("user_id")
  publicKey                  String     @unique @map("public_key")
  name                       String     @default("Квиз")
  isActive                   Boolean    @default(true) @map("is_active")
  installDomain              String     @default("") @map("install_domain")
  config                     Json       @default("{}")
  draftConfig                Json?      @map("draft_config")
  draftInstallDomain         String?    @map("draft_install_domain")
  draftRevision              Int        @default(0) @map("draft_revision")
  publishedVersion           Int        @default(0) @map("published_version")
  publishedFromDraftRevision Int        @default(0) @map("published_from_draft_revision")
  publishedAt                DateTime?  @map("published_at")
  leads                      QuizLead[]
  createdAt                  DateTime   @default(now()) @map("created_at")
  updatedAt                  DateTime   @updatedAt @map("updated_at")

  @@index([userId])
  @@map("quizzes")
  @@schema("widgets")
}

model QuizLead {
  id             String   @id @default(cuid())
  quizId         String   @map("quiz_id")
  contact        String
  phone          String?
  email          String?
  answers        Json     @default("[]")
  result         String?
  url            String?
  ip             String?
  quizResetToken String?  @map("quiz_reset_token")
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([quizId])
  @@index([quizId, ip])
  @@map("quiz_leads")
  @@schema("widgets")
}

model Lead {
  id             String   @id @default(cuid())
  widgetId       String   @map("widget_id")
  contact        String
  phone          String?
  email          String?
  bonus          String?
  url            String?
  ip             String?
  spinResetToken String?  @map("spin_reset_token")
  widget         Widget   @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([widgetId])
  @@index([widgetId, ip])
  @@map("leads")
  @@schema("widgets")
}

model WidgetConfigRevision {
  id            String   @id @default(cuid())
  widgetType    String   @map("widget_type")
  widgetId      String   @map("widget_id")
  version       Int
  config        Json
  installDomain String   @map("install_domain")
  sourceVersion Int?     @map("source_version")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([widgetType, widgetId, version])
  @@index([widgetType, widgetId, createdAt])
  @@map("widget_config_revisions")
  @@schema("widgets")
}

model WidgetRuntimePresence {
  id               String   @id @default(cuid())
  widgetType       String   @map("widget_type")
  widgetId         String   @map("widget_id")
  installDomain    String   @map("install_domain")
  runtimeVersion   String   @map("runtime_version")
  publishedVersion Int      @map("published_version")
  firstSeenAt      DateTime @default(now()) @map("first_seen_at")
  lastSeenAt       DateTime @default(now()) @map("last_seen_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([widgetType, widgetId])
  @@index([lastSeenAt])
  @@map("widget_runtime_presence")
  @@schema("widgets")
}

model WidgetRuntimeDailyMetric {
  id               String   @id @default(cuid())
  widgetType       String   @map("widget_type")
  widgetId         String   @map("widget_id")
  publishedVersion Int      @map("published_version")
  date             DateTime @db.Date
  impressions      Int      @default(0)
  opens            Int      @default(0)
  starts           Int      @default(0)
  completions      Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([widgetType, widgetId, publishedVersion, date], map: "widget_runtime_metric_unique")
  @@index([widgetType, widgetId, publishedVersion, date], map: "widget_runtime_metric_lookup_idx")
  @@map("widget_runtime_daily_metrics")
  @@schema("widgets")
}

model WidgetRuntimeDailyStepMetric {
  id               String   @id @default(cuid())
  widgetType       String   @map("widget_type")
  widgetId         String   @map("widget_id")
  publishedVersion Int      @map("published_version")
  date             DateTime @db.Date
  stepKey          String   @map("step_key")
  count            Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([widgetType, widgetId, publishedVersion, date, stepKey], map: "widget_runtime_step_metric_unique")
  @@index([widgetType, widgetId, publishedVersion, date], map: "widget_runtime_step_metric_lookup_idx")
  @@map("widget_runtime_daily_step_metrics")
  @@schema("widgets")
}

model WidgetEntitlementProjection {
  id                String                    @id
  userId            String                    @unique(map: "entitlement_projections_user_unique") @map("user_id")
  plan              EntitlementPlan?
  billingPeriod     EntitlementBillingPeriod? @map("billing_period")
  status            EntitlementStatus?
  startsAt          DateTime?                 @map("starts_at")
  expiresAt         DateTime?                 @map("expires_at")
  periodResetsAt    DateTime?                 @map("period_resets_at")
  maxWidgets        Int?                      @map("max_widgets")
  maxLeadsPerPeriod Int?                      @map("max_leads_per_period")
  unlimited         Boolean?
  tombstoned        Boolean                   @default(false)
  aggregateVersion  BigInt                    @map("aggregate_version")
  sourceSequence    BigInt                    @map("source_sequence")
  sourceOccurredAt  DateTime                  @map("source_occurred_at")
  sourceCreatedAt   DateTime?                 @map("source_created_at")
  sourceUpdatedAt   DateTime?                 @map("source_updated_at")
  appliedAt         DateTime                  @default(now()) @map("applied_at")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  @@index([status, expiresAt], map: "entitlement_projections_status_expiry_idx")
  @@index([sourceSequence], map: "entitlement_projections_source_sequence_idx")
  @@map("entitlement_projections")
  @@schema("widgets")
}

model WidgetUsageCounter {
  userId             String    @id @map("user_id")
  widgetCount        Int       @default(0) @map("widget_count")
  leadCount          Int       @default(0) @map("lead_count")
  leadPeriodKey      String?   @map("lead_period_key")
  leadPeriodStartsAt DateTime? @map("lead_period_starts_at")
  leadPeriodEndsAt   DateTime? @map("lead_period_ends_at")
  entitlementVersion BigInt    @default(0) @map("entitlement_version")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([leadPeriodEndsAt], map: "usage_counters_period_end_idx")
  @@map("usage_counters")
  @@schema("widgets")
}

model WidgetUsageLedgerEntry {
  id                 String         @id @default(uuid()) @db.Uuid
  userId             String         @map("user_id")
  kind               UsageKind
  operation          UsageOperation
  delta              Int
  counterAfter       Int            @map("counter_after")
  periodKey          String?        @map("period_key")
  aggregateType      String?        @map("aggregate_type")
  aggregateId        String?        @map("aggregate_id")
  idempotencyKey     String         @unique(map: "usage_ledger_idempotency_unique") @map("idempotency_key")
  entitlementVersion BigInt         @map("entitlement_version")
  correlationId      String?        @map("correlation_id")
  occurredAt         DateTime       @default(now()) @map("occurred_at")
  createdAt          DateTime       @default(now()) @map("created_at")

  @@index([userId, kind, occurredAt], map: "usage_ledger_user_kind_occurred_idx")
  @@index([aggregateType, aggregateId], map: "usage_ledger_aggregate_idx")
  @@map("usage_ledger")
  @@schema("widgets")
}

model WidgetOwnerProjection {
  userId           String      @id @map("user_id")
  status           OwnerStatus
  deletedAt        DateTime?   @map("deleted_at")
  tombstoned       Boolean     @default(false)
  aggregateVersion BigInt      @map("aggregate_version")
  sourceSequence   BigInt      @map("source_sequence")
  sourceOccurredAt DateTime    @map("source_occurred_at")
  appliedAt        DateTime    @default(now()) @map("applied_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  @@index([status], map: "owner_projections_status_idx")
  @@index([sourceSequence], map: "owner_projections_source_sequence_idx")
  @@map("owner_projections")
  @@schema("widgets")
}

model WidgetAggregateVersion {
  aggregateType  String   @map("aggregate_type")
  aggregateId    String   @map("aggregate_id")
  version        BigInt
  sourceSequence BigInt   @map("source_sequence")
  stateHash      String   @map("state_hash") @db.Char(64)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@id([aggregateType, aggregateId], map: "aggregate_versions_pkey")
  @@index([sourceSequence], map: "aggregate_versions_source_sequence_idx")
  @@map("aggregate_versions")
  @@schema("widgets")
}

model WidgetSourceSequence {
  id        String   @id @default("reporting")
  lastValue BigInt   @default(0) @map("last_value")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("source_sequences")
  @@schema("widgets")
}

model WidgetsOutboxEvent {
  id               String                @id @default(uuid()) @db.Uuid
  messageId        String                @default(uuid()) @map("message_id") @db.Uuid
  deduplicationKey String?               @unique(map: "outbox_events_deduplication_unique") @map("deduplication_key")
  exchange         WidgetsOutboxExchange @default(EVENTS)
  eventType        String                @map("event_type")
  routingKey       String                @map("routing_key")
  payload          Json
  headers          Json                  @default("{}")
  aggregateType    String?               @map("aggregate_type")
  aggregateId      String?               @map("aggregate_id")
  aggregateVersion BigInt?               @map("aggregate_version")
  sourceSequence   BigInt?               @map("source_sequence")
  status           WidgetsOutboxStatus   @default(PENDING)
  attempts         Int                   @default(0)
  availableAt      DateTime              @default(now()) @map("available_at")
  lockedAt         DateTime?             @map("locked_at")
  lockedBy         String?               @map("locked_by")
  lockToken        String?               @map("lock_token") @db.Uuid
  leaseExpiresAt   DateTime?             @map("lease_expires_at")
  publishedAt      DateTime?             @map("published_at")
  lastError        String?               @map("last_error") @db.Text
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  @@index([status, availableAt, createdAt], map: "outbox_events_dispatch_idx")
  @@index([status, leaseExpiresAt], map: "outbox_events_lease_idx")
  @@index([messageId], map: "outbox_events_message_idx")
  @@index([aggregateType, aggregateId, aggregateVersion], map: "outbox_events_aggregate_idx")
  @@index([sourceSequence], map: "outbox_events_source_sequence_idx")
  @@index([status, publishedAt, id], map: "outbox_events_retention_idx")
  @@map("outbox_events")
  @@schema("widgets")
}

model WidgetsConsumerReceipt {
  id              String                       @id @default(uuid()) @db.Uuid
  eventId         String                       @map("event_id") @db.Uuid
  consumer        String
  payloadHash     String                       @map("payload_hash") @db.Char(64)
  status          WidgetsConsumerReceiptStatus
  lockedAt        DateTime?                    @map("locked_at")
  lockedBy        String?                      @map("locked_by")
  lockToken       String?                      @map("lock_token") @db.Uuid
  leaseExpiresAt  DateTime?                    @map("lease_expires_at")
  retryAttempt    Int?                         @map("retry_attempt")
  retryCycle      Int                          @default(0) @map("retry_cycle")
  deliveredAt     DateTime?                    @map("delivered_at")
  lastError       String?                      @map("last_error") @db.Text
  detailsPurgedAt DateTime?                    @map("details_purged_at")
  createdAt       DateTime                     @default(now()) @map("created_at")
