MODE=development
APP_REVISION=local

IDENTITY_PROCESS_ROLE=api
# Leave empty to use the role default: api=4900, worker=4901, outbox-publisher=4902.
IDENTITY_PORT=
IDENTITY_LISTEN_HOST=127.0.0.1
IDENTITY_DATABASE_URL=postgresql://winwidget_identity_runtime:change_me@127.0.0.1:55438/winwidget_identity?schema=identity&sslmode=disable
IDENTITY_MIGRATION_DATABASE_URL=postgresql://winwidget_identity_migration:change_me@127.0.0.1:55438/winwidget_identity?schema=identity&sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=loopback
AUTH_COOKIE_DOMAIN=

JWT_ACCESS_PRIVATE_KEY_BASE64=change_me
JWT_ACCESS_JWKS_BASE64=change_me
JWT_ACCESS_ACTIVE_KID=change_me
JWT_ISSUER=http://localhost:4100
JWT_AUDIENCE=winwidget-api
JWT_ACCESS_TTL_SECONDS=900
JWT_CLOCK_TOLERANCE_SECONDS=0

RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=change_me
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_CLIENT_URL=http://localhost:3000

GOOGLE_CLIENT_ID=change_me
GOOGLE_CLIENT_SECRET=change_me
GOOGLE_CALLBACK_URL=http://localhost:4900/api/v1/auth/google/redirect
GITHUB_CLIENT_ID=change_me
GITHUB_CLIENT_SECRET=change_me
GITHUB_CALLBACK_URL=http://localhost:4900/api/v1/auth/github/redirect
YANDEX_CLIENT_ID=change_me
YANDEX_CLIENT_SECRET=change_me
YANDEX_CALLBACK_URL=http://localhost:4900/api/v1/auth/yandex/redirect
VK_CLIENT_ID=change_me
VK_SERVICE_TOKEN=change_me
VK_CALLBACK_URL=http://localhost:4900/api/v1/auth/vk/redirect

IDENTITY_AVATAR_S3_ENDPOINT=https://s3.example.invalid
IDENTITY_AVATAR_S3_REGION=ru-1
IDENTITY_AVATAR_S3_BUCKET=change_me
IDENTITY_AVATAR_S3_ACCESS_KEY_ID=change_me
IDENTITY_AVATAR_S3_SECRET_ACCESS_KEY=change_me
IDENTITY_AVATAR_S3_PUBLIC_BASE_URL=https://cdn.example.invalid/avatars
IDENTITY_AVATAR_S3_FORCE_PATH_STYLE=true

SMTP_SERVER=127.0.0.1
SMTP_LOGIN=change_me
SMTP_PASSWORD=change_me
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_GREETING_TIMEOUT_MS=5000
SMTP_SOCKET_TIMEOUT_MS=15000
SMSAERO_EMAIL=change_me
SMSAERO_API_KEY=change_me
SMSAERO_SIGN=WinWidget

TELEGRAM_API_BASE_URL=https://tg.winwidget.ru/telegram-api
TELEGRAM_API_PROXY_IP=185.184.122.62
TELEGRAM_WEBHOOK_HOST=https://example.invalid
TELEGRAM_AUTH_BOT_TOKEN=change_me
TELEGRAM_AUTH_BOT_USERNAME=change_me
TELEGRAM_AUTH_BOT_WEBHOOK_SECRET=change_me
TELEGRAM_INFO_BOT_TOKEN=change_me
TELEGRAM_INFO_BOT_USERNAME=change_me
TELEGRAM_INFO_BOT_WEBHOOK_SECRET=change_me

# Inbound caller credentials; all eight production values must be distinct.
IDENTITY_CAMPAIGNS_TOKEN=change_me
IDENTITY_REPORTING_TOKEN=change_me
IDENTITY_WIDGETS_TOKEN=change_me
IDENTITY_BILLING_TOKEN=change_me
IDENTITY_CRM_ACCESS_TOKEN=change_me
IDENTITY_PLATFORM_TOKEN=change_me
IDENTITY_SUPPORT_TOKEN=change_me
IDENTITY_OPERATIONS_TOKEN=change_me

# Identity -> domain owners.
BILLING_INTERNAL_BASE_URL=http://127.0.0.1:4800
BILLING_IDENTITY_TOKEN=change_me
WIDGETS_INTERNAL_BASE_URL=http://127.0.0.1:4700
WIDGETS_IDENTITY_TOKEN=change_me
OPERATIONS_INTERNAL_BASE_URL=http://127.0.0.1:5200
OPERATIONS_IDENTITY_TOKEN=change_me

RABBITMQ_URL=amqp://winwidget-identity:change_me@127.0.0.1:5672/winwidget
# Must equal winwidget-identity-<IDENTITY_PROCESS_ROLE> for worker/publisher roles.
RABBITMQ_CONNECTION_NAME=winwidget-identity-api
RABBITMQ_ASSERT_TOPOLOGY=false
RABBITMQ_MAX_MESSAGE_BYTES=262144
IDENTITY_PREFETCH=10
IDENTITY_OUTBOX_BATCH_SIZE=50
IDENTITY_OUTBOX_POLL_INTERVAL_MS=1000
IDENTITY_OUTBOX_RETENTION_DAYS=7
IDENTITY_RECEIPT_RETENTION_DAYS=90
IDENTITY_FAILURE_DETAIL_RETENTION_DAYS=30
IDENTITY_HOUSEKEEPING_INTERVAL_MS=3600000
