{
	"name": "@winwidget/identity",
	"version": "1.0.0",
	"private": true,
	"description": "WinWidget identity microservice",
	"license": "UNLICENSED",
	"packageManager": "pnpm@9.15.9",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/src/main.js",
		"lint": "eslint \"src/**/*.ts\" --max-warnings=0",
		"test": "jest --runInBand",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"prisma:generate": "prisma generate --schema prisma/schema.prisma",
		"prisma:validate": "prisma validate --schema prisma/schema.prisma",
		"prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
		"cutover:preflight": "node dist/src/cutover/main.js preflight",
		"cutover:status": "node dist/src/cutover/main.js status",
		"cutover:import": "node dist/src/cutover/main.js import",
		"cutover:activate": "node dist/src/cutover/main.js activate",
		"cutover:complete": "node dist/src/cutover/main.js complete"
	},
	"dependencies": {
		"@nestjs/common": "^10.4.15",
		"@nestjs/config": "^3.3.0",
		"@nestjs/core": "^10.4.15",
		"@nestjs/jwt": "^10.2.0",
		"@nestjs/platform-express": "^10.4.15",
		"@prisma/client": "5.22.0",
		"@react-email/components": "0.0.21",
		"@react-email/render": "^0.0.16",
		"amqp-connection-manager": "^5.0.0",
		"amqplib": "^0.10.9",
		"bcryptjs": "^2.4.3",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1",
		"cookie-parser": "^1.4.7",
		"express": "^4.22.1",
		"nodemailer": "^6.9.16",
		"prisma": "5.22.0",
		"react": "^18.3.1",
		"reflect-metadata": "^0.1.14",
		"rxjs": "^7.8.1"
	},
	"devDependencies": {
		"@nestjs/testing": "^10.4.15",
		"@types/amqplib": "^0.10.8",
		"@types/bcryptjs": "^2.4.6",
		"@types/cookie-parser": "^1.4.8",
		"@types/express": "^4.17.21",
		"@types/jest": "^29.5.14",
		"@types/node": "^20.17.12",
		"@types/nodemailer": "^6.4.17",
		"@types/react": "^18.3.18",
		"@types/supertest": "2.0.16",
		"@typescript-eslint/eslint-plugin": "^6.21.0",
		"@typescript-eslint/parser": "^6.21.0",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^9.1.0",
		"jest": "^29.7.0",
		"supertest": "6.3.4",
		"ts-jest": "^29.2.5",
		"typescript": "^5.7.3"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": ".",
		"testRegex": "src/.*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": [
				"ts-jest",
				{
					"tsconfig": "tsconfig.json"
				}
			]
		},
		"testEnvironment": "node"
	}
}
