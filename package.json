{
	"name": "winwidget-services",
	"version": "0.1.0",
	"description": "WinWidget backend microservices repository tooling",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"packageManager": "pnpm@9.15.9",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"format": "prettier --write .eslintrc.js .prettierrc package.json README.md",
		"format:check": "prettier --check .eslintrc.js .prettierrc package.json README.md",
		"lint": "eslint \"apps/*/{src,test}/**/*.{ts,tsx}\" --max-warnings=0",
		"lint:fix": "pnpm run lint --fix",
		"jwt:keyset:generate": "node scripts/generate-jwt-keyset.mjs",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{ts,tsx,js,json,md}": "prettier --write",
		"*.{ts,tsx}": "eslint --fix --max-warnings=0"
	},
	"devDependencies": {
		"@typescript-eslint/eslint-plugin": "^6.21.0",
		"@typescript-eslint/parser": "^6.21.0",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-prettier": "^5.2.1",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"prettier": "^3.4.2",
		"typescript": "^5.7.3"
	}
}
