{
	"name": "winwidget-server",
	"version": "0.1.0",
	"description": "winwidget.ru",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"prisma-generate": "npx prisma generate",
		"prisma-db-push": "npx prisma db push",
		"dev-prisma-migration": "DATABASE_URL=\"$(sed -n 's/^DATABASE_URL_DEVELOPMENT=//p' .env | tr -d '\"')\" pnpm exec prisma migrate deploy",
		"build": "pnpm run build:app && pnpm run build:widgets",
		"build:app": "nest build",
		"build:widgets": "node scripts/build-widgets.mjs && pnpm run build:widgets:check",
		"build:widgets:check": "node scripts/check-widgets.mjs",
		"format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "nest start",
		"dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/src/main.js",
		"start:outbox-publisher": "node dist/src/outbox-publisher-main.js",
		"start:integration-worker": "node dist/src/integration-worker-main.js",
		"start:maintenance-worker": "node dist/src/maintenance-worker-main.js",
		"start:database-restore-worker": "node dist/src/database-restore-worker-main.js",
		"start:api-gateway": "pnpm --dir apps/api-gateway run start:local",
		"lint": "eslint \"{src,libs,test}/**/*.ts\" --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./test/jest-e2e.json",
		"test:messaging-integration": "node scripts/test-messaging-integration.mjs",
		"test:widgets-cutover-rehearsal": "bash scripts/test-widgets-cutover-rehearsal.sh",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{ts,tsx,js,json,md}": "prettier --write",
		"*.{ts,tsx}": "eslint --fix --max-warnings=0"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1032.0",
		"@nestjs/common": "^10.4.15",
		"@nestjs/config": "^3.3.0",
		"@nestjs/core": "^10.4.15",
		"@nestjs/platform-express": "^10.4.15",
		"@nestjs/serve-static": "^4.0.2",
		"@prisma/client": "5.22.0",
		"amqp-connection-manager": "^5.0.0",
		"amqplib": "^0.10.9",
		"app-root-path": "^3.1.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1",
		"colors": "^1.4.0",
		"express": "^4.22.1",
		"fs-extra": "^11.2.0",
		"lodash": "^4.17.21",
		"morgan": "^1.10.1",
		"prisma": "^5.22.0",
		"reflect-metadata": "^0.1.14",
		"rxjs": "^7.8.1",
		"xlsx": "^0.18.5"
	},
	"devDependencies": {
		"@nestjs/cli": "^10.4.9",
		"@nestjs/schematics": "^10.2.3",
		"@nestjs/testing": "^10.4.15",
		"@types/amqplib": "^0.10.8",
		"@types/app-root-path": "^1.2.8",
		"@types/express": "^4.17.21",
		"@types/fs-extra": "^11.0.4",
		"@types/jest": "^29.5.14",
		"@types/lodash": "^4.17.14",
		"@types/multer": "^1.4.12",
		"@types/node": "^20.17.12",
		"@types/supertest": "^2.0.16",
		"@typescript-eslint/eslint-plugin": "^6.21.0",
		"@typescript-eslint/parser": "^6.21.0",
		"esbuild": "^0.28.0",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-prettier": "^5.2.1",
		"husky": "^9.1.7",
		"jest": "^29.7.0",
		"lint-staged": "^16.4.0",
		"prettier": "^3.4.2",
		"source-map-support": "^0.5.21",
		"supertest": "^6.3.4",
		"ts-jest": "^29.2.5",
		"ts-loader": "^9.5.1",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.7.3"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts",
			"tsx"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)sx?$": "ts-jest"
		},
		"moduleNameMapper": {
			"^@/(.*)$": "<rootDir>/$1"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	}
}
