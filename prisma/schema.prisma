generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                           String                       @id @default(cuid())
  name                         String?
  password                     String
  avatarPath                   String?
  status                       UserStatus                   @default(ACTIVE)
  personalDataConsentRevokedAt DateTime?                    @map("personal_data_consent_revoked_at")
  rights                       Role[]                       @default([USER])
  authIdentities               AuthIdentity[]
  telegramNotificationChannel  TelegramNotificationChannel?
  verificationChallenges       VerificationChallenge[]
  payments                     Payment[]
  widgets                      Widget[]
  quizzes                      Quiz[]
  callbacks                    Callback[]
  countdownTimers              CountdownTimer[]
  stopOffers                   StopOffer[]
  onlineConsultants            OnlineConsultant[]
  calculators                  Calculator[]
  subscription                 Subscription?
  subscriptionHistories        SubscriptionHistory[]        @relation("SubscriptionHistoryUser")
  subscriptionHistoryActions   SubscriptionHistory[]        @relation("SubscriptionHistoryAdmin")
  subscriptionExpiryReminders  SubscriptionExpiryReminder[]
  affiliateReferralsMade       AffiliateReferral[]          @relation("AffiliateReferralReferrer")
  affiliateReferral            AffiliateReferral?           @relation("AffiliateReferralReferred")
  adminEventLogActions         AdminEventLog[]              @relation("AdminEventLogAdmin")
  adminEventLogTargets         AdminEventLog[]              @relation("AdminEventLogTargetUser")
  mailingCampaigns             MailingCampaign[]            @relation("MailingCampaignAdmin")
  sessions                     UserSession[]
  createdAt                    DateTime                     @default(now()) @map("created_at")
  updatedAt                    DateTime                     @updatedAt @map("updated_at")

  @@index([status])
}

model UserSession {
  id               String    @id
  userId           String    @map("user_id")
  refreshTokenHash String    @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Widget {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  publicKey     String   @unique @map("public_key")
  name          String   @default("Виджет")
  isActive      Boolean  @default(true) @map("is_active")
  installDomain String   @default("") @map("install_domain")
  config        Json     @default("{}")
  leads         Lead[]
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("widgets")
}

model Callback {
  id            String         @id @default(cuid())
  userId        String         @map("user_id")
  publicKey     String         @unique @map("public_key")
  name          String         @default("Обратный звонок")
  isActive      Boolean        @default(true) @map("is_active")
  installDomain String         @default("") @map("install_domain")
  config        Json           @default("{}")
  leads         CallbackLead[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([userId])
  @@map("callbacks")
}

model CallbackLead {
  id         String   @id @default(cuid())
  callbackId String   @map("callback_id")
  phone      String
  timeSlot   String   @default("") @map("time_slot")
  timezone   String   @default("") @map("timezone")
  url        String?
  ip         String?
  callback   Callback @relation(fields: [callbackId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([callbackId])
  @@index([callbackId, ip])
  @@map("callback_leads")
}

model CountdownTimer {
  id            String               @id @default(cuid())
  userId        String               @map("user_id")
  publicKey     String               @unique @map("public_key")
  name          String               @default("Таймер")
  isActive      Boolean              @default(true) @map("is_active")
  installDomain String               @default("") @map("install_domain")
  config        Json                 @default("{}")
  leads         CountdownTimerLead[]
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  @@index([userId])
  @@map("countdown_timers")
}

model CountdownTimerLead {
  id               String         @id @default(cuid())
  countdownTimerId String         @map("countdown_timer_id")
  phone            String?
  email            String?
  url              String?
  ip               String?
  timerResetToken  String         @default("") @map("timer_reset_token")
  countdownTimer   CountdownTimer @relation(fields: [countdownTimerId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([countdownTimerId])
  @@index([countdownTimerId, ip])
  @@index([countdownTimerId, timerResetToken])
  @@index([countdownTimerId, timerResetToken, ip])
  @@map("countdown_timer_leads")
}

model StopOffer {
  id            String          @id @default(cuid())
  userId        String          @map("user_id")
  publicKey     String          @unique @map("public_key")
  name          String          @default("Стоп-оффер")
  isActive      Boolean         @default(true) @map("is_active")
  installDomain String          @default("") @map("install_domain")
  config        Json            @default("{}")
  leads         StopOfferLead[]
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([userId])
  @@map("stop_offers")
}

model StopOfferLead {
  id          String    @id @default(cuid())
  stopOfferId String    @map("stop_offer_id")
  phone       String?
  email       String?
  url         String?
  ip          String?
  resetToken  String    @default("") @map("reset_token")
  stopOffer   StopOffer @relation(fields: [stopOfferId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([stopOfferId])
  @@index([stopOfferId, ip])
  @@index([stopOfferId, resetToken])
  @@index([stopOfferId, resetToken, ip])
  @@map("stop_offer_leads")
}

model OnlineConsultant {
  id            String                 @id @default(cuid())
  userId        String                 @map("user_id")
  publicKey     String                 @unique @map("public_key")
  name          String                 @default("Онлайн-консультант")
  isActive      Boolean                @default(true) @map("is_active")
  installDomain String                 @default("") @map("install_domain")
  config        Json                   @default("{}")
  leads         OnlineConsultantLead[]
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  @@index([userId])
  @@map("online_consultants")
}

model OnlineConsultantLead {
  id                 String           @id @default(cuid())
  onlineConsultantId String           @map("online_consultant_id")
  phone              String?
  email              String?
  actionLabel        String           @default("") @map("action_label")
  actionValue        String           @default("") @map("action_value")
  url                String?
  ip                 String?
  onlineConsultant   OnlineConsultant @relation(fields: [onlineConsultantId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now()) @map("created_at")

  @@index([onlineConsultantId])
  @@index([onlineConsultantId, ip])
  @@map("online_consultant_leads")
}

model Calculator {
  id            String           @id @default(cuid())
  userId        String           @map("user_id")
  publicKey     String           @unique @map("public_key")
  name          String           @default("Калькулятор")
  isActive      Boolean          @default(true) @map("is_active")
  installDomain String           @default("") @map("install_domain")
  config        Json             @default("{}")
  leads         CalculatorLead[]
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@index([userId])
  @@map("calculators")
}

model CalculatorLead {
  id              String     @id @default(cuid())
  calculatorId    String     @map("calculator_id")
  contact         String
  phone           String?
  email           String?
  answers         Json       @default("[]")
  calculatedPrice Decimal    @map("calculated_price") @db.Decimal(14, 2)
  currency        String     @default("RUB")
  url             String?
  ip              String?
  calculator      Calculator @relation(fields: [calculatorId], references: [id], onDelete: Cascade)
  createdAt       DateTime   @default(now()) @map("created_at")

  @@index([calculatorId])
  @@index([calculatorId, ip])
  @@map("calculator_leads")
}

model Quiz {
  id            String     @id @default(cuid())
  userId        String     @map("user_id")
  publicKey     String     @unique @map("public_key")
  name          String     @default("Квиз")
  isActive      Boolean    @default(true) @map("is_active")
  installDomain String     @default("") @map("install_domain")
  config        Json       @default("{}")
  leads         QuizLead[]
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@index([userId])
  @@map("quizzes")
}

model QuizLead {
  id             String   @id @default(cuid())
  quizId         String   @map("quiz_id")
  contact        String
  phone          String?
  email          String?
  answers        Json     @default("[]")
  result         String?
  url            String?
  ip             String?
  quizResetToken String?  @map("quiz_reset_token")
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([quizId])
  @@index([quizId, ip])
  @@map("quiz_leads")
}

model Lead {
  id             String   @id @default(cuid())
  widgetId       String   @map("widget_id")
  contact        String
  phone          String?
  email          String?
  bonus          String?
  url            String?
  ip             String?
  spinResetToken String?  @map("spin_reset_token")
  widget         Widget   @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([widgetId])
  @@index([widgetId, ip])
  @@map("leads")
}

model Subscription {
  id              String                       @id @default(cuid())
  userId          String                       @unique @map("user_id")
  plan            Plan                         @default(TRIAL)
  billingPeriod   BillingPeriod?               @map("billing_period")
  status          SubscriptionStatus           @default(ACTIVE)
  startsAt        DateTime                     @default(now()) @map("starts_at")
  expiresAt       DateTime?                    @map("expires_at")
  leadsThisPeriod Int                          @default(0) @map("leads_this_period")
  periodResetsAt  DateTime?                    @map("period_resets_at")
  user            User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  histories       SubscriptionHistory[]
  expiryReminders SubscriptionExpiryReminder[]
  createdAt       DateTime                     @default(now()) @map("created_at")
  updatedAt       DateTime                     @updatedAt @map("updated_at")

  @@map("subscriptions")
}

model SubscriptionExpiryReminder {
  id               String       @id @default(cuid())
  subscriptionId   String       @map("subscription_id")
  userId           String       @map("user_id")
  daysBeforeExpiry Int          @map("days_before_expiry")
  expiresAt        DateTime     @map("expires_at")
  sentTo           String       @map("sent_to")
  subscription     Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentAt           DateTime     @default(now()) @map("sent_at")

  @@unique([subscriptionId, daysBeforeExpiry, expiresAt, sentTo], map: "subscription_expiry_reminder_unique")
  @@index([userId], map: "subscription_expiry_reminders_user_id_idx")
  @@index([daysBeforeExpiry, expiresAt], map: "subscription_expiry_reminders_days_expires_idx")
  @@index([sentAt], map: "subscription_expiry_reminders_sent_at_idx")
  @@map("subscription_expiry_reminders")
}

model TelegramNotificationChannel {
  id             String    @id @default(cuid())
  userId         String    @unique @map("user_id")
  chatId         String    @unique @map("chat_id")
  telegramUserId String?   @unique @map("telegram_user_id")
  username       String?
  firstName      String?   @map("first_name")
  lastName       String?   @map("last_name")
  isActive       Boolean   @default(true) @map("is_active")
  connectedAt    DateTime  @default(now()) @map("connected_at")
  disabledAt     DateTime? @map("disabled_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive], map: "telegram_notification_channels_is_active_idx")
  @@map("telegram_notification_channels")
}

model TelegramSupportMessage {
  id             String   @id @default(cuid())
  adminChatId    String   @map("admin_chat_id")
  adminMessageId Int      @map("admin_message_id")
  userChatId     String   @map("user_chat_id")
  telegramUserId String?  @map("telegram_user_id")
  username       String?
  firstName      String?  @map("first_name")
  lastName       String?  @map("last_name")
  text           String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([adminChatId, adminMessageId], map: "telegram_support_messages_admin_message_unique")
  @@index([userChatId], map: "telegram_support_messages_user_chat_id_idx")
  @@index([createdAt], map: "telegram_support_messages_created_at_idx")
  @@map("telegram_support_messages")
}

model SubscriptionHistory {
  id                 String                     @id @default(cuid())
  subscriptionId     String?                    @map("subscription_id")
  userId             String?                    @map("user_id")
  adminId            String?                    @map("admin_id")
  action             SubscriptionHistoryAction
  days               Int?
  oldExpiresAt       DateTime?                  @map("old_expires_at")
  newExpiresAt       DateTime?                  @map("new_expires_at")
  targetAudience     SubscriptionBonusAudience? @map("target_audience")
  targetLabel        String?                    @map("target_label")
  affectedUsersCount Int?                       @map("affected_users_count")
  subscription       Subscription?              @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user               User?                      @relation("SubscriptionHistoryUser", fields: [userId], references: [id], onDelete: Cascade)
  admin              User?                      @relation("SubscriptionHistoryAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  createdAt          DateTime                   @default(now()) @map("created_at")

  @@index([subscriptionId])
  @@index([userId])
  @@index([adminId])
  @@index([createdAt])
  @@map("subscription_history")
}

model AdminEventLog {
  id              String   @id @default(cuid())
  adminId         String?  @map("admin_id")
  adminName       String?  @map("admin_name")
  adminEmail      String?  @map("admin_email")
  section         String
  action          String
  description     String
  entityType      String?  @map("entity_type")
  entityId        String?  @map("entity_id")
  entityLabel     String?  @map("entity_label")
  targetUserId    String?  @map("target_user_id")
  targetUserName  String?  @map("target_user_name")
  targetUserEmail String?  @map("target_user_email")
  metadata        Json     @default("{}")
  ip              String?
  userAgent       String?  @map("user_agent")
  admin           User?    @relation("AdminEventLogAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  targetUser      User?    @relation("AdminEventLogTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@index([targetUserId])
  @@index([section])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("admin_event_logs")
}

model Payment {
  id                String             @id @default(cuid())
  userId            String             @map("user_id")
  yookassaId        String             @unique @map("yookassa_id")
  amount            String
  confirmationUrl   String?            @map("confirmation_url")
  status            PaymentStatus      @default(PENDING)
  plan              Plan?
  billingPeriod     BillingPeriod?     @map("billing_period")
  affiliateReferral AffiliateReferral?
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payments")
}

model OutboxEvent {
  id          String            @id @default(uuid()) @db.Uuid
  eventType   String            @map("event_type")
  routingKey  String            @map("routing_key")
  payload     Json
  status      OutboxEventStatus @default(PENDING)
  attempts    Int               @default(0)
  availableAt DateTime          @default(now()) @map("available_at")
  lockedAt    DateTime?         @map("locked_at")
  lockedBy    String?           @map("locked_by")
  publishedAt DateTime?         @map("published_at")
  lastError   String?           @map("last_error") @db.Text
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([status, availableAt, createdAt], map: "outbox_events_dispatch_idx")
  @@index([lockedAt], map: "outbox_events_locked_at_idx")
  @@index([publishedAt], map: "outbox_events_published_at_idx")
  @@map("outbox_events")
}

model MessagingHeartbeat {
  id         String   @id @default(uuid()) @db.Uuid
  service    String
  instanceId String   @map("instance_id")
  metadata   Json     @default("{}")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([service, instanceId], map: "messaging_heartbeats_service_instance_unique")
  @@index([service, lastSeenAt], map: "messaging_heartbeats_service_seen_idx")
  @@index([lastSeenAt], map: "messaging_heartbeats_seen_idx")
  @@map("messaging_heartbeats")
}

model IntegrationDeliveryFailure {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @map("event_id") @db.Uuid
  integration String
  routingKey  String    @map("routing_key")
  payload     Json
  attempts    Int
  lastError   String    @map("last_error") @db.Text
  failedAt    DateTime  @default(now()) @map("failed_at")
  retryingAt  DateTime? @map("retrying_at")
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([eventId, integration], map: "integration_delivery_failures_event_integration_unique")
  @@index([resolvedAt, failedAt], map: "integration_delivery_failures_status_idx")
  @@index([integration, resolvedAt], map: "integration_delivery_failures_integration_idx")
  @@map("integration_delivery_failures")
}

model IntegrationDeliveryReceipt {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  integration String
  deliveredAt DateTime @default(now()) @map("delivered_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([eventId, integration], map: "integration_delivery_receipts_event_integration_unique")
  @@index([integration, deliveredAt], map: "integration_delivery_receipts_integration_delivered_idx")
  @@index([deliveredAt], map: "integration_delivery_receipts_delivered_idx")
  @@map("integration_delivery_receipts")
}

model MailingCampaign {
  id                     String                @id @default(uuid()) @db.Uuid
  adminId                String                @map("admin_id")
  subject                String
  message                String                @db.Text
  audience               String
  requestedChannel       String                @map("requested_channel")
  status                 MailingCampaignStatus @default(QUEUED)
  recipientCount         Int                   @default(0) @map("recipient_count")
  sentCount              Int                   @default(0) @map("sent_count")
  failedCount            Int                   @default(0) @map("failed_count")
  cancelledCount         Int                   @default(0) @map("cancelled_count")
  emailRecipientCount    Int                   @default(0) @map("email_recipient_count")
  telegramRecipientCount Int                   @default(0) @map("telegram_recipient_count")
  startedAt              DateTime?             @map("started_at")
  completedAt            DateTime?             @map("completed_at")
  cancelRequestedAt      DateTime?             @map("cancel_requested_at")
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")
  admin                  User                  @relation("MailingCampaignAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  deliveries             MailingDelivery[]

  @@index([status, createdAt], map: "mailing_campaigns_status_created_idx")
  @@index([adminId, createdAt], map: "mailing_campaigns_admin_created_idx")
  @@map("mailing_campaigns")
}

model MailingDelivery {
  id          String                 @id @default(uuid()) @db.Uuid
  campaignId  String                 @map("campaign_id") @db.Uuid
  channel     MailingDeliveryChannel
  recipient   String
  status      MailingDeliveryStatus  @default(PENDING)
  attempts    Int                    @default(0)
  lastError   String?                @map("last_error") @db.Text
  sentAt      DateTime?              @map("sent_at")
  cancelledAt DateTime?              @map("cancelled_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  campaign    MailingCampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, channel, recipient], map: "mailing_deliveries_campaign_channel_recipient_unique")
  @@index([campaignId, status], map: "mailing_deliveries_campaign_status_idx")
  @@index([status, updatedAt], map: "mailing_deliveries_status_updated_idx")
  @@map("mailing_deliveries")
}

model TariffPrice {
  id            String        @id @default(cuid())
  plan          Plan
  billingPeriod BillingPeriod @map("billing_period")
  amount        Int
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@unique([plan, billingPeriod])
  @@map("tariff_prices")
}

model AuthIdentity {
  id         String           @id @default(cuid())
  userId     String           @map("user_id")
  type       AuthIdentityType
  value      String
  verifiedAt DateTime?        @map("verified_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([type, value])
  @@unique([userId, type])
  @@index([userId])
  @@map("auth_identities")
}

model VerificationChallenge {
  id                String                       @id @default(cuid())
  userId            String?                      @map("user_id")
  type              VerificationChallengeType
  purpose           VerificationChallengePurpose
  value             String
  passwordHash      String?                      @map("password_hash")
  codeHash          String                       @map("code_hash")
  attempts          Int                          @default(0)
  telegramUserId    String?                      @map("telegram_user_id")
  telegramChatId    String?                      @map("telegram_chat_id")
  telegramUsername  String?                      @map("telegram_username")
  telegramFirstName String?                      @map("telegram_first_name")
  telegramLastName  String?                      @map("telegram_last_name")
  expiresAt         DateTime                     @map("expires_at")
  lastSentAt        DateTime                     @default(now()) @map("last_sent_at")
  createdAt         DateTime                     @default(now()) @map("created_at")
  updatedAt         DateTime                     @updatedAt @map("updated_at")
  user              User?                        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, type, purpose])
  @@unique([type, purpose, value])
  @@index([telegramUserId])
  @@index([expiresAt])
  @@map("verification_challenges")
}

