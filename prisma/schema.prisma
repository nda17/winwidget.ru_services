generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                           String                       @id @default(cuid())
  name                         String?
  password                     String
  avatarPath                   String?
  status                       UserStatus                   @default(ACTIVE)
  personalDataConsentRevokedAt DateTime?                    @map("personal_data_consent_revoked_at")
  deletedAt                    DateTime?                    @map("deleted_at")
  rights                       Role[]                       @default([USER])
  authIdentities               AuthIdentity[]
  telegramNotificationChannel  TelegramNotificationChannel?
  verificationChallenges       VerificationChallenge[]
  payments                     Payment[]
  autoRenewal                  AutoRenewal?
  autoRenewalConsentEvents     AutoRenewalConsentEvent[]
  widgets                      Widget[]
  quizzes                      Quiz[]
  callbacks                    Callback[]
  countdownTimers              CountdownTimer[]
  stopOffers                   StopOffer[]
  onlineConsultants            OnlineConsultant[]
  calculators                  Calculator[]
  subscription                 Subscription?
  subscriptionHistories        SubscriptionHistory[]        @relation("SubscriptionHistoryUser")
  subscriptionHistoryActions   SubscriptionHistory[]        @relation("SubscriptionHistoryAdmin")
  subscriptionExpiryReminders  SubscriptionExpiryReminder[]
  affiliateReferralsMade       AffiliateReferral[]          @relation("AffiliateReferralReferrer")
  affiliateReferral            AffiliateReferral?           @relation("AffiliateReferralReferred")
  adminEventLogActions         AdminEventLog[]              @relation("AdminEventLogAdmin")
  adminEventLogTargets         AdminEventLog[]              @relation("AdminEventLogTargetUser")
  resolvedIntegrationFailures  IntegrationDeliveryFailure[] @relation("IntegrationFailureResolver")
  sessions                     UserSession[]
  createdAt                    DateTime                     @default(now()) @map("created_at")
  updatedAt                    DateTime                     @updatedAt @map("updated_at")

  @@index([status])
  @@index([deletedAt])
}

model UserSession {
  id               String    @id
  userId           String    @map("user_id")
  refreshTokenHash String    @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Widget {
  id                         String    @id @default(cuid())
  userId                     String    @map("user_id")
  publicKey                  String    @unique @map("public_key")
  name                       String    @default("Виджет")
  isActive                   Boolean   @default(true) @map("is_active")
  installDomain              String    @default("") @map("install_domain")
  config                     Json      @default("{}")
  draftConfig                Json?     @map("draft_config")
  draftInstallDomain         String?   @map("draft_install_domain")
  draftRevision              Int       @default(0) @map("draft_revision")
  publishedVersion           Int       @default(0) @map("published_version")
  publishedFromDraftRevision Int       @default(0) @map("published_from_draft_revision")
  publishedAt                DateTime? @map("published_at")
  leads                      Lead[]
  user                       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("widgets")
}

model Callback {
  id                         String         @id @default(cuid())
  userId                     String         @map("user_id")
  publicKey                  String         @unique @map("public_key")
  name                       String         @default("Обратный звонок")
  isActive                   Boolean        @default(true) @map("is_active")
  installDomain              String         @default("") @map("install_domain")
  config                     Json           @default("{}")
  draftConfig                Json?          @map("draft_config")
  draftInstallDomain         String?        @map("draft_install_domain")
  draftRevision              Int            @default(0) @map("draft_revision")
  publishedVersion           Int            @default(0) @map("published_version")
  publishedFromDraftRevision Int            @default(0) @map("published_from_draft_revision")
  publishedAt                DateTime?      @map("published_at")
  leads                      CallbackLead[]
  user                       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                  DateTime       @default(now()) @map("created_at")
  updatedAt                  DateTime       @updatedAt @map("updated_at")

  @@index([userId])
  @@map("callbacks")
}

model CallbackLead {
  id         String   @id @default(cuid())
  callbackId String   @map("callback_id")
  phone      String
  timeSlot   String   @default("") @map("time_slot")
  timezone   String   @default("") @map("timezone")
  url        String?
  ip         String?
  callback   Callback @relation(fields: [callbackId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([callbackId])
  @@index([callbackId, ip])
  @@map("callback_leads")
}

model CountdownTimer {
  id                         String               @id @default(cuid())
  userId                     String               @map("user_id")
  publicKey                  String               @unique @map("public_key")
  name                       String               @default("Таймер")
  isActive                   Boolean              @default(true) @map("is_active")
  installDomain              String               @default("") @map("install_domain")
  config                     Json                 @default("{}")
  draftConfig                Json?                @map("draft_config")
  draftInstallDomain         String?              @map("draft_install_domain")
  draftRevision              Int                  @default(0) @map("draft_revision")
  publishedVersion           Int                  @default(0) @map("published_version")
  publishedFromDraftRevision Int                  @default(0) @map("published_from_draft_revision")
  publishedAt                DateTime?            @map("published_at")
  leads                      CountdownTimerLead[]
  user                       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                  DateTime             @default(now()) @map("created_at")
  updatedAt                  DateTime             @updatedAt @map("updated_at")

  @@index([userId])
  @@map("countdown_timers")
}

model CountdownTimerLead {
  id               String         @id @default(cuid())
  countdownTimerId String         @map("countdown_timer_id")
  phone            String?
  email            String?
  url              String?
  ip               String?
  timerResetToken  String         @default("") @map("timer_reset_token")
  countdownTimer   CountdownTimer @relation(fields: [countdownTimerId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([countdownTimerId])
  @@index([countdownTimerId, ip])
  @@index([countdownTimerId, timerResetToken])
  @@index([countdownTimerId, timerResetToken, ip])
  @@map("countdown_timer_leads")
}

model StopOffer {
  id                         String          @id @default(cuid())
  userId                     String          @map("user_id")
  publicKey                  String          @unique @map("public_key")
  name                       String          @default("Стоп-оффер")
  isActive                   Boolean         @default(true) @map("is_active")
  installDomain              String          @default("") @map("install_domain")
  config                     Json            @default("{}")
  draftConfig                Json?           @map("draft_config")
  draftInstallDomain         String?         @map("draft_install_domain")
  draftRevision              Int             @default(0) @map("draft_revision")
  publishedVersion           Int             @default(0) @map("published_version")
  publishedFromDraftRevision Int             @default(0) @map("published_from_draft_revision")
  publishedAt                DateTime?       @map("published_at")
  leads                      StopOfferLead[]
  user                       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                  DateTime        @default(now()) @map("created_at")
  updatedAt                  DateTime        @updatedAt @map("updated_at")

  @@index([userId])
  @@map("stop_offers")
}

model StopOfferLead {
  id          String    @id @default(cuid())
  stopOfferId String    @map("stop_offer_id")
  phone       String?
  email       String?
  url         String?
  ip          String?
  resetToken  String    @default("") @map("reset_token")
  stopOffer   StopOffer @relation(fields: [stopOfferId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([stopOfferId])
  @@index([stopOfferId, ip])
  @@index([stopOfferId, resetToken])
  @@index([stopOfferId, resetToken, ip])
  @@map("stop_offer_leads")
}

model OnlineConsultant {
  id                         String                 @id @default(cuid())
  userId                     String                 @map("user_id")
  publicKey                  String                 @unique @map("public_key")
  name                       String                 @default("Онлайн-консультант")
  isActive                   Boolean                @default(true) @map("is_active")
  installDomain              String                 @default("") @map("install_domain")
  config                     Json                   @default("{}")
  draftConfig                Json?                  @map("draft_config")
  draftInstallDomain         String?                @map("draft_install_domain")
  draftRevision              Int                    @default(0) @map("draft_revision")
  publishedVersion           Int                    @default(0) @map("published_version")
  publishedFromDraftRevision Int                    @default(0) @map("published_from_draft_revision")
  publishedAt                DateTime?              @map("published_at")
  leads                      OnlineConsultantLead[]
  user                       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                  DateTime               @default(now()) @map("created_at")
  updatedAt                  DateTime               @updatedAt @map("updated_at")

  @@index([userId])
  @@map("online_consultants")
}

model OnlineConsultantLead {
  id                 String           @id @default(cuid())
  onlineConsultantId String           @map("online_consultant_id")
  phone              String?
  email              String?
  actionLabel        String           @default("") @map("action_label")
  actionValue        String           @default("") @map("action_value")
  url                String?
  ip                 String?
  onlineConsultant   OnlineConsultant @relation(fields: [onlineConsultantId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now()) @map("created_at")

  @@index([onlineConsultantId])
  @@index([onlineConsultantId, ip])
  @@map("online_consultant_leads")
}

model Calculator {
  id                         String           @id @default(cuid())
  userId                     String           @map("user_id")
  publicKey                  String           @unique @map("public_key")
  name                       String           @default("Калькулятор")
  isActive                   Boolean          @default(true) @map("is_active")
  installDomain              String           @default("") @map("install_domain")
  config                     Json             @default("{}")
  draftConfig                Json?            @map("draft_config")
  draftInstallDomain         String?          @map("draft_install_domain")
  draftRevision              Int              @default(0) @map("draft_revision")
  publishedVersion           Int              @default(0) @map("published_version")
  publishedFromDraftRevision Int              @default(0) @map("published_from_draft_revision")
  publishedAt                DateTime?        @map("published_at")
  leads                      CalculatorLead[]
  user                       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                  DateTime         @default(now()) @map("created_at")
  updatedAt                  DateTime         @updatedAt @map("updated_at")

  @@index([userId])
  @@map("calculators")
}

model CalculatorLead {
  id              String     @id @default(cuid())
  calculatorId    String     @map("calculator_id")
  contact         String
  phone           String?
  email           String?
  answers         Json       @default("[]")
  calculatedPrice Decimal    @map("calculated_price") @db.Decimal(14, 2)
  currency        String     @default("RUB")
  url             String?
  ip              String?
  calculator      Calculator @relation(fields: [calculatorId], references: [id], onDelete: Cascade)
  createdAt       DateTime   @default(now()) @map("created_at")

  @@index([calculatorId])
  @@index([calculatorId, ip])
  @@map("calculator_leads")
}

model Quiz {
  id                         String     @id @default(cuid())
  userId                     String     @map("user_id")
  publicKey                  String     @unique @map("public_key")
  name                       String     @default("Квиз")
  isActive                   Boolean    @default(true) @map("is_active")
  installDomain              String     @default("") @map("install_domain")
  config                     Json       @default("{}")
  draftConfig                Json?      @map("draft_config")
  draftInstallDomain         String?    @map("draft_install_domain")
  draftRevision              Int        @default(0) @map("draft_revision")
  publishedVersion           Int        @default(0) @map("published_version")
  publishedFromDraftRevision Int        @default(0) @map("published_from_draft_revision")
  publishedAt                DateTime?  @map("published_at")
  leads                      QuizLead[]
  user                       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                  DateTime   @default(now()) @map("created_at")
  updatedAt                  DateTime   @updatedAt @map("updated_at")

  @@index([userId])
  @@map("quizzes")
}

model QuizLead {
  id             String   @id @default(cuid())
  quizId         String   @map("quiz_id")
  contact        String
  phone          String?
  email          String?
  answers        Json     @default("[]")
  result         String?
  url            String?
  ip             String?
  quizResetToken String?  @map("quiz_reset_token")
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([quizId])
  @@index([quizId, ip])
  @@map("quiz_leads")
}

model Lead {
  id             String   @id @default(cuid())
  widgetId       String   @map("widget_id")
  contact        String
  phone          String?
  email          String?
  bonus          String?
  url            String?
  ip             String?
  spinResetToken String?  @map("spin_reset_token")
  widget         Widget   @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([widgetId])
  @@index([widgetId, ip])
  @@map("leads")
}

model WidgetConfigRevision {
  id            String   @id @default(cuid())
  widgetType    String   @map("widget_type")
  widgetId      String   @map("widget_id")
  version       Int
  config        Json
  installDomain String   @map("install_domain")
  sourceVersion Int?     @map("source_version")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([widgetType, widgetId, version])
  @@index([widgetType, widgetId, createdAt])
  @@map("widget_config_revisions")
}

model WidgetRuntimePresence {
  id               String   @id @default(cuid())
  widgetType       String   @map("widget_type")
  widgetId         String   @map("widget_id")
  installDomain    String   @map("install_domain")
  runtimeVersion   String   @map("runtime_version")
  publishedVersion Int      @map("published_version")
  firstSeenAt      DateTime @default(now()) @map("first_seen_at")
  lastSeenAt       DateTime @default(now()) @map("last_seen_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([widgetType, widgetId])
  @@index([lastSeenAt])
  @@map("widget_runtime_presence")
}

model WidgetRuntimeDailyMetric {
  id               String   @id @default(cuid())
  widgetType       String   @map("widget_type")
  widgetId         String   @map("widget_id")
  publishedVersion Int      @map("published_version")
  date             DateTime @db.Date
  impressions      Int      @default(0)
  opens            Int      @default(0)
  starts           Int      @default(0)
  completions      Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([widgetType, widgetId, publishedVersion, date], map: "widget_runtime_metric_unique")
  @@index([widgetType, widgetId, publishedVersion, date], map: "widget_runtime_metric_lookup_idx")
  @@map("widget_runtime_daily_metrics")
}

model WidgetRuntimeDailyStepMetric {
  id               String   @id @default(cuid())
  widgetType       String   @map("widget_type")
  widgetId         String   @map("widget_id")
  publishedVersion Int      @map("published_version")
  date             DateTime @db.Date
  stepKey          String   @map("step_key")
  count            Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([widgetType, widgetId, publishedVersion, date, stepKey], map: "widget_runtime_step_metric_unique")
  @@index([widgetType, widgetId, publishedVersion, date], map: "widget_runtime_step_metric_lookup_idx")
  @@map("widget_runtime_daily_step_metrics")
}

model Subscription {
  id              String                       @id @default(cuid())
  userId          String                       @unique @map("user_id")
  plan            Plan                         @default(TRIAL)
  billingPeriod   BillingPeriod?               @map("billing_period")
  status          SubscriptionStatus           @default(ACTIVE)
  startsAt        DateTime                     @default(now()) @map("starts_at")
  expiresAt       DateTime?                    @map("expires_at")
  leadsThisPeriod Int                          @default(0) @map("leads_this_period")
  periodResetsAt  DateTime?                    @map("period_resets_at")
  user            User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  histories       SubscriptionHistory[]
  expiryReminders SubscriptionExpiryReminder[]
  createdAt       DateTime                     @default(now()) @map("created_at")
  updatedAt       DateTime                     @updatedAt @map("updated_at")

  @@map("subscriptions")
}

model SubscriptionExpiryReminder {
  id               String                           @id @default(cuid())
  subscriptionId   String                           @map("subscription_id")
  userId           String                           @map("user_id")
  daysBeforeExpiry Int                              @map("days_before_expiry")
  expiresAt        DateTime                         @map("expires_at")
  sentTo           String                           @map("sent_to")
  status           SubscriptionExpiryReminderStatus @default(PENDING)
  lockedAt         DateTime?                        @map("locked_at")
  lockedBy         String?                          @map("locked_by")
  attempts         Int                              @default(0)
  availableAt      DateTime                         @default(now()) @map("available_at")
  lastError        String?                          @map("last_error") @db.Text
  subscription     Subscription                     @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user             User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentAt           DateTime?                        @map("sent_at")

  @@unique([subscriptionId, daysBeforeExpiry, expiresAt, sentTo], map: "subscription_expiry_reminder_unique")
  @@index([userId], map: "subscription_expiry_reminders_user_id_idx")
  @@index([daysBeforeExpiry, expiresAt], map: "subscription_expiry_reminders_days_expires_idx")
  @@index([sentAt], map: "subscription_expiry_reminders_sent_at_idx")
  @@index([status, availableAt], map: "subscription_expiry_reminders_status_available_idx")
  @@index([status, lockedAt], map: "subscription_expiry_reminders_status_locked_idx")
  @@map("subscription_expiry_reminders")
}

model TelegramNotificationChannel {
  id             String    @id @default(cuid())
  userId         String    @unique @map("user_id")
  chatId         String    @unique @map("chat_id")
  telegramUserId String?   @unique @map("telegram_user_id")
  username       String?
  firstName      String?   @map("first_name")
  lastName       String?   @map("last_name")
  isActive       Boolean   @default(true) @map("is_active")
  connectedAt    DateTime  @default(now()) @map("connected_at")
  disabledAt     DateTime? @map("disabled_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive], map: "telegram_notification_channels_is_active_idx")
  @@map("telegram_notification_channels")
}

model TelegramSupportMessage {
  id             String   @id @default(cuid())
  adminChatId    String   @map("admin_chat_id")
  adminMessageId Int      @map("admin_message_id")
  userChatId     String   @map("user_chat_id")
  telegramUserId String?  @map("telegram_user_id")
  username       String?
  firstName      String?  @map("first_name")
  lastName       String?  @map("last_name")
  text           String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([adminChatId, adminMessageId], map: "telegram_support_messages_admin_message_unique")
  @@index([userChatId], map: "telegram_support_messages_user_chat_id_idx")
  @@index([createdAt], map: "telegram_support_messages_created_at_idx")
  @@map("telegram_support_messages")
}

model SubscriptionHistory {
  id                 String                     @id @default(cuid())
  subscriptionId     String?                    @map("subscription_id")
  userId             String?                    @map("user_id")
  adminId            String?                    @map("admin_id")
  action             SubscriptionHistoryAction
  days               Int?
  oldExpiresAt       DateTime?                  @map("old_expires_at")
  newExpiresAt       DateTime?                  @map("new_expires_at")
  targetAudience     SubscriptionBonusAudience? @map("target_audience")
  targetLabel        String?                    @map("target_label")
  affectedUsersCount Int?                       @map("affected_users_count")
  subscription       Subscription?              @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user               User?                      @relation("SubscriptionHistoryUser", fields: [userId], references: [id], onDelete: Cascade)
  admin              User?                      @relation("SubscriptionHistoryAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  createdAt          DateTime                   @default(now()) @map("created_at")

  @@index([subscriptionId])
  @@index([userId])
  @@index([adminId])
  @@index([createdAt])
  @@map("subscription_history")
}

model AdminEventLog {
  id              String   @id @default(cuid())
  adminId         String?  @map("admin_id")
  adminName       String?  @map("admin_name")
  adminEmail      String?  @map("admin_email")
  section         String
  action          String
  description     String
  entityType      String?  @map("entity_type")
  entityId        String?  @map("entity_id")
  entityLabel     String?  @map("entity_label")
  targetUserId    String?  @map("target_user_id")
  targetUserName  String?  @map("target_user_name")
  targetUserEmail String?  @map("target_user_email")
  metadata        Json     @default("{}")
  ip              String?
  userAgent       String?  @map("user_agent")
  admin           User?    @relation("AdminEventLogAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  targetUser      User?    @relation("AdminEventLogTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@index([targetUserId])
  @@index([section])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("admin_event_logs")
}

model Payment {
  id                      String             @id @default(cuid())
  userId                  String             @map("user_id")
  yookassaId              String?            @unique @map("yookassa_id")
  providerIdempotencyKey  String?            @unique @map("provider_idempotency_key")
  recurringCycleKey       String?            @unique @map("recurring_cycle_key")
  recurringAttempt        Int                @default(0) @map("recurring_attempt")
  kind                    PaymentKind        @default(ONE_TIME)
  amount                  String
  currency                String             @default("RUB")
  confirmationUrl         String?            @map("confirmation_url")
  status                  PaymentStatus      @default(PENDING)
  providerStatus          String?            @map("provider_status")
  plan                    Plan?
  billingPeriod           BillingPeriod?     @map("billing_period")
  autoRenew               Boolean            @default(false) @map("auto_renew")
  consentVersion          String?            @map("consent_version")
  consentText             String?            @map("consent_text") @db.Text
  consentedAt             DateTime?          @map("consented_at")
  consentIp               String?            @map("consent_ip")
  consentUserAgent        String?            @map("consent_user_agent")
  offerSnapshot           String?            @map("offer_snapshot") @db.Text
  offerSha256             String?            @map("offer_sha256")
  offerUpdatedAt          DateTime?          @map("offer_updated_at")
  customerEmail           String?            @map("customer_email")
  customerPhone           String?            @map("customer_phone")
  paymentMethodCiphertext String?            @map("payment_method_ciphertext") @db.Text
  providerCreatedAt       DateTime?          @map("provider_created_at")
  checkoutExpiresAt       DateTime           @map("checkout_expires_at")
  providerExpiresAt       DateTime?          @map("provider_expires_at")
  lastProviderCheckedAt   DateTime?          @map("last_provider_checked_at")
  succeededAt             DateTime?          @map("succeeded_at")
  cancelledAt             DateTime?          @map("cancelled_at")
  cancellationReason      String?            @map("cancellation_reason")
  receiptSyncEligible     Boolean            @default(true) @map("receipt_sync_eligible")
  affiliateReferral       AffiliateReferral?
  receipts                PaymentReceipt[]
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")
