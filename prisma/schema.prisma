model SiteSettings {
  id                       String   @id @default("singleton")
  bannerEnabled            Boolean  @default(false) @map("banner_enabled")
  bannerText               String   @default("") @map("banner_text")
  snowflakeEnabled         Boolean  @default(false) @map("snowflake_enabled")
  paymentEnabled           Boolean  @default(true) @map("payment_enabled")
  recaptchaEnabled         Boolean  @default(true) @map("recaptcha_enabled")
  googleAuthEnabled        Boolean  @default(true) @map("google_auth_enabled")
  yandexAuthEnabled        Boolean  @default(true) @map("yandex_auth_enabled")
  githubAuthEnabled        Boolean  @default(true) @map("github_auth_enabled")
  vkAuthEnabled            Boolean  @default(false) @map("vk_auth_enabled")
  telegramAuthEnabled      Boolean  @default(true) @map("telegram_auth_enabled")
  affiliateProgramEnabled  Boolean  @default(false) @map("affiliate_program_enabled")
  affiliateCashbackPercent Int      @default(10) @map("affiliate_cashback_percent")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model AffiliateReferral {
  id              String                  @id @default(cuid())
  referrerId      String                  @map("referrer_id")
  referredUserId  String                  @unique @map("referred_user_id")
  firstPaymentId  String?                 @unique @map("first_payment_id")
  status          AffiliateReferralStatus @default(REGISTERED)
  paymentAmount   Int?                    @map("payment_amount")
  cashbackPercent Int?                    @map("cashback_percent")
  cashbackAmount  Int?                    @map("cashback_amount")
  availableAt     DateTime?               @map("available_at")
  cancelledAt     DateTime?               @map("cancelled_at")
  paidAt          DateTime?               @map("paid_at")
  referrer        User                    @relation("AffiliateReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser    User                    @relation("AffiliateReferralReferred", fields: [referredUserId], references: [id], onDelete: Cascade)
  firstPayment    Payment?                @relation(fields: [firstPaymentId], references: [id], onDelete: SetNull)
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  @@index([referrerId])
  @@index([status])
  @@index([availableAt])
  @@map("affiliate_referrals")
}

model TelegramBotSettings {
  id                                String    @id @default("singleton")
  dailySummaryEnabled               Boolean   @default(false) @map("daily_summary_enabled")
  dailySummaryChatId                String    @default("") @map("daily_summary_chat_id")
  supportThreadId                   Int?      @map("support_thread_id")
  databaseBackupThreadId            Int?      @map("database_backup_thread_id")
  paymentsThreadId                  Int?      @map("payments_thread_id")
  reportsThreadId                   Int?      @map("reports_thread_id")
  dailySummaryTime                  String    @default("01:50") @map("daily_summary_time")
  dailySummaryLastSentPeriodStart   DateTime? @map("daily_summary_last_sent_period_start")
  dailySummaryLastSentAt            DateTime? @map("daily_summary_last_sent_at")
  databaseBackupEnabled             Boolean   @default(true) @map("database_backup_enabled")
  databaseBackupTime                String    @default("01:45") @map("database_backup_time")
  databaseBackupLastSentPeriodStart DateTime? @map("database_backup_last_sent_period_start")
  databaseBackupLastSentAt          DateTime? @map("database_backup_last_sent_at")
  updatedAt                         DateTime  @updatedAt @map("updated_at")

  @@map("telegram_bot_settings")
}

