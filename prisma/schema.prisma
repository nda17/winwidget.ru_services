generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(cuid())
  name               String?
  password           String
  avatarPath         String?
  hashedRefreshToken String?  @map("hashed_refresh_token")
  rights             Role[]   @default([USER])
  authIdentities     AuthIdentity[]
  verificationChallenges VerificationChallenge[]
  payments           Payment[]
  widgets            Widget[]
  subscription       Subscription?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
}

model Widget {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  publicKey String   @unique @map("public_key")
  name      String   @default("Виджет")
  isActive  Boolean  @default(true) @map("is_active")
  config    Json     @default("{}")
  leads     Lead[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("widgets")
}

model Lead {
  id             String   @id @default(cuid())
  widgetId       String   @map("widget_id")
  contact        String
  phone          String?
  email          String?
  bonus          String?
  url            String?
  ip             String?
  spinResetToken String?  @map("spin_reset_token")
  widget         Widget   @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([widgetId])
  @@index([widgetId, ip])
  @@map("leads")
}

model Subscription {
  id              String             @id @default(cuid())
  userId          String             @unique @map("user_id")
  plan            Plan               @default(TRIAL)
  billingPeriod   BillingPeriod?     @map("billing_period")
  status          SubscriptionStatus @default(ACTIVE)
  startsAt        DateTime           @default(now()) @map("starts_at")
  expiresAt       DateTime?          @map("expires_at")
  leadsThisPeriod Int                @default(0) @map("leads_this_period")
  periodResetsAt  DateTime?          @map("period_resets_at")
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@map("subscriptions")
}

model Payment {
  id            String         @id @default(cuid())
  userId        String         @map("user_id")
  yookassaId    String         @unique @map("yookassa_id")
  amount        String
  status        PaymentStatus  @default(PENDING)
  plan          Plan?
  billingPeriod BillingPeriod? @map("billing_period")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payments")
}

model AuthIdentity {
  id         String           @id @default(cuid())
  userId     String           @map("user_id")
  type       AuthIdentityType
  value      String
  verifiedAt DateTime?        @map("verified_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([type, value])
  @@unique([userId, type])
  @@index([userId])
  @@map("auth_identities")
}

model VerificationChallenge {
  id         String           @id @default(cuid())
  userId     String?          @map("user_id")
  type       VerificationChallengeType
  purpose    VerificationChallengePurpose
  value      String
  passwordHash String?        @map("password_hash")
  codeHash   String           @map("code_hash")
  attempts   Int              @default(0)
  expiresAt  DateTime         @map("expires_at")
  lastSentAt DateTime         @default(now()) @map("last_sent_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  user       User?            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, type, purpose])
  @@unique([type, purpose, value])
  @@index([expiresAt])
  @@map("verification_challenges")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  CANCELLED
}

enum Role {
  USER
  PREMIUM
  MANAGER
  ADMIN
}

enum AuthIdentityType {
  EMAIL
  PHONE
  GOOGLE
  GITHUB
  YANDEX
}

enum VerificationChallengeType {
  EMAIL
  PHONE
}

enum VerificationChallengePurpose {
  REGISTER
  BIND_IDENTITY
}

enum Plan {
  TRIAL
  EASY
  HARD
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model SiteSettings {
  id                String   @id @default("singleton")
  bannerEnabled     Boolean  @default(false) @map("banner_enabled")
  bannerText        String   @default("") @map("banner_text")
  snowflakeEnabled  Boolean  @default(false) @map("snowflake_enabled")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model LegalPage {
  slug      String   @id
  content   String   @default("")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("legal_pages")
}

model Note {
  id        String   @id @default(cuid())
  text      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notes")
}
