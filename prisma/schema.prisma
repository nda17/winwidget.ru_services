generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TelegramSupportMessage {
  id             String   @id @default(cuid())
  adminChatId    String   @map("admin_chat_id")
  adminMessageId Int      @map("admin_message_id")
  userChatId     String   @map("user_chat_id")
  telegramUserId String?  @map("telegram_user_id")
  username       String?
  firstName      String?  @map("first_name")
  lastName       String?  @map("last_name")
  text           String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([adminChatId, adminMessageId], map: "telegram_support_messages_admin_message_unique")
  @@index([userChatId], map: "telegram_support_messages_user_chat_id_idx")
  @@index([createdAt], map: "telegram_support_messages_created_at_idx")
  @@map("telegram_support_messages")
}

model AdminEventLog {
  id              String   @id @default(cuid())
  adminId         String?  @map("admin_id")
  adminName       String?  @map("admin_name")
  adminEmail      String?  @map("admin_email")
  section         String
  action          String
  description     String
  entityType      String?  @map("entity_type")
  entityId        String?  @map("entity_id")
  entityLabel     String?  @map("entity_label")
  targetUserId    String?  @map("target_user_id")
  targetUserName  String?  @map("target_user_name")
  targetUserEmail String?  @map("target_user_email")
  metadata        Json     @default("{}")
  ip              String?
  userAgent       String?  @map("user_agent")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@index([targetUserId])
  @@index([section])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("admin_event_logs")
}

model OutboxEvent {
  id               String            @id @default(uuid()) @db.Uuid
  messageId        String?           @map("message_id") @db.Uuid
  deduplicationKey String?           @unique(map: "outbox_events_deduplication_key_unique") @map("deduplication_key")
  eventType        String            @map("event_type")
  routingKey       String            @map("routing_key")
  payload          Json
  headers          Json              @default("{}")
  status           OutboxEventStatus @default(PENDING)
  attempts         Int               @default(0)
  availableAt      DateTime          @default(now()) @map("available_at")
  lockedAt         DateTime?         @map("locked_at")
  lockedBy         String?           @map("locked_by")
  publishedAt      DateTime?         @map("published_at")
  lastError        String?           @map("last_error") @db.Text
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@index([status, availableAt, createdAt], map: "outbox_events_dispatch_idx")
  @@index([lockedAt], map: "outbox_events_locked_at_idx")
  @@index([publishedAt], map: "outbox_events_published_at_idx")
  @@map("outbox_events")
}

model ReportingProducerState {
  id                                      String    @id
  enabled                                 Boolean   @default(false)
  activatedAt                             DateTime? @map("activated_at")
  dailySummaryOwner                       String    @default("CORE") @map("daily_summary_owner")
  dailySummarySwitchGeneration            BigInt    @default(0) @map("daily_summary_switch_generation")
  dailySummarySwitchedAt                  DateTime? @map("daily_summary_switched_at")
  // Fail-closed Core policy fence only. Reporting DB remains the sole source
  // read by the Reporting API and scheduler after ownership switches.
  dailySummaryPolicyReservationTime       String    @default("01:50") @map("daily_summary_schedule_time")
  dailySummaryPolicyReservationGeneration BigInt    @default(0) @map("daily_summary_schedule_generation")
  dailySummaryPolicyConfirmedChangeId     String?   @map("daily_summary_policy_confirmed_change_id") @db.Uuid
  dailySummaryPolicyPendingChangeId       String?   @map("daily_summary_policy_pending_change_id") @db.Uuid
  dailySummaryPolicyPendingTime           String?   @map("daily_summary_policy_pending_time")
  dailySummaryPolicyPendingGeneration     BigInt?   @map("daily_summary_policy_pending_generation")
  updatedAt                               DateTime  @updatedAt @map("updated_at")

  @@map("reporting_producer_state")
}

model BillingCoreState {
  id                        String               @id @default("singleton")
  ownership                 BillingCoreOwnership @default(CORE)
  sourceProducersEnabled    Boolean              @default(true) @map("source_producers_enabled")
  legacyRoutesEnabled       Boolean              @default(true) @map("legacy_routes_enabled")
  schedulerEnabled          Boolean              @default(true) @map("scheduler_enabled")
  legacyConsumerEnabled     Boolean              @default(true) @map("legacy_consumer_enabled")
  projectionConsumerEnabled Boolean              @default(true) @map("projection_consumer_enabled")
  generation                BigInt               @default(0)
  preparedRevision          String?              @map("prepared_revision")
  ownershipRevision         String?              @map("ownership_revision")
  activatedAt               DateTime?            @map("activated_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")

  @@map("billing_core_state")
}

model BillingSourceAggregateVersion {
  aggregateType  String   @map("aggregate_type")
  aggregateId    String   @map("aggregate_id")
  version        BigInt
  sourceSequence BigInt   @map("source_sequence")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@id([aggregateType, aggregateId])
  @@index([sourceSequence], map: "billing_source_aggregate_versions_source_sequence_idx")
  @@map("billing_source_aggregate_versions")
}

model BillingReadProjectionVersion {
  aggregateType  String   @map("aggregate_type")
  aggregateId    String   @map("aggregate_id")
  version        BigInt
  sourceSequence BigInt?  @map("source_sequence")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@id([aggregateType, aggregateId])
  @@index([sourceSequence], map: "billing_read_projection_versions_source_sequence_idx")
  @@map("billing_read_projection_versions")
}

model BillingSubscriptionReadProjection {
  id              String             @id
  userId          String             @unique @map("user_id")
  plan            Plan
  billingPeriod   BillingPeriod?     @map("billing_period")
  status          SubscriptionStatus
  startsAt        DateTime           @map("starts_at")
  expiresAt       DateTime?          @map("expires_at")
  leadsThisPeriod Int                @default(0) @map("leads_this_period")
  periodResetsAt  DateTime?          @map("period_resets_at")
  createdAt       DateTime           @map("created_at")
  updatedAt       DateTime           @map("updated_at")
  sourceVersion   BigInt             @map("source_version")
  sourceSequence  BigInt?            @map("source_sequence")
  projectedAt     DateTime           @default(now()) @map("projected_at")

  @@index([status, expiresAt], map: "billing_subscription_read_status_expires_idx")
  @@index([userId, status, expiresAt], map: "billing_subscription_read_user_status_idx")
  @@map("billing_subscription_read_projections")
}

model BillingPaymentReadProjection {
  id             String         @id
  userId         String         @map("user_id")
  yookassaId     String?        @map("yookassa_id")
  status         PaymentStatus
  amount         String
  plan           Plan?
  billingPeriod  BillingPeriod? @map("billing_period")
  createdAt      DateTime       @map("created_at")
  updatedAt      DateTime       @map("updated_at")
  sourceVersion  BigInt         @map("source_version")
  sourceSequence BigInt?        @map("source_sequence")
  projectedAt    DateTime       @default(now()) @map("projected_at")

  @@index([userId, createdAt], map: "billing_payment_read_user_created_idx")
  @@index([userId, status], map: "billing_payment_read_user_status_idx")
  @@index([status, createdAt], map: "billing_payment_read_status_created_idx")
  @@map("billing_payment_read_projections")
}

model BillingAffiliateReadProjection {
  id             String                  @id
  referrerId     String                  @map("referrer_id")
  referredUserId String                  @unique @map("referred_user_id")
  firstPaymentId String?                 @map("first_payment_id")
  status         AffiliateReferralStatus
  cashbackAmount Int?                    @map("cashback_amount")
  availableAt    DateTime?               @map("available_at")
  cancelledAt    DateTime?               @map("cancelled_at")
  updatedAt      DateTime                @map("updated_at")
  sourceVersion  BigInt                  @map("source_version")
  sourceSequence BigInt?                 @map("source_sequence")
  projectedAt    DateTime                @default(now()) @map("projected_at")

  @@index([referrerId, status], map: "billing_affiliate_read_referrer_status_idx")
  @@index([status, availableAt], map: "billing_affiliate_read_status_available_idx")
  @@index([firstPaymentId], map: "billing_affiliate_read_first_payment_idx")
  @@map("billing_affiliate_read_projections")
}

model BillingSettingsReadProjection {
  id                          String   @id @default("singleton")
  paymentEnabled              Boolean  @map("payment_enabled")
  autoRenewalSignupEnabled    Boolean  @map("auto_renewal_signup_enabled")
  autoRenewalChargesEnabled   Boolean  @map("auto_renewal_charges_enabled")
  autoRenewalChargesEnabledAt DateTime @map("auto_renewal_charges_enabled_at")
  affiliateProgramEnabled     Boolean  @map("affiliate_program_enabled")
  affiliateCashbackPercent    Int      @map("affiliate_cashback_percent")
  updatedAt                   DateTime @map("updated_at")
  sourceVersion               BigInt   @map("source_version")
  sourceSequence              BigInt?  @map("source_sequence")
  projectedAt                 DateTime @default(now()) @map("projected_at")

  @@map("billing_settings_read_projection")
}

model BillingSettingsComposition {
  id                     String                           @id @db.Uuid
  status                 BillingSettingsCompositionStatus @default(PENDING)
  corePatch              Json                             @map("core_patch")
  billingPatch           Json                             @map("billing_patch")
  actorId                String                           @map("actor_id")
  correlationId          String?                          @map("correlation_id")
  appliedBillingSettings Json?                            @map("applied_billing_settings")
  attempts               Int                              @default(0)
  lastError              String?                          @map("last_error") @db.Text
  createdAt              DateTime                         @default(now()) @map("created_at")
  updatedAt              DateTime                         @updatedAt @map("updated_at")
  completedAt            DateTime?                        @map("completed_at")

  @@index([status, updatedAt], map: "billing_settings_compositions_status_updated_idx")
  @@map("billing_settings_compositions")
}

model ReportingProjectionVersion {
  aggregateType  String   @map("aggregate_type")
  aggregateId    String   @map("aggregate_id")
  version        BigInt
  sourceSequence BigInt   @map("source_sequence")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@id([aggregateType, aggregateId])
  @@index([sourceSequence], map: "reporting_projection_versions_source_sequence_idx")
  @@map("reporting_projection_versions")
}

model ScheduledJobRun {
  id              String                       @id @default(uuid()) @db.Uuid
  jobType         String                       @map("job_type")
  scheduleKey     String                       @map("schedule_key")
  trigger         ScheduledJobRunTrigger       @default(SCHEDULED)
  status          ScheduledJobRunStatus        @default(QUEUED)
  scheduledFor    DateTime                     @map("scheduled_for")
  periodStart     DateTime?                    @map("period_start")
  periodEnd       DateTime?                    @map("period_end")
  input           Json                         @default("{}")
  checkpoint      Json                         @default("{}")
  result          Json?
  attempts        Int                          @default(0)
  maxAttempts     Int                          @default(4) @map("max_attempts")
  availableAt     DateTime                     @default(now()) @map("available_at")
  leaseOwner      String?                      @map("lease_owner")
  leaseToken      String?                      @map("lease_token") @db.Uuid
  leaseExpiresAt  DateTime?                    @map("lease_expires_at")
  startedAt       DateTime?                    @map("started_at")
  finishedAt      DateTime?                    @map("finished_at")
  lastError       String?                      @map("last_error") @db.Text
  createdAt       DateTime                     @default(now()) @map("created_at")
  updatedAt       DateTime                     @updatedAt @map("updated_at")
  idempotencyKeys ScheduledJobIdempotencyKey[]

  @@unique([jobType, scheduleKey], map: "scheduled_job_runs_type_schedule_key_unique")
  @@index([status, availableAt, createdAt], map: "scheduled_job_runs_dispatch_idx")
  @@index([status, leaseExpiresAt], map: "scheduled_job_runs_lease_idx")
  @@index([jobType, createdAt], map: "scheduled_job_runs_type_created_idx")
  @@map("scheduled_job_runs")
}

model ScheduledJobIdempotencyKey {
  adminId        String          @map("admin_id")
  jobType        String          @map("job_type")
  idempotencyKey String          @map("idempotency_key") @db.Uuid
  jobId          String          @map("job_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at")
  job            ScheduledJobRun @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@id([adminId, jobType, idempotencyKey], map: "scheduled_job_idempotency_keys_pkey")
  @@index([jobId], map: "scheduled_job_idempotency_keys_job_idx")
  @@map("scheduled_job_idempotency_keys")
}

model MessagingHeartbeat {
  id         String   @id @default(uuid()) @db.Uuid
  service    String
  instanceId String   @map("instance_id")
  metadata   Json     @default("{}")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([service, instanceId], map: "messaging_heartbeats_service_instance_unique")
  @@index([service, lastSeenAt], map: "messaging_heartbeats_service_seen_idx")
  @@index([lastSeenAt], map: "messaging_heartbeats_seen_idx")
  @@map("messaging_heartbeats")
}

model IntegrationDeliveryFailure {
  id                    String                        @id @default(uuid()) @db.Uuid
  eventId               String                        @map("event_id") @db.Uuid
  integration           String
  routingKey            String                        @map("routing_key")
  payload               Json
  attempts              Int
  lastError             String                        @map("last_error") @db.Text
  category              IntegrationErrorCategory?
  normalizedCode        String?                       @map("normalized_code")
  safeReason            String?                       @map("safe_reason") @db.Text
  httpStatus            Int?                          @map("http_status")
  providerCode          String?                       @map("provider_code")
  retryable             Boolean?
  classificationVersion Int?                          @map("classification_version")
  firstFailedAt         DateTime?                     @map("first_failed_at")
  failedAt              DateTime                      @default(now()) @map("failed_at")
  retryingAt            DateTime?                     @map("retrying_at")
  activeRetryToken      String?                       @map("active_retry_token") @db.Uuid
  resolvedAt            DateTime?                     @map("resolved_at")
  resolution            IntegrationFailureResolution?
  resolutionComment     String?                       @map("resolution_comment") @db.Text
  resolvedById          String?                       @map("resolved_by_id")
  createdAt             DateTime                      @default(now()) @map("created_at")
  updatedAt             DateTime                      @updatedAt @map("updated_at")

  @@unique([eventId, integration], map: "integration_delivery_failures_event_integration_unique")
  @@index([resolvedAt, failedAt], map: "integration_delivery_failures_status_idx")
  @@index([integration, resolvedAt], map: "integration_delivery_failures_integration_idx")
  @@index([category, resolvedAt, failedAt], map: "integration_delivery_failures_category_idx")
  @@index([resolvedById], map: "integration_delivery_failures_resolver_idx")
  @@map("integration_delivery_failures")
}

model IntegrationDeliveryReceipt {
  id               String                           @id @default(uuid()) @db.Uuid
  eventId          String                           @map("event_id") @db.Uuid
  integration      String
  status           IntegrationDeliveryReceiptStatus @default(DELIVERED)
  lockedAt         DateTime                         @default(now()) @map("locked_at")
  deliveredAt      DateTime?                        @default(now()) @map("delivered_at")
  retryAttempt     Int?                             @map("retry_attempt")
  retryAvailableAt DateTime?                        @map("retry_available_at")
  retryToken       String?                          @map("retry_token") @db.Uuid
  createdAt        DateTime                         @default(now()) @map("created_at")

  @@unique([eventId, integration], map: "integration_delivery_receipts_event_integration_unique")
  @@index([status, lockedAt], map: "integration_delivery_receipts_processing_idx")
  @@index([integration, deliveredAt], map: "integration_delivery_receipts_integration_delivered_idx")
  @@index([deliveredAt], map: "integration_delivery_receipts_delivered_idx")
  @@map("integration_delivery_receipts")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  CANCELLED
  EXPIRED
}

enum OutboxEventStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
}

enum BillingCoreOwnership {
  CORE
  BILLING
}

enum BillingSettingsCompositionStatus {
  PENDING
  BILLING_APPLIED
  COMPLETED
}

enum ScheduledJobRunStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  SKIPPED
}

enum ScheduledJobRunTrigger {
  SCHEDULED
  MANUAL
}

enum Plan {
  TRIAL
  EASY
  HARD
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum AffiliateReferralStatus {
  REGISTERED
  REWARD_PENDING
  CANCELLED
  PAID
}

enum IntegrationDeliveryReceiptStatus {
  PROCESSING
  RETRY_SCHEDULED
  DELIVERED
  DEAD_LETTERED
  CLOSED_NO_RETRY
}

enum IntegrationErrorCategory {
  TRANSIENT
  RATE_LIMIT
  PERMANENT
  AUTH_CONFIGURATION
}

enum IntegrationFailureResolution {
  DELIVERED
  CLOSED_NO_RETRY
}

model TelegramBotSettings {
  id                                String    @id @default("singleton")
  dailySummaryChatId                String    @default("") @map("daily_summary_chat_id")
  supportThreadId                   Int?      @map("support_thread_id")
  databaseBackupThreadId            Int?      @map("database_backup_thread_id")
  paymentsThreadId                  Int?      @map("payments_thread_id")
  operationalAlertsThreadId         Int?      @map("operational_alerts_thread_id")
  databaseBackupEnabled             Boolean   @default(true) @map("database_backup_enabled")
  databaseBackupTime                String    @default("01:45") @map("database_backup_time")
  databaseBackupLastSentPeriodStart DateTime? @map("database_backup_last_sent_period_start")
  databaseBackupLastSentAt          DateTime? @map("database_backup_last_sent_at")
  updatedAt                         DateTime  @updatedAt @map("updated_at")

  @@map("telegram_bot_settings")
}

model Note {
  id        String   @id @default(cuid())
  text      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notes")
}
