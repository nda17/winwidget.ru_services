generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                           String                       @id @default(cuid())
  name                         String?
  password                     String
  avatarPath                   String?
  hashedRefreshToken           String?                      @map("hashed_refresh_token")
  status                       UserStatus                   @default(ACTIVE)
  personalDataConsentRevokedAt DateTime?                    @map("personal_data_consent_revoked_at")
  rights                       Role[]                       @default([USER])
  authIdentities               AuthIdentity[]
  telegramNotificationChannel  TelegramNotificationChannel?
  verificationChallenges       VerificationChallenge[]
  payments                     Payment[]
  widgets                      Widget[]
  quizzes                      Quiz[]
  callbacks                    Callback[]
  countdownTimers              CountdownTimer[]
  stopOffers                   StopOffer[]
  onlineConsultants            OnlineConsultant[]
  subscription                 Subscription?
  subscriptionHistories        SubscriptionHistory[]        @relation("SubscriptionHistoryUser")
  subscriptionHistoryActions   SubscriptionHistory[]        @relation("SubscriptionHistoryAdmin")
  subscriptionExpiryReminders  SubscriptionExpiryReminder[]
  affiliateReferralsMade       AffiliateReferral[]          @relation("AffiliateReferralReferrer")
  affiliateReferral            AffiliateReferral?           @relation("AffiliateReferralReferred")
  adminEventLogActions         AdminEventLog[]              @relation("AdminEventLogAdmin")
  adminEventLogTargets         AdminEventLog[]              @relation("AdminEventLogTargetUser")
  createdAt                    DateTime                     @default(now()) @map("created_at")
  updatedAt                    DateTime                     @updatedAt @map("updated_at")

  @@index([status])
}

model Widget {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  publicKey     String   @unique @map("public_key")
  name          String   @default("Виджет")
  isActive      Boolean  @default(true) @map("is_active")
  installDomain String   @default("") @map("install_domain")
  config        Json     @default("{}")
  leads         Lead[]
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("widgets")
}

model Callback {
  id            String         @id @default(cuid())
  userId        String         @map("user_id")
  publicKey     String         @unique @map("public_key")
  name          String         @default("Обратный звонок")
  isActive      Boolean        @default(true) @map("is_active")
  installDomain String         @default("") @map("install_domain")
  config        Json           @default("{}")
  leads         CallbackLead[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([userId])
  @@map("callbacks")
}

model CallbackLead {
  id         String   @id @default(cuid())
  callbackId String   @map("callback_id")
  phone      String
  timeSlot   String   @default("") @map("time_slot")
  timezone   String   @default("") @map("timezone")
  url        String?
  ip         String?
  callback   Callback @relation(fields: [callbackId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([callbackId])
  @@index([callbackId, ip])
  @@map("callback_leads")
}

model CountdownTimer {
  id            String               @id @default(cuid())
  userId        String               @map("user_id")
  publicKey     String               @unique @map("public_key")
  name          String               @default("Таймер")
  isActive      Boolean              @default(true) @map("is_active")
  installDomain String               @default("") @map("install_domain")
  config        Json                 @default("{}")
  leads         CountdownTimerLead[]
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  @@index([userId])
  @@map("countdown_timers")
}

model CountdownTimerLead {
  id               String         @id @default(cuid())
  countdownTimerId String         @map("countdown_timer_id")
  phone            String?
  email            String?
  url              String?
  ip               String?
  timerResetToken  String         @default("") @map("timer_reset_token")
  countdownTimer   CountdownTimer @relation(fields: [countdownTimerId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([countdownTimerId])
  @@index([countdownTimerId, ip])
  @@index([countdownTimerId, timerResetToken])
  @@index([countdownTimerId, timerResetToken, ip])
  @@map("countdown_timer_leads")
}

model StopOffer {
  id            String          @id @default(cuid())
  userId        String          @map("user_id")
  publicKey     String          @unique @map("public_key")
  name          String          @default("Стоп-оффер")
  isActive      Boolean         @default(true) @map("is_active")
  installDomain String          @default("") @map("install_domain")
  config        Json            @default("{}")
  leads         StopOfferLead[]
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([userId])
  @@map("stop_offers")
}

model StopOfferLead {
  id          String    @id @default(cuid())
  stopOfferId String    @map("stop_offer_id")
  phone       String?
  email       String?
  url         String?
  ip          String?
  resetToken  String    @default("") @map("reset_token")
  stopOffer   StopOffer @relation(fields: [stopOfferId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([stopOfferId])
  @@index([stopOfferId, ip])
  @@index([stopOfferId, resetToken])
  @@index([stopOfferId, resetToken, ip])
  @@map("stop_offer_leads")
}

model OnlineConsultant {
  id            String                 @id @default(cuid())
  userId        String                 @map("user_id")
  publicKey     String                 @unique @map("public_key")
  name          String                 @default("Онлайн-консультант")
  isActive      Boolean                @default(true) @map("is_active")
  installDomain String                 @default("") @map("install_domain")
  config        Json                   @default("{}")
  leads         OnlineConsultantLead[]
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  @@index([userId])
  @@map("online_consultants")
}

model OnlineConsultantLead {
  id                 String           @id @default(cuid())
  onlineConsultantId String           @map("online_consultant_id")
  phone              String?
  email              String?
  actionLabel        String           @default("") @map("action_label")
  actionValue        String           @default("") @map("action_value")
  url                String?
  ip                 String?
  onlineConsultant   OnlineConsultant @relation(fields: [onlineConsultantId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now()) @map("created_at")

  @@index([onlineConsultantId])
  @@index([onlineConsultantId, ip])
  @@map("online_consultant_leads")
}

model Quiz {
  id            String     @id @default(cuid())
  userId        String     @map("user_id")
  publicKey     String     @unique @map("public_key")
  name          String     @default("Квиз")
  isActive      Boolean    @default(true) @map("is_active")
  installDomain String     @default("") @map("install_domain")
  config        Json       @default("{}")
  leads         QuizLead[]
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@index([userId])
  @@map("quizzes")
}

model QuizLead {
  id             String   @id @default(cuid())
  quizId         String   @map("quiz_id")
  contact        String
  phone          String?
  email          String?
  answers        Json     @default("[]")
  result         String?
  url            String?
  ip             String?
  quizResetToken String?  @map("quiz_reset_token")
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([quizId])
  @@index([quizId, ip])
  @@map("quiz_leads")
}

model Lead {
  id             String   @id @default(cuid())
  widgetId       String   @map("widget_id")
  contact        String
  phone          String?
  email          String?
  bonus          String?
  url            String?
  ip             String?
  spinResetToken String?  @map("spin_reset_token")
  widget         Widget   @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([widgetId])
  @@index([widgetId, ip])
  @@map("leads")
}

model Subscription {
  id              String                       @id @default(cuid())
  userId          String                       @unique @map("user_id")
  plan            Plan                         @default(TRIAL)
  billingPeriod   BillingPeriod?               @map("billing_period")
  status          SubscriptionStatus           @default(ACTIVE)
  startsAt        DateTime                     @default(now()) @map("starts_at")
  expiresAt       DateTime?                    @map("expires_at")
  leadsThisPeriod Int                          @default(0) @map("leads_this_period")
  periodResetsAt  DateTime?                    @map("period_resets_at")
  user            User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  histories       SubscriptionHistory[]
  expiryReminders SubscriptionExpiryReminder[]
  createdAt       DateTime                     @default(now()) @map("created_at")
  updatedAt       DateTime                     @updatedAt @map("updated_at")

  @@map("subscriptions")
}

model SubscriptionExpiryReminder {
  id               String       @id @default(cuid())
  subscriptionId   String       @map("subscription_id")
  userId           String       @map("user_id")
  daysBeforeExpiry Int          @map("days_before_expiry")
  expiresAt        DateTime     @map("expires_at")
  sentTo           String       @map("sent_to")
  subscription     Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentAt           DateTime     @default(now()) @map("sent_at")

  @@unique([subscriptionId, daysBeforeExpiry, expiresAt, sentTo], map: "subscription_expiry_reminder_unique")
  @@index([userId], map: "subscription_expiry_reminders_user_id_idx")
  @@index([daysBeforeExpiry, expiresAt], map: "subscription_expiry_reminders_days_expires_idx")
  @@index([sentAt], map: "subscription_expiry_reminders_sent_at_idx")
  @@map("subscription_expiry_reminders")
}

model TelegramNotificationChannel {
  id             String    @id @default(cuid())
  userId         String    @unique @map("user_id")
  chatId         String    @unique @map("chat_id")
  telegramUserId String?   @unique @map("telegram_user_id")
  username       String?
  firstName      String?   @map("first_name")
  lastName       String?   @map("last_name")
  isActive       Boolean   @default(true) @map("is_active")
  connectedAt    DateTime  @default(now()) @map("connected_at")
  disabledAt     DateTime? @map("disabled_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive], map: "telegram_notification_channels_is_active_idx")
  @@map("telegram_notification_channels")
}

model TelegramSupportMessage {
  id             String   @id @default(cuid())
  adminChatId    String   @map("admin_chat_id")
  adminMessageId Int      @map("admin_message_id")
  userChatId     String   @map("user_chat_id")
  telegramUserId String?  @map("telegram_user_id")
  username       String?
  firstName      String?  @map("first_name")
  lastName       String?  @map("last_name")
  text           String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([adminChatId, adminMessageId], map: "telegram_support_messages_admin_message_unique")
  @@index([userChatId], map: "telegram_support_messages_user_chat_id_idx")
  @@index([createdAt], map: "telegram_support_messages_created_at_idx")
  @@map("telegram_support_messages")
}

model SubscriptionHistory {
  id                 String                     @id @default(cuid())
  subscriptionId     String?                    @map("subscription_id")
  userId             String?                    @map("user_id")
  adminId            String?                    @map("admin_id")
  action             SubscriptionHistoryAction
  days               Int?
  oldExpiresAt       DateTime?                  @map("old_expires_at")
  newExpiresAt       DateTime?                  @map("new_expires_at")
  targetAudience     SubscriptionBonusAudience? @map("target_audience")
  targetLabel        String?                    @map("target_label")
  affectedUsersCount Int?                       @map("affected_users_count")
  subscription       Subscription?              @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user               User?                      @relation("SubscriptionHistoryUser", fields: [userId], references: [id], onDelete: Cascade)
  admin              User?                      @relation("SubscriptionHistoryAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  createdAt          DateTime                   @default(now()) @map("created_at")

  @@index([subscriptionId])
  @@index([userId])
  @@index([adminId])
  @@index([createdAt])
  @@map("subscription_history")
}

model AdminEventLog {
  id              String   @id @default(cuid())
  adminId         String?  @map("admin_id")
  adminName       String?  @map("admin_name")
  adminEmail      String?  @map("admin_email")
  section         String
  action          String
  description     String
  entityType      String?  @map("entity_type")
  entityId        String?  @map("entity_id")
  entityLabel     String?  @map("entity_label")
  targetUserId    String?  @map("target_user_id")
  targetUserName  String?  @map("target_user_name")
  targetUserEmail String?  @map("target_user_email")
  metadata        Json     @default("{}")
  ip              String?
  userAgent       String?  @map("user_agent")
  admin           User?    @relation("AdminEventLogAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  targetUser      User?    @relation("AdminEventLogTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@index([targetUserId])
  @@index([section])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("admin_event_logs")
}

model Payment {
  id              String         @id @default(cuid())
  userId          String         @map("user_id")
  yookassaId      String         @unique @map("yookassa_id")
  amount          String
  confirmationUrl String?        @map("confirmation_url")
  status          PaymentStatus  @default(PENDING)
  plan            Plan?
  billingPeriod   BillingPeriod? @map("billing_period")
  affiliateReferral AffiliateReferral?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payments")
}

model TariffPrice {
  id            String        @id @default(cuid())
  plan          Plan
  billingPeriod BillingPeriod @map("billing_period")
  amount        Int
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@unique([plan, billingPeriod])
  @@map("tariff_prices")
}

model AuthIdentity {
  id         String           @id @default(cuid())
  userId     String           @map("user_id")
  type       AuthIdentityType
  value      String
  verifiedAt DateTime?        @map("verified_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([type, value])
  @@unique([userId, type])
  @@index([userId])
  @@map("auth_identities")
}

model VerificationChallenge {
  id                String                       @id @default(cuid())
  userId            String?                      @map("user_id")
  type              VerificationChallengeType
  purpose           VerificationChallengePurpose
  value             String
  passwordHash      String?                      @map("password_hash")
  codeHash          String                       @map("code_hash")
  attempts          Int                          @default(0)
  telegramUserId    String?                      @map("telegram_user_id")
  telegramChatId    String?                      @map("telegram_chat_id")
  telegramUsername  String?                      @map("telegram_username")
  telegramFirstName String?                      @map("telegram_first_name")
  telegramLastName  String?                      @map("telegram_last_name")
  expiresAt         DateTime                     @map("expires_at")
  lastSentAt        DateTime                     @default(now()) @map("last_sent_at")
  createdAt         DateTime                     @default(now()) @map("created_at")
  updatedAt         DateTime                     @updatedAt @map("updated_at")
  user              User?                        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, type, purpose])
  @@unique([type, purpose, value])
  @@index([telegramUserId])
  @@index([expiresAt])
  @@map("verification_challenges")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  CANCELLED
}

enum Role {
  USER
  ADMIN
  DEV
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

enum AuthIdentityType {
  EMAIL
  PHONE
  GOOGLE
  GITHUB
  YANDEX
  TELEGRAM
}

enum VerificationChallengeType {
  EMAIL
  PHONE
  TELEGRAM
}

enum VerificationChallengePurpose {
  REGISTER
  BIND_IDENTITY
  BIND_TELEGRAM_NOTIFICATIONS
  LOGIN
}

enum Plan {
  TRIAL
  EASY
  HARD
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum SubscriptionHistoryAction {
  BONUS_DAYS
}

enum SubscriptionBonusAudience {
  SINGLE
  ACTIVE_SUBSCRIPTION
  INACTIVE_SUBSCRIPTION
  ALL
}

enum AffiliateReferralStatus {
  REGISTERED
  REWARD_PENDING
  CANCELLED
  PAID
}

model SiteSettings {
  id                  String   @id @default("singleton")
  bannerEnabled       Boolean  @default(false) @map("banner_enabled")
  bannerText          String   @default("") @map("banner_text")
  snowflakeEnabled    Boolean  @default(false) @map("snowflake_enabled")
  paymentEnabled      Boolean  @default(true) @map("payment_enabled")
  recaptchaEnabled    Boolean  @default(true) @map("recaptcha_enabled")
  googleAuthEnabled   Boolean  @default(true) @map("google_auth_enabled")
  yandexAuthEnabled   Boolean  @default(true) @map("yandex_auth_enabled")
  githubAuthEnabled   Boolean  @default(true) @map("github_auth_enabled")
  telegramAuthEnabled Boolean  @default(true) @map("telegram_auth_enabled")
  affiliateProgramEnabled Boolean @default(false) @map("affiliate_program_enabled")
  affiliateCashbackPercent Int @default(10) @map("affiliate_cashback_percent")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model AffiliateReferral {
  id              String                  @id @default(cuid())
  referrerId      String                  @map("referrer_id")
  referredUserId  String                  @unique @map("referred_user_id")
  firstPaymentId  String?                 @unique @map("first_payment_id")
  status          AffiliateReferralStatus @default(REGISTERED)
  paymentAmount   Int?                    @map("payment_amount")
  cashbackPercent Int?                    @map("cashback_percent")
  cashbackAmount  Int?                    @map("cashback_amount")
  availableAt     DateTime?               @map("available_at")
  cancelledAt     DateTime?               @map("cancelled_at")
  paidAt          DateTime?               @map("paid_at")
  referrer        User                    @relation("AffiliateReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser    User                    @relation("AffiliateReferralReferred", fields: [referredUserId], references: [id], onDelete: Cascade)
  firstPayment    Payment?                @relation(fields: [firstPaymentId], references: [id], onDelete: SetNull)
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  @@index([referrerId])
  @@index([status])
  @@index([availableAt])
  @@map("affiliate_referrals")
}

model TelegramBotSettings {
  id                              String    @id @default("singleton")
  dailySummaryEnabled             Boolean   @default(false) @map("daily_summary_enabled")
  dailySummaryChatId              String    @default("") @map("daily_summary_chat_id")
  dailySummaryTime                String    @default("01:50") @map("daily_summary_time")
  dailySummaryLastSentPeriodStart DateTime? @map("daily_summary_last_sent_period_start")
  dailySummaryLastSentAt          DateTime? @map("daily_summary_last_sent_at")
  databaseBackupEnabled           Boolean   @default(true) @map("database_backup_enabled")
  databaseBackupTime              String    @default("01:45") @map("database_backup_time")
  databaseBackupLastSentPeriodStart DateTime? @map("database_backup_last_sent_period_start")
  databaseBackupLastSentAt          DateTime? @map("database_backup_last_sent_at")
  updatedAt                       DateTime  @updatedAt @map("updated_at")

  @@map("telegram_bot_settings")
}

model LegalPage {
  slug      String   @id
  content   String   @default("")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("legal_pages")
}

model HomePageContent {
  id        String   @id @default("singleton")
  content   Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("home_page_content")
}

model Note {
  id        String   @id @default(cuid())
  text      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notes")
}
